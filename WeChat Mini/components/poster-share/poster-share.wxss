/* ============================================================
   海报分享组件 — 轻奢极简风格
   ============================================================ */

.poster-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(0, 0, 0, 0.82);
  z-index: 10000;
  display: flex;
  justify-content: center;
  align-items: center;
  padding-top: 60px;
  box-sizing: border-box;
  animation: fadeIn 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

.poster-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  padding: 0 28px;
  box-sizing: border-box;
  position: relative;
}

/* ---- 海报画布容器（外层圆角） ---- */
.canvas-box {
  width: 100%;
  border-radius: 16px;
  overflow: hidden;
  box-shadow:
    0 14px 40px rgba(0, 0, 0, 0.25),
    0 2px 8px rgba(0, 0, 0, 0.12);
  background: transparent;
  margin-bottom: 28px;
  flex-shrink: 0;
  position: relative;
}

.poster-canvas {
  display: block;
  width: 100%;
  height: 100%;
}

/* ---- 加载动画 ---- */
.loading-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(255, 255, 255, 0.92);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  z-index: 10;
  border-radius: 16px;
  gap: 16px;
}

.loading-spinner {
  width: 32px;
  height: 32px;
  border: 2.5px solid #E8E5E0;
  border-top: 2.5px solid #07C160;
  border-radius: 50%;
  animation: spin 0.8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}

.loading-mask::after {
  content: '正在生成海报...';
  font-size: 13px;
  color: #9CA3AF;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

@keyframes spin {
  0%   { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* ---- 操作按钮（并排） ---- */
.poster-actions {
  width: 100%;
  display: flex;
  flex-direction: row;
  gap: 12px;
  max-width: 300px;
}

.action-btn {
  flex: 1;
  height: 48px;
  line-height: 48px;
  border-radius: 24px;
  font-size: 15px;
  font-weight: 600;
  text-align: center;
  margin: 0;
  padding: 0;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
  letter-spacing: 0.5px;
  transition: all 0.15s ease;
}

/* 绿色主按钮 */
.action-btn.share {
  background: linear-gradient(135deg, #07C160 0%, #06AD56 100%);
  color: #FFFFFF;
  box-shadow: 0 4px 14px rgba(7, 193, 96, 0.35);
}

.action-btn.share::after {
  border: none;
}

/* 白色次按钮 */
.action-btn.save {
  background: rgba(255, 255, 255, 0.95);
  color: #1A1A2E;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

/* ---- 关闭按钮 ---- */
.close-icon-container {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  border: 1px solid rgba(255, 255, 255, 0.2);
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 24px;
  transition: background 0.2s ease;
}

.close-icon-container:active {
  background: rgba(255, 255, 255, 0.25);
}

.close-icon {
  position: relative;
  width: 14px;
  height: 14px;
}

.close-icon::before,
.close-icon::after {
  content: '';
  position: absolute;
  top: 6px;
  left: 0;
  width: 14px;
  height: 1.5px;
  background: #FFFFFF;
  border-radius: 0.5px;
}

.close-icon::before { transform: rotate(45deg); }
.close-icon::after  { transform: rotate(-45deg); }

.close-btn { display: none; }

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(6px); }
  to   { opacity: 1; transform: translateY(0); }
}
