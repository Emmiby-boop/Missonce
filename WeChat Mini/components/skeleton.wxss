
/* Skeleton Loading Animation */
.skeleton-container {
  padding: 24rpx;
  background: var(--bg-color);
  min-height: 100vh;
}

.skeleton-banner {
  width: 100%;
  height: 320rpx;
  border-radius: 20rpx;
  background: var(--border-color);
  margin-bottom: 30rpx;
}

.skeleton-quick-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 40rpx;
}

.skeleton-quick-item {
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
  background: var(--border-color);
}

.skeleton-section {
  margin-bottom: 30rpx;
}

.skeleton-title {
  width: 200rpx;
  height: 40rpx;
  border-radius: 8rpx;
  background: var(--border-color);
  margin-bottom: 24rpx;
}

.skeleton-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.skeleton-item, .skeleton-card {
  width: 48%;
  height: 300rpx;
  border-radius: 16rpx;
  background: var(--border-color);
  margin-bottom: 24rpx;
  overflow: hidden;
}

/* Avatar specific skeleton styles */
.skeleton-avatar {
  width: 100%;
  height: 100%;
  background: var(--border-color);
}

.skeleton-tags {
  display: flex;
  gap: 10rpx;
  margin-top: 10rpx;
}

.skeleton-tag {
  width: 80rpx;
  height: 32rpx;
  border-radius: 8rpx;
  background: var(--border-color);
}

.shimmer {
  position: relative;
  overflow: hidden;
  background: var(--border-color);
}

.shimmer::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  transform: translateX(-100%);
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.4),
    transparent
  );
  animation: shimmer 1.5s infinite;
}

@keyframes shimmer {
  100% {
    transform: translateX(100%);
  }
}
