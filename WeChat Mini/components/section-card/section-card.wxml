<view class="section-card" wx:if="{{visible && items && items.length > 0}}">
  <block wx:if="{{title}}">
    <view class="section-header">
      <text class="section-title">{{title}}</text>
      <text class="section-more" wx:if="{{showMore && moreUrl}}" bindtap="onMoreTap">
        {{moreText}} <text class="arrow-right">→</text>
      </text>
    </view>
  </block>
  <view class="section-content" wx:else>
    <view wx:for="{{items}}" wx:key="index" class="card-item" data-index="{{index}}" bindtap="onItemTap">
      <slot name="item" data-item="{{item}}" data-index="{{index}}">
      </slot>
    </view>
  </view>
</view>