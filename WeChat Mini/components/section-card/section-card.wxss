.section-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.section-more {
  font-size: 28rpx;
  color: #666;
  display: flex;
  align-items: center;
}

.arrow-right {
  font-size: 24rpx;
  margin-left: 4rpx;
}

.section-content {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.card-item {
  flex: 1;
  min-width: 200rpx;
  padding: 16rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
}

.card-item:active {
  background: #e8e8e8;
}