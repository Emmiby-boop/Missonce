.section-avatar-row {
  background: #fff;
  border-radius: 12rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.section-more {
  font-size: 28rpx;
  color: #666;
  display: flex;
  align-items: center;
}

.arrow-right {
  font-size: 24rpx;
  margin-left: 4rpx;
}

.avatar-row {
  display: flex;
  gap: 24rpx;
  overflow-x: auto;
  padding-bottom: 16rpx;
}

.avatar-row::-webkit-scrollbar {
  display: none;
}

.avatar-item {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  min-width: 100rpx;
}

.avatar-wrapper {
  border-radius: 50%;
  overflow: hidden;
  border: 2rpx solid #f0f0f0;
}

.avatar-wrapper.small {
  width: 80rpx;
  height: 80rpx;
}

.avatar-wrapper.medium {
  width: 100rpx;
  height: 100rpx;
}

.avatar-wrapper.large {
  width: 120rpx;
  height: 120rpx;
}

.avatar-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.avatar-name {
  font-size: 24rpx;
  color: #333;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 120rpx;
}