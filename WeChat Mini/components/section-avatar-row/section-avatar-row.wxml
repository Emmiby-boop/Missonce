<view class="section-avatar-row" wx:if="{{visible && displayItems && displayItems.length > 0}}">
  <view class="section-header" wx:if="{{title}}">
    <text class="section-title">{{title}}</text>
    <text class="section-more" wx:if="{{showMore && moreUrl}}" bindtap="onMoreTap">
      {{moreText}} <text class="arrow-right">→</text>
    </text>
  </view>
  
  <view class="avatar-row">
    <view 
      class="avatar-item" 
      wx:for="{{displayItems}}" 
      wx:key="id" 
      bindtap="onItemTap" 
      data-index="{{index}}"
    >
      <view class="avatar-wrapper {{size}}">
        <image 
          class="avatar-image" 
          src="{{item.url || item.avatar}}" 
          mode="aspectFill"
        ></image>
      </view>
      <text class="avatar-name" wx:if="{{item.name}}">{{item.name}}</text>
    </view>
  </view>
</view>