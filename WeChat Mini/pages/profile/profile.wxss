/* ====== 顶部渐变区域（上深绿→下白绿过渡） ====== */
.header-banner {
  background: linear-gradient(180deg, rgba(34, 197, 94, 0.18) 0%, rgba(236, 253, 245, 0.9) 45%, rgba(255, 255, 255, 0.95) 100%);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  padding-bottom: 80rpx;
  border-radius: 0 0 48rpx 48rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 8rpx 30rpx rgba(34, 197, 94, 0.1);
}

/* 装饰光晕：右上角绿色光球 */
.header-banner::before {
  content: '';
  position: absolute;
  top: -100rpx;
  right: -100rpx;
  width: 360rpx;
  height: 360rpx;
  background: radial-gradient(circle, rgba(34, 197, 94, 0.2), transparent 70%);
  border-radius: 50%;
  filter: blur(40rpx);
  pointer-events: none;
  animation: glowBreath 6s ease-in-out infinite;
}

/* 装饰光晕：左下角浅绿光球 */
.header-banner::after {
  content: '';
  position: absolute;
  bottom: 40rpx;
  left: -80rpx;
  width: 240rpx;
  height: 240rpx;
  background: radial-gradient(circle, rgba(34, 197, 94, 0.1), transparent 70%);
  border-radius: 50%;
  filter: blur(30rpx);
  pointer-events: none;
  animation: glowBreath 6s ease-in-out infinite 3s;
}

/* 呼吸动画 */
@keyframes glowBreath {
  0%, 100% { transform: scale(1); opacity: 0.9; }
  50% { transform: scale(1.06); opacity: 1; }
}

/* ===== 低端机降级 =====
   1. header-banner 去 blur(20px)（背景本就是自身渐变，视觉几乎无损）
   2. 隐藏两个 filter:blur 光晕伪元素（顺带去掉无限呼吸动画，省 CPU/GPU） */
.header-banner.low-end {
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

.header-banner.low-end::before,
.header-banner.low-end::after {
  content: none;
  display: none;
  animation: none;
}

/* ====== 导航栏 ====== */
.custom-nav {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
}

.nav-bar {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  color: #006e2f;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

/* ====== 用户信息区 ====== */
.header-profile {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 40rpx 0;
}

.avatar-wrapper {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(34, 197, 94, 0.4);
  box-shadow: 0 8rpx 30rpx rgba(34, 197, 94, 0.2);
  overflow: hidden;
  margin-bottom: 20rpx;
  position: relative;
  z-index: 2;
}

.avatar-wrapper.logging-in {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(34, 197, 94, 0.1);
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, rgba(34, 197, 94, 0.2), rgba(34, 197, 94, 0.08));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  overflow: hidden;
  position: relative;
}

.avatar-head {
  width: 64rpx;
  height: 64rpx;
  background: rgba(34, 197, 94, 0.4);
  border-radius: 50%;
  position: absolute;
  top: 36rpx;
}

.avatar-body {
  width: 110rpx;
  height: 70rpx;
  background: rgba(34, 197, 94, 0.4);
  border-radius: 50% 50% 0 0;
  position: absolute;
  bottom: -12rpx;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #0b1c30;
  margin-bottom: 6rpx;
  position: relative;
  z-index: 2;
}

.profile-id {
  font-size: 24rpx;
  color: #5c5f61;
  margin-bottom: 10rpx;
  position: relative;
  z-index: 2;
}

.profile-badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 20rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #22c55e, #16a34a);
  box-shadow: 0 2rpx 8rpx rgba(34, 197, 94, 0.3);
  margin-bottom: 14rpx;
  position: relative;
  z-index: 2;
}

.badge-text {
  font-size: 22rpx;
  color: #fff;
  font-weight: 600;
}

.edit-btn {
  font-size: 24rpx;
  color: #006e2f;
  padding: 10rpx 30rpx;
  background: rgba(34, 197, 94, 0.12);
  border: 1rpx solid rgba(34, 197, 94, 0.2);
  border-radius: 30rpx;
  position: relative;
  z-index: 2;
}

.login-btn {
  width: 320rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #22c55e, #16a34a);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 40rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(34, 197, 94, 0.3);
  margin-top: 10rpx;
  position: relative;
  z-index: 2;
}

.login-btn::after {
  border: none;
}

.login-btn[disabled] {
  opacity: 0.7;
}

.login-tip {
  font-size: 24rpx;
  color: #5c5f61;
  margin-top: 14rpx;
  position: relative;
  z-index: 2;
}

/* ====== 内容主体 ====== */
.content-body {
  margin-top: -40rpx;
  padding: 0 24rpx 120rpx;
  position: relative;
  z-index: 1;
}

/* ====== 数据统计 ====== */
.stats-row {
  display: flex;
  align-items: center;
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 32rpx 0;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(34, 197, 94, 0.06);
  border: 1rpx solid rgba(34, 197, 94, 0.08);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s ease;
}

.stat-item:active {
  opacity: 0.7;
  transform: scale(0.95);
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #006e2f;
  line-height: 1.2;
  font-family: 'DIN Alternate', 'Roboto', sans-serif;
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
  letter-spacing: 0.05em;
}

.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: linear-gradient(to bottom, transparent, var(--border-color), transparent);
}

/* 未登录提示 */
.login-hint-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 50rpx;
  background: var(--card-bg);
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx var(--shadow-color);
}

.hint-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.hint-text {
  font-size: 28rpx;
  color: var(--text-sub);
}

/* ====== 会员卡位 ====== */
.vip-entry {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  border-radius: 20rpx;
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #0f3d24 0%, #12603a 48%, #07C160 100%);
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.2);
}

.vip-entry:active {
  transform: scale(0.99);
}

.vip-entry-deco {
  position: absolute;
  right: -50rpx;
  top: -70rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.vip-entry-main {
  flex: 1;
  min-width: 0;
  position: relative;
}

.vip-entry-head {
  display: flex;
  align-items: center;
}

.vip-entry-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}

.vip-entry-tag {
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #fff;
  font-size: 20rpx;
}

.vip-entry-tag-first {
  background: linear-gradient(135deg, #ffd700, #ffb300);
  color: #5a3e00;
  font-weight: 600;
}

.vip-entry-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}

.vip-entry-cta {
  position: relative;
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #07C160;
  font-size: 24rpx;
  font-weight: 600;
}

/* 已开通：金色调，与引导态区分 */
.vip-entry-on {
  background: linear-gradient(135deg, #3b2a00 0%, #6b4c00 48%, #d4a017 100%);
  box-shadow: 0 8rpx 24rpx rgba(212, 160, 23, 0.22);
}

.vip-entry-on .vip-entry-cta {
  color: #a06a00;
}

/* 卡位下方的协议提示小字 */
.vip-entry-agree {
  display: block;
  margin: 10rpx 4rpx 0;
  font-size: 21rpx;
  color: var(--text-sub);
  text-align: center;
}

.vip-entry-agree-link {
  color: var(--primary-color);
}

/* ====== 菜单区 ====== */
.menu-section {
  background: var(--card-bg);
  border-radius: 20rpx;
  padding: 8rpx 0;
  box-shadow: 0 2rpx 16rpx var(--shadow-color);
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
}

.menu-item + .menu-item {
  border-top: 1rpx solid var(--border-color);
}

.menu-item.share-item {
  width: 100%;
  background: transparent;
  border: none;
  border-top: 1rpx solid var(--border-color);
  border-radius: 0;
  font-size: inherit;
  line-height: normal;
  text-align: left;
  font-weight: normal;
}

.menu-item.share-item::after {
  border: none;
  display: none;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.menu-icon-box {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  flex-shrink: 0;
}

.menu-icon-img {
  width: 38rpx;
  height: 38rpx;
}

.menu-title {
  font-size: 30rpx;
  color: var(--text-main);
  font-weight: 500;
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.menu-desc {
  font-size: 24rpx;
  color: var(--text-sub);
}

/* 触感反馈开关项（图标为 images/menu-haptic.svg，与其他菜单项规范一致） */
.menu-text-col {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.menu-subtitle {
  font-size: 22rpx;
  color: var(--text-sub);
}


.menu-arrow {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.35;
}

/* ====== 退出登录 ====== */
.logout-area {
  display: flex;
  justify-content: center;
  padding: 40rpx 0;
}

.logout-btn {
  font-size: 28rpx;
  color: var(--text-sub);
  padding: 16rpx 48rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 40rpx;
}

/* ====== 弹层（保持不变） ====== */
.download-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  justify-content: center;
  align-items: center;
}

.download-panel {
  width: 85%;
  height: 70vh;
  background: var(--card-bg);
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.download-header {
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid var(--border-color);
}

.download-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-main);
}

.download-actions {
  display: flex;
  gap: 30rpx;
}

.download-action {
  font-size: 28rpx;
  color: var(--text-sub);
}

.download-list {
  flex: 1;
  height: 100%;
  padding: 20rpx;
  box-sizing: border-box;
}

.download-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  padding-bottom: 20rpx;
}

.download-grid-item {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  border-radius: 12rpx;
  overflow: hidden;
  background: var(--bg-color);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.download-thumb {
  width: 100%;
  height: 100%;
  display: block;
}

.download-type-tag {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  font-size: 20rpx;
  color: #fff;
  background: rgba(0,0,0,0.6);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.download-type-tag.avatar {
  background: rgba(7, 193, 96, 0.8);
}

.download-type-tag.wallpaper {
  background: rgba(24, 144, 255, 0.8);
}

.download-empty {
  padding: 100rpx 0;
  text-align: center;
  color: var(--text-sub);
  font-size: 28rpx;
}

/* ====== 关于面板 ====== */
.about-panel {
  width: 600rpx;
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.about-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.about-logo {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
  background: var(--bg-color);
  border-radius: 24rpx;
}

.about-name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 10rpx;
}

.about-version {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-bottom: 30rpx;
}

.about-desc {
  font-size: 28rpx;
  color: var(--text-sub);
  text-align: center;
  line-height: 1.6;
}

.about-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.about-btn {
  width: 100%;
  font-size: 30rpx;
  font-weight: 500;
  padding: 20rpx 0;
  background: var(--bg-color);
  color: var(--text-sub);
  border-radius: 40rpx;
}

.about-btn::after {
  border: none;
}

.about-btn.primary {
  /* 白绿渐变：与首页/工具页/专题页导航栏白绿主题统一 */
  background: linear-gradient(135deg, #ffffff 0%, #f0fdf4 50%, #dcfce7 100%);
  color: #16a34a;
  font-weight: 600;
  border: 1rpx solid rgba(34, 197, 94, 0.18);
  box-shadow: 0 2rpx 8rpx rgba(34, 197, 94, 0.12);
}

/* ====== Action Sheet ====== */
.action-sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 2000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.action-sheet-panel {
  background: var(--bg-color);
  border-radius: 24rpx 24rpx 0 0;
  overflow: hidden;
  padding-bottom: env(safe-area-inset-bottom);
}

.action-sheet-header {
  padding: 30rpx;
  text-align: center;
  background: var(--card-bg);
  border-bottom: 1rpx solid var(--border-color);
}

.action-sheet-title {
  font-size: 28rpx;
  color: var(--text-sub);
}

.action-sheet-body {
  background: var(--card-bg);
}

.official-account-body {
  padding: 30rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qrcode-img {
  width: 400rpx;
  height: 400rpx;
  margin: 0 auto 24rpx;
  border-radius: 16rpx;
}

.qrcode-img.hidden {
  display: none;
}

.qrcode-loading {
  width: 400rpx;
  height: 400rpx;
  margin: 0 auto 24rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--card-bg);
  border: 1rpx solid var(--border-color);
}

.qrcode-loading-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--text-sub);
}

.qrcode-desc {
  font-size: 28rpx;
  color: var(--text-sub);
  line-height: 1.5;
}

.action-btn-item {
  width: 100%;
  background: var(--card-bg) !important;
  border-radius: 0;
  padding: 30rpx 0;
  font-size: 34rpx;
  color: var(--text-main);
  border-bottom: 1rpx solid var(--border-color);
}

.action-btn-item::after {
  border: none;
}

.action-sheet-footer {
  margin-top: 16rpx;
  background: var(--card-bg);
}

.action-btn-cancel {
  padding: 30rpx 0;
  text-align: center;
  font-size: 34rpx;
  color: var(--text-main);
  font-weight: 500;
}

/* ====== Loading Spinner ====== */
.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ====== 最近使用 ====== */
.recent-section {
  margin: 30rpx 30rpx 0;
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
}

.section-more {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--text-sub);
}

.arrow-right {
  width: 24rpx;
  height: 24rpx;
  margin-left: 8rpx;
}

.recent-scroll {
  white-space: nowrap;
}

.recent-item {
  display: inline-block;
  width: 160rpx;
  margin-right: 20rpx;
  text-align: center;
}

.recent-item:last-child {
  margin-right: 0;
}

.recent-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: var(--bg-color);
}

.recent-type {
  display: block;
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ====== 深色模式：绿色渐变调暗，避免与深色背景硬切 ====== */
@media (prefers-color-scheme: dark) {
  .header-banner {
    background: linear-gradient(135deg, rgba(30, 30, 30, 0.95), rgba(40, 40, 40, 0.7));
    box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.3);
  }

  .header-banner::before {
    background: radial-gradient(circle, rgba(34, 197, 94, 0.25), transparent 70%);
  }

  .header-banner::after {
    background: radial-gradient(circle, rgba(34, 197, 94, 0.12), transparent 70%);
  }

  .nav-title {
    color: #4ae176;
  }

  .profile-name {
    color: #eaf1ff;
  }

  .profile-id,
  .login-tip {
    color: #9ca3af;
  }

  .edit-btn {
    color: #4ae176;
    background: rgba(34, 197, 94, 0.15);
    border-color: rgba(34, 197, 94, 0.25);
  }

  .avatar-wrapper {
    border-color: rgba(34, 197, 94, 0.5);
  }

  .avatar-placeholder {
    background: linear-gradient(135deg, rgba(34, 197, 94, 0.25), rgba(34, 197, 94, 0.1));
  }

  .avatar-head,
  .avatar-body {
    background: rgba(34, 197, 94, 0.5);
  }

  .stat-num {
    color: #4ae176;
  }

  /* 导航栏透明，露出 header-banner 渐变 */
  .custom-nav {
    background: transparent !important;
  }

  /* 关于我们弹层：暗色模式下使用深绿渐变 + 浅绿文字 */
  .about-btn.primary {
    background: linear-gradient(135deg, rgba(15,50,30,0.95) 0%, rgba(20,40,28,0.95) 50%, rgba(15,50,30,0.95) 100%);
    color: #4ae176;
    border: 1rpx solid rgba(34, 197, 94, 0.25);
    box-shadow: 0 2rpx 8rpx rgba(34, 197, 94, 0.15);
  }
}
