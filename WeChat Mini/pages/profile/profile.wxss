/* Global Page Settings */
page {
  background: var(--bg-color);
  padding-bottom: 40rpx;
}

/* Custom Navigation */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background: var(--primary-color);
  box-shadow: 0 6rpx 16rpx var(--shadow-color);
}

.nav-bar {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  color: #fff;
  font-size: 32rpx;
  font-weight: 400;
}

.nav-holder {
  width: 100%;
}

.container {
  padding: 0 0 120rpx 0;
}

/* User Profile Section */
.user-section {
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 4rpx 16rpx var(--shadow-color);
}

.user-content-wrapper {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.user-split-left, .user-split-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.user-avatar {
  width: 120rpx !important;
  height: 120rpx !important;
  min-width: 120rpx;
  min-height: 120rpx;
  border-radius: 50%;
  padding: 0;
  margin: 0;
  background: none;
  border: none;
  overflow: hidden;
  box-shadow: 0 6rpx 16rpx var(--shadow-color);
  display: block;
}

.user-avatar::after {
  border: none;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  background: #f0f2f5; /* 浅灰背景 */
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end; /* 从底部对齐 */
  overflow: hidden;
  position: relative;
}

/* 默认头像 - 头部 */
.avatar-head {
  width: 50rpx;
  height: 50rpx;
  background: #d1d5db; /* 深灰图标色 */
  border-radius: 50%;
  margin-bottom: 6rpx;
  position: absolute;
  top: 28rpx;
}

/* 默认头像 - 身体 */
.avatar-body {
  width: 90rpx;
  height: 60rpx;
  background: #d1d5db;
  border-radius: 50% 50% 0 0; /* 半圆 */
  position: absolute;
  bottom: -10rpx; /* 稍微沉底 */
}

.user-info {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding-left: 20rpx;
}

.login-wrapper {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  padding-left: 20rpx;
  height: 140rpx; /* 与头像高度对齐 */
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 8rpx;
}

.user-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.member-badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.member-badge.bronze {
  background: linear-gradient(135deg, #cd7f32 0%, #8b4513 100%);
  color: #fff;
}

.member-badge.silver {
  background: linear-gradient(135deg, #c0c0c0 0%, #808080 100%);
  color: #fff;
}

.member-badge.gold {
  background: linear-gradient(135deg, #ffd700 0%, #daa520 100%);
  color: #5c4008;
}

.member-badge.diamond {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.member-badge-icon {
  width: 22rpx;
  height: 22rpx;
  margin-right: 4rpx;
}

.member-badge-text {
  font-size: 20rpx;
}

.user-id {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-bottom: 12rpx;
}

.action-card {
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 4rpx 16rpx var(--shadow-color);
}

.edit-link {
  font-size: 24rpx;
  color: var(--text-sub);
  padding: 6rpx 20rpx;
  background: var(--tag-bg);
  border-radius: 20rpx;
}

.login-btn {
  margin: 0;
  padding: 0;
  background: var(--primary-color);
  border: none;
  line-height: 1.5;
  width: 320rpx; /* 调整为更合适的宽度 */
  height: 64rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(7, 193, 96, 0.25); /* 减淡阴影 */
  transition: all 0.2s ease;
}

.login-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.login-btn::after {
  border: none;
}

.login-text {
  font-size: 26rpx; /* 缩小字号 */
  color: #fff;
  font-weight: 500;
  letter-spacing: 1rpx;
}

/* 🔥 登录中状态 */
.login-btn[disabled] {
  opacity: 0.7;
}

.logging-in-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0f0f0;
}



/* Stats Card */
.stats-card {
  display: flex;
  align-items: center;
  padding: 40rpx 0;
  margin: 0 24rpx 24rpx;
  background: var(--card-bg);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx var(--shadow-color);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.stat-item:active {
  opacity: 0.7;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 8rpx;
  font-family: 'DIN Alternate', 'Roboto', sans-serif;
}

.stat-label {
  font-size: 26rpx;
  color: var(--text-sub);
}

.stat-divider {
  width: 2rpx;
  height: 40rpx;
  background: var(--border-color);
}

.login-hint {
  text-align: center;
  padding: 20rpx;
  font-size: 26rpx;
  color: var(--text-sub);
  margin: 0 24rpx 20rpx;
  background: var(--card-bg);
  border-radius: 16rpx;
}

/* Menu Section */
.menu-section {
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 0 24rpx;
  margin: 0 24rpx;
  box-shadow: 0 4rpx 16rpx var(--shadow-color);
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid var(--border-color);
  background: var(--card-bg);
  width: 100%;
  font-weight: normal;
  line-height: normal;
  min-height: auto;
}

.share-menu-btn {
  width: 100% !important;
  display: flex !important;
  justify-content: space-between !important;
  align-items: center !important;
  padding: 30rpx 0 !important;
  margin: 0 !important;
  background-color: var(--card-bg) !important;
  font-size: inherit !important;
  color: inherit !important;
  border-radius: 0 !important;
  line-height: normal !important;
  text-align: left !important;
  font-weight: normal !important;
}

.share-menu-btn::after {
  border: none !important;
  display: none !important;
}

.logout-link {
  text-align: center;
  padding: 40rpx 0;
  margin: 20rpx 24rpx;
}

.logout-link text {
  font-size: 26rpx;
  color: #e57373;
  opacity: 0.7;
}

/* 统一深色模式逻辑由 app.wxss 管理 */

/* Check-in Styles */
.checkin-area {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.checkin-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  background: linear-gradient(135deg, #ffd89b 0%, #ffd1dc 100%);
  padding: 0 20rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 10rpx rgba(255, 216, 155, 0.3);
  transition: all 0.3s ease;
}

.checkin-btn.checked {
  background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
  box-shadow: 0 2rpx 8rpx rgba(82, 196, 26, 0.15);
}

.checkin-icon-box {
  width: 48rpx;
  height: 48rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
}

.checkin-icon-img {
  width: 28rpx;
  height: 28rpx;
}

.checkin-text {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
}

.checkin-btn.checked .checkin-text {
  color: #2e7d32;
}

.points-entry {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  background: var(--bg-color);
  padding: 0 20rpx;
  border-radius: 24rpx;
  box-shadow: none;
}

.points-entry-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}

.points-entry-info {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.points-entry-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #667eea;
  line-height: 1.2;
}

.points-entry-label {
  font-size: 20rpx;
  color: #999;
}

.points-entry-arrow {
  font-size: 36rpx;
  color: #ccc;
  margin-left: 8rpx;
  line-height: 1;
}



/* About Panel */
.about-panel {
  width: 600rpx;
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.about-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.about-logo {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
  background: var(--bg-color);
  border-radius: 24rpx;
}

.about-name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 10rpx;
}

.about-version {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-bottom: 30rpx;
}

.about-desc {
  font-size: 28rpx;
  color: var(--text-sub);
  text-align: center;
  line-height: 1.6;
}

.about-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.about-btn {
  width: 100% !important;
  font-size: 30rpx;
  font-weight: 500;
  padding: 20rpx 0;
  background: var(--bg-color);
  color: var(--text-sub);
  border-radius: 40rpx;
}

.about-btn::after {
  border: none;
}

.about-btn.primary {
  background: var(--primary-color);
  color: #fff;
}

.menu-item-btn {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 0;
  background: transparent !important;
  border: none !important;
  border-bottom: 1rpx solid var(--border-color);
  text-align: left;
  line-height: normal;
}

.menu-item-btn::after {
  display: none !important;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
}

.menu-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.menu-texts {
  display: flex;
  flex-direction: column;
}

.menu-title {
  font-size: 30rpx;
  color: var(--text-main);
  margin-bottom: 4rpx;
}

.menu-desc {
  font-size: 22rpx;
  color: var(--text-sub);
}

.menu-arrow {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.3;
}

.logout-item .menu-title {
  color: #ef4444;
}

/* Download Panel */
.download-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  justify-content: center;
  align-items: center;
}

.download-panel {
  width: 85%;
  height: 70vh;
  background: var(--card-bg);
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.download-header {
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid var(--border-color);
}

.download-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-main);
}

.download-actions {
  display: flex;
  gap: 30rpx;
}

.download-action {
  font-size: 28rpx;
  color: var(--text-sub);
}

.download-list {
  flex: 1;
  height: 100%;
  padding: 20rpx;
  box-sizing: border-box;
}

.download-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  padding-bottom: 20rpx;
}

.download-grid-item {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  border-radius: 12rpx;
  overflow: hidden;
  background: var(--bg-color);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.download-thumb {
  width: 100%;
  height: 100%;
  display: block;
}

.download-type-tag {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  font-size: 20rpx;
  color: #fff;
  background: rgba(0,0,0,0.6);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  backdrop-filter: blur(4px);
}

.download-type-tag.avatar {
  background: rgba(7, 193, 96, 0.8);
}

.download-type-tag.wallpaper {
  background: rgba(24, 144, 255, 0.8);
}

.download-empty {
  padding: 80rpx 0;
  text-align: center;
  color: var(--text-sub);
  font-size: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-sub);
}

.empty-hint {
  font-size: 22rpx;
  color: var(--text-sub);
  opacity: 0.6;
}

/* Action Sheet Styles */
.action-sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 2000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.action-sheet-panel {
  background: var(--bg-color);
  border-radius: 24rpx 24rpx 0 0;
  overflow: hidden;
  padding-bottom: env(safe-area-inset-bottom);
}

.action-sheet-header {
  padding: 30rpx;
  text-align: center;
  background: var(--card-bg);
  border-bottom: 1rpx solid var(--border-color);
}

.action-sheet-title {
  font-size: 28rpx;
  color: var(--text-sub);
}

.action-sheet-body {
  background: var(--card-bg);
}

/* 公众号二维码样式 */
.official-account-body {
  padding: 30rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.qrcode-img {
  width: 400rpx;
  height: 400rpx;
  margin: 0 auto 24rpx;
  border-radius: 16rpx;
  display: block;
}

.qrcode-img.hidden {
  display: none;
}

.qrcode-loading {
  width: 400rpx;
  height: 400rpx;
  margin: 0 auto 24rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--card-bg);
  border: 1rpx solid var(--border-color);
}

.qrcode-loading-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--text-sub);
}

.qrcode-desc {
  font-size: 28rpx;
  color: var(--text-sub);
  line-height: 1.5;
  text-align: center;
  width: 100%;
}

.action-btn-item {
  width: 100%;
  background: var(--card-bg) !important;
  border-radius: 0;
  padding: 30rpx 0;
  font-size: 34rpx;
  color: var(--text-main);
  line-height: 1.4;
  border-bottom: 1rpx solid var(--border-color);
  font-weight: 400;
}

.action-btn-item::after {
  border: none;
}

.action-sheet-footer {
  margin-top: 16rpx;
  background: var(--card-bg);
}

.action-btn-cancel {
  padding: 30rpx 0;
  text-align: center;
  font-size: 34rpx;
  color: var(--text-main);
  font-weight: 500;
}

/* 深色模式由 app.wxss 全局 @media (prefers-color-scheme: dark) 统一管理，此处无需额外覆盖 */