/* ====== 顶部渐变区域 ====== */
.header-banner {
  background: linear-gradient(180deg, #07c160 0%, #05a853 40%, #06b356 100%);
  padding-bottom: 80rpx;
  border-radius: 0 0 48rpx 48rpx;
  position: relative;
  overflow: hidden;
}

/* 装饰圆 */
.header-banner::before {
  content: '';
  position: absolute;
  top: -120rpx;
  right: -80rpx;
  width: 360rpx;
  height: 360rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 50%;
}

.header-banner::after {
  content: '';
  position: absolute;
  bottom: 40rpx;
  left: -60rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 50%;
}

/* ====== 导航栏 ====== */
.custom-nav {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
}

.nav-bar {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  color: #fff;
  font-size: 34rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

/* ====== 用户信息区 ====== */
.header-profile {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 40rpx 0;
}

.avatar-wrapper {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.15);
  overflow: hidden;
  margin-bottom: 20rpx;
}

.avatar-wrapper.logging-in {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.15);
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  overflow: hidden;
  position: relative;
}

.avatar-head {
  width: 64rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 50%;
  position: absolute;
  top: 36rpx;
}

.avatar-body {
  width: 110rpx;
  height: 70rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 50% 50% 0 0;
  position: absolute;
  bottom: -12rpx;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 6rpx;
}

.profile-id {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 10rpx;
}

.profile-badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(10px);
  margin-bottom: 14rpx;
}

.badge-text {
  font-size: 22rpx;
  color: #fff;
  font-weight: 600;
}

.edit-btn {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  padding: 10rpx 30rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 30rpx;
  backdrop-filter: blur(10px);
}

.login-btn {
  width: 320rpx;
  height: 72rpx;
  background: #fff;
  color: #07c160;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 40rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
  margin-top: 10rpx;
}

.login-btn::after {
  border: none;
}

.login-btn[disabled] {
  opacity: 0.7;
}

.login-tip {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 14rpx;
}

/* ====== 签到 + 积分双卡片 ====== */
.dual-cards {
  display: flex;
  gap: 20rpx;
  padding: 30rpx 30rpx 0;
}

.action-card {
  flex: 1;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10px);
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sign-card.checked {
  background: rgba(255, 255, 255, 0.12);
}

.card-icon-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.card-icon-box {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-icon-emoji {
  font-size: 28rpx;
}

.card-badge {
  font-size: 20rpx;
  color: #FFD700;
  background: rgba(0, 0, 0, 0.15);
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.card-badge.points-badge {
  color: rgba(255, 255, 255, 0.75);
}

.card-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 4rpx;
}

.card-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 4rpx;
  font-family: 'DIN Alternate', 'Roboto', sans-serif;
}

.card-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}

/* ====== 内容主体 ====== */
.content-body {
  margin-top: -40rpx;
  padding: 0 24rpx 120rpx;
  position: relative;
  z-index: 1;
}

/* ====== 数据统计 ====== */
.stats-row {
  display: flex;
  align-items: center;
  background: var(--card-bg);
  border-radius: 20rpx;
  padding: 36rpx 0;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx var(--shadow-color);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.stat-item:active {
  opacity: 0.7;
}

.stat-num {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.2;
  font-family: 'DIN Alternate', 'Roboto', sans-serif;
}

.stat-label {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
}

.stat-divider {
  width: 2rpx;
  height: 48rpx;
  background: var(--border-color);
}

/* 未登录提示 */
.login-hint-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 50rpx;
  background: var(--card-bg);
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx var(--shadow-color);
}

.hint-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.hint-text {
  font-size: 28rpx;
  color: var(--text-sub);
}

/* ====== 菜单区 ====== */
.menu-section {
  background: var(--card-bg);
  border-radius: 20rpx;
  padding: 8rpx 0;
  box-shadow: 0 2rpx 16rpx var(--shadow-color);
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
}

.menu-item + .menu-item {
  border-top: 1rpx solid var(--border-color);
}

.menu-item.share-item {
  width: 100%;
  background: transparent;
  border: none;
  border-top: 1rpx solid var(--border-color);
  border-radius: 0;
  font-size: inherit;
  line-height: normal;
  text-align: left;
  font-weight: normal;
}

.menu-item.share-item::after {
  border: none;
  display: none;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.menu-icon-box {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-icon-img {
  width: 38rpx;
  height: 38rpx;
}

.menu-title {
  font-size: 30rpx;
  color: var(--text-main);
  font-weight: 500;
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.menu-desc {
  font-size: 24rpx;
  color: var(--text-sub);
}

.menu-arrow {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.35;
}

/* ====== 退出登录 ====== */
.logout-area {
  display: flex;
  justify-content: center;
  padding: 40rpx 0;
}

.logout-btn {
  font-size: 28rpx;
  color: var(--text-sub);
  padding: 16rpx 48rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 40rpx;
}

/* ====== 弹层（保持不变） ====== */
.download-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  justify-content: center;
  align-items: center;
}

.download-panel {
  width: 85%;
  height: 70vh;
  background: var(--card-bg);
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.download-header {
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid var(--border-color);
}

.download-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-main);
}

.download-actions {
  display: flex;
  gap: 30rpx;
}

.download-action {
  font-size: 28rpx;
  color: var(--text-sub);
}

.download-list {
  flex: 1;
  height: 100%;
  padding: 20rpx;
  box-sizing: border-box;
}

.download-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  padding-bottom: 20rpx;
}

.download-grid-item {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  border-radius: 12rpx;
  overflow: hidden;
  background: var(--bg-color);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.download-thumb {
  width: 100%;
  height: 100%;
  display: block;
}

.download-type-tag {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  font-size: 20rpx;
  color: #fff;
  background: rgba(0,0,0,0.6);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.download-type-tag.avatar {
  background: rgba(7, 193, 96, 0.8);
}

.download-type-tag.wallpaper {
  background: rgba(24, 144, 255, 0.8);
}

.download-empty {
  padding: 100rpx 0;
  text-align: center;
  color: var(--text-sub);
  font-size: 28rpx;
}

/* ====== 关于面板 ====== */
.about-panel {
  width: 600rpx;
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.about-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.about-logo {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
  background: var(--bg-color);
  border-radius: 24rpx;
}

.about-name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 10rpx;
}

.about-version {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-bottom: 30rpx;
}

.about-desc {
  font-size: 28rpx;
  color: var(--text-sub);
  text-align: center;
  line-height: 1.6;
}

.about-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.about-btn {
  width: 100%;
  font-size: 30rpx;
  font-weight: 500;
  padding: 20rpx 0;
  background: var(--bg-color);
  color: var(--text-sub);
  border-radius: 40rpx;
}

.about-btn::after {
  border: none;
}

.about-btn.primary {
  background: var(--primary-color);
  color: #fff;
}

/* ====== Action Sheet ====== */
.action-sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 2000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.action-sheet-panel {
  background: var(--bg-color);
  border-radius: 24rpx 24rpx 0 0;
  overflow: hidden;
  padding-bottom: env(safe-area-inset-bottom);
}

.action-sheet-header {
  padding: 30rpx;
  text-align: center;
  background: var(--card-bg);
  border-bottom: 1rpx solid var(--border-color);
}

.action-sheet-title {
  font-size: 28rpx;
  color: var(--text-sub);
}

.action-sheet-body {
  background: var(--card-bg);
}

.official-account-body {
  padding: 30rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qrcode-img {
  width: 400rpx;
  height: 400rpx;
  margin: 0 auto 24rpx;
  border-radius: 16rpx;
}

.qrcode-img.hidden {
  display: none;
}

.qrcode-loading {
  width: 400rpx;
  height: 400rpx;
  margin: 0 auto 24rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--card-bg);
  border: 1rpx solid var(--border-color);
}

.qrcode-loading-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--text-sub);
}

.qrcode-desc {
  font-size: 28rpx;
  color: var(--text-sub);
  line-height: 1.5;
}

.action-btn-item {
  width: 100%;
  background: var(--card-bg) !important;
  border-radius: 0;
  padding: 30rpx 0;
  font-size: 34rpx;
  color: var(--text-main);
  border-bottom: 1rpx solid var(--border-color);
}

.action-btn-item::after {
  border: none;
}

.action-sheet-footer {
  margin-top: 16rpx;
  background: var(--card-bg);
}

.action-btn-cancel {
  padding: 30rpx 0;
  text-align: center;
  font-size: 34rpx;
  color: var(--text-main);
  font-weight: 500;
}

/* ====== Loading Spinner ====== */
.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
