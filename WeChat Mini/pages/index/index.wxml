<view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-bar">
    <text class="nav-title">首页</text>

  </view>
</view>
<view class="nav-holder" style="height: {{statusBarHeight + navBarHeight - 1}}px;"></view>

<view class="container">
  <!-- 搜索框 (吸顶) -->
  <view class="search-container" style="top: {{statusBarHeight + navBarHeight - 1}}px;">
    <view class="search-header" bindtap="navigateToSearch">
      <view class="search-input-container">
        <image class="search-icon-img" src="../../images/icon-search.png" mode="widthFix"></image>
        <text class="search-placeholder">请输入关键词搜索壁纸或头像</text>
      </view>
    </view>
  </view>


  <!-- 骨架屏 -->
  <view class="skeleton-container" wx:if="{{loading && banners.length === 0}}">
    <view class="skeleton-banner shimmer"></view>
    <view class="skeleton-quick-row">
       <view class="skeleton-quick-item shimmer" wx:for="{{4}}" wx:key="index"></view>
    </view>
    <view class="skeleton-section">
      <view class="skeleton-title shimmer"></view>
      <view class="skeleton-grid">
        <view class="skeleton-item shimmer" wx:for="{{4}}" wx:key="index"></view>
      </view>
    </view>
  </view>


  <!-- 滚轮播放 -->
  <swiper class="banner-swiper" autoplay circular interval="3200" indicator-dots indicator-color="rgba(255,255,255,0.35)" indicator-active-color="#07c160" wx:if="{{!loading || banners.length > 0}}">
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <image class="banner-image" src="{{item.image}}" mode="aspectFill" bindtap="onBannerTap" data-id="{{item.id}}"></image>
    </swiper-item>
  </swiper>


  <!-- 快捷功能 -->
  <view class="section-card quick-card" wx:if="{{!loading || banners.length > 0}}">
    <view class="section-header quick-header">
      <view class="section-left">
        <view class="section-indicator"></view>
        <text class="section-title">快捷功能</text>
        <text class="section-sub">一键直达 · 更省时间</text>
      </view>
    </view>
    <view class="quick-grid">
      <view class="quick-item" bindtap="navigateToTopicList">
        <view class="quick-icon-box" style="background: #e0f2fe;">
          <image src="../../images/icon-fire.png" class="quick-icon"></image>
        </view>
        <text class="quick-text">精选专题</text>
      </view>
      <view class="quick-item" bindtap="navigateToInspiration">
        <view class="quick-icon-box" style="background: #e0f2fe;">
          <text style="font-size: 40rpx;">✨</text>
        </view>
        <text class="quick-text">灵感文案</text>
      </view>
      <view class="quick-item" bindtap="randomWallpaper">
        <view class="quick-icon-box" style="background: #e0f2fe;">
          <image class="quick-icon" src="../../images/wallpaper-active.png" mode="widthFix"></image>
        </view>
        <text class="quick-text">随机壁纸</text>
      </view>
      <view class="quick-item" bindtap="navigateToFavorites">
        <view class="quick-icon-box" style="background: #e0f2fe;">
          <image class="quick-icon" src="../../images/profile-active.png" mode="widthFix"></image>
        </view>
        <text class="quick-text">收藏夹</text>
        <view class="quick-badge" wx:if="{{favoritesCount > 0}}">{{favoritesCount}}</view>
      </view>
    </view>
  </view>

  <!-- 动态展示区域 -->
  <block wx:for="{{sections}}" wx:key="id" wx:for-item="section">
    
    <!-- 类型1: 头像横向/网格展示 (avatar_row) -->
    <view class="section-card section" wx:if="{{section.type === 'avatar_row'}}">
      <view class="section-header">
        <view class="section-left">
          <view class="section-indicator"></view>
          <text class="section-title">{{section.title}}</text>
          <text wx:if="{{section.subtitle}}" class="section-sub">{{section.subtitle}}</text>
        </view>
        <view bindtap="onSectionMore" data-section="{{section}}" class="section-more">
          <text>更多</text>
          <image class="more-icon" src="../../images/icon-arrow.png" mode="widthFix"></image>
        </view>
      </view>
      
      <view class="grid grid-4 avatar-grid">
        <view class="grid-item avatar-item" wx:for="{{section.items}}" wx:key="id" wx:for-item="res" 
              bindtap="previewImage" 
              data-url="{{res.url}}" 
              data-original-url="{{res.originalUrl}}" 
              data-raw-url="{{res.rawUrl}}" 
              data-raw-original-url="{{res.rawOriginalUrl}}" 
              data-type="avatar" 
              data-categories="{{res.categories}}" 
              data-tags="{{res.tags}}">
          <view class="square-wrap">
            <image class="square-img" src="{{res.url}}" mode="aspectFill" lazy-load></image>
          </view>
        </view>
      </view>
    </view>

    <!-- 类型2: 壁纸网格展示 (wallpaper_grid) -->
    <view class="section-card section" wx:if="{{section.type === 'wallpaper_grid'}}">
      <view class="section-header">
        <view class="section-left">
          <view class="section-indicator"></view>
          <text class="section-title">{{section.title}}</text>
          <text wx:if="{{section.subtitle}}" class="section-sub">{{section.subtitle}}</text>
        </view>
        <view bindtap="onSectionMore" data-section="{{section}}" class="section-more">
          <text>更多</text>
          <image class="more-icon" src="../../images/icon-arrow.png" mode="widthFix"></image>
        </view>
      </view>

      <waterfall list="{{section.items}}" bind:itemtap="onWaterfallItemTap" />
    </view>

    <!-- 类型3: 瀑布流 (waterfall) -->
    <view class="section-card section" wx:if="{{section.type === 'waterfall'}}">
      <view class="section-header">
        <view class="section-left">
          <view class="section-indicator"></view>
          <text class="section-title">{{section.title}}</text>
          <text wx:if="{{section.subtitle}}" class="section-sub">{{section.subtitle}}</text>
        </view>
        <view bindtap="onSectionMore" data-section="{{section}}" class="section-more">
          <text>更多</text>
          <image class="more-icon" src="../../images/icon-arrow.png" mode="widthFix"></image>
        </view>
      </view>
      <waterfall list="{{section.items}}" column-count="{{section.styleConfig.columns || 2}}" bind:itemtap="onWaterfallItemTap" />
    </view>

    <!-- 类型4: 卡片视图 (card) -->
    <view class="section-card section" wx:if="{{section.type === 'card'}}">
       <view class="section-header">
        <view class="section-left">
          <view class="section-indicator"></view>
          <text class="section-title">{{section.title}}</text>
          <text wx:if="{{section.subtitle}}" class="section-sub">{{section.subtitle}}</text>
        </view>
        <view bindtap="onSectionMore" data-section="{{section}}" class="section-more">
          <text>更多</text>
          <image class="more-icon" src="../../images/icon-arrow.png" mode="widthFix"></image>
        </view>
      </view>
      <scroll-view scroll-x class="card-scroll" enable-flex>
         <view class="card-item" wx:for="{{section.items}}" wx:key="id" bindtap="previewImage" 
              data-url="{{item.url}}" 
              data-original-url="{{item.originalUrl}}" 
              data-raw-url="{{item.rawUrl}}" 
              data-raw-original-url="{{item.rawOriginalUrl}}" 
              data-type="{{item.type || 'wallpaper'}}" 
              data-categories="{{item.categories}}" 
              data-tags="{{item.tags}}">
            <image class="card-img" src="{{item.url}}" mode="aspectFill" lazy-load></image>
            <view class="card-mask"></view>
         </view>
      </scroll-view>
    </view>
  </block>

</view>

<!-- 收藏弹层 -->
<view class="download-mask" wx:if="{{showFavorites}}" bindtap="closeFavoritesPanel">
  <view class="download-panel" catchtap="noop">
    <view class="download-header">
      <text class="download-title">我的收藏</text>
      <view class="download-actions">
        <text class="download-action" bindtap="closeFavoritesPanel">关闭</text>
      </view>
    </view>
    <scroll-view scroll-y class="download-list" bindscrolltolower="loadMoreFavorites">
      <block wx:if="{{favoritesList.length}}">
        <view class="download-grid">
          <view class="download-grid-item" wx:for="{{favoritesList}}" wx:key="url" bindtap="handleFavoriteTap" data-url="{{item.url}}" data-type="{{item.type}}">
            <image class="download-thumb" src="{{item.url}}" mode="aspectFill" lazy-load></image>
            <view class="download-type-tag {{item.type}}">{{item.type === 'avatar' ? '头像' : '壁纸'}}</view>
          </view>
        </view>
      </block>
      <view class="download-empty" wx:else>
        <text>暂无收藏</text>
      </view>
    </scroll-view>
  </view>
</view>

