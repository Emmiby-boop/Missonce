<!-- WXS 工具函数：公告优先级图标 -->
<wxs module="announce">
var getPriorityIcon = function(priority) {
  if (priority === 'high') return '🔴';
  if (priority === 'low') return 'ℹ️';
  return '📢';
};
module.exports = { getPriorityIcon: getPriorityIcon };
</wxs>

<!-- 导航栏：毛玻璃效果 + 通知按钮 + 搜索图标 -->
<view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-bar" style="height: {{navBarHeight}}px;">
    <!-- 左：通知按钮 -->
    <view class="nav-icon-btn nav-notify-btn" bindtap="navigateToNotifications">
      <image class="nav-icon-img" src="../../images/icon-bell.svg" mode="aspectFit"></image>
      <view class="nav-badge" wx:if="{{unreadNotificationCount > 0}}">
        {{unreadNotificationCount > 99 ? '99+' : unreadNotificationCount}}
      </view>
    </view>
    <!-- 右：搜索按钮（紧贴胶囊按钮左侧） -->
    <view class="nav-icon-btn nav-search-btn" bindtap="navigateToSearch" style="right: {{menuRightGap}}px;">
      <image class="nav-icon-img" src="../../images/icon-search.png" mode="aspectFit"></image>
    </view>
  </view>
</view>
<view class="nav-holder" style="height: {{statusBarHeight + navBarHeight - 1}}px;"></view>

<view class="container">
  <ad-unit kind="interstitial" page-path="/pages/index/index"></ad-unit>

  <!-- 分类 Tab：sticky 悬浮，横向滚动 -->
  <scroll-view scroll-x class="category-sticky" style="top: {{statusBarHeight + navBarHeight - 1}}px;" wx:if="{{!loading}}" enable-flex
    scroll-left="{{tabScrollLeft}}" scroll-with-animation="{{true}}" bindscroll="onTabScroll">
    <view class="category-tab {{activeCategory === item.id ? 'active' : ''}}"
      wx:for="{{categoryTabs}}" wx:key="id"
      id="tab-{{index}}"
      bindtap="onCategoryTap" data-id="{{item.id}}" data-index="{{index}}">
      <text>{{item.name}}</text>
    </view>
  </scroll-view>

  <!-- 骨架屏 -->
  <view class="skeleton-container" wx:if="{{loading}}">
    <view class="skeleton-grid">
      <view class="skeleton-item shimmer" wx:for="{{6}}" wx:key="index"></view>
    </view>
  </view>


  <!-- ========== 推荐 Tab：热门资源瀑布流（中间穿插全宽广告） ========== -->
  <!-- 🔥 优化：用 hidden 替代 wx:if，保留 waterfall 组件实例，切换 Tab 时不销毁重建 -->
  <!-- 注意：必须用 <view hidden> 而非 <block hidden>，block 是虚拟容器不支持 hidden 属性 -->
  <view hidden="{{loading || activeCategory !== 'recommend'}}">
    <!-- 推荐资源：瀑布流（广告伪装成 9:16 卡片混在列表中） -->
    <!-- 🔥 禁用虚拟滚动：瀑布流项高度不一致（壁纸9:16/头像1:1/文案矮卡/广告高卡），
         单一估算高度必然不准，占位符高度与实际项高度不符会导致页面总高度突变，
         引发 scrollTop 跳变 → 可见区间反复重算 → 滑动一跳一跳 → 最终白屏。
         列表项数有限（每页20，几页100+），全量渲染 + lazy-load 已足够 -->
    <waterfall list="{{recommendResources}}" bind:itemtap="onWaterfallItemTap" bind:quotetap="onQuoteTap"
               enableVirtualScroll="{{false}}" />
    <view class="tag-loading-more" wx:if="{{recommendLoading}}">加载中...</view>
    <!-- 🔥 低端机渲染上限：触底自动加载停用，改手动分批渲染 -->
    <view class="load-more-btn" wx:if="{{recommendCapped}}" bindtap="onLoadMoreCapped" hover-class="load-more-btn-hover">点击加载更多</view>
    <view class="tag-loading-more" wx:if="{{!recommendLoading && !recommendCapped && !recommendHasMore && recommendResources.length > 0}}">没有更多了</view>
    <view class="tag-empty" wx:if="{{!recommendLoading && recommendResources.length === 0}}">暂无内容</view>
  </view>

  <!-- ========== 最新 Tab：按上传时间倒序的资源瀑布流 ========== -->
  <view hidden="{{loading || activeCategory !== 'latest'}}">
    <waterfall list="{{latestResources}}" bind:itemtap="onWaterfallItemTap" bind:quotetap="onQuoteTap"
               enableVirtualScroll="{{false}}" />
    <view class="tag-loading-more" wx:if="{{latestLoading}}">加载中...</view>
    <!-- 🔥 低端机渲染上限（同推荐 Tab） -->
    <view class="load-more-btn" wx:if="{{latestCapped}}" bindtap="onLoadMoreCapped" hover-class="load-more-btn-hover">点击加载更多</view>
    <view class="tag-loading-more" wx:if="{{!latestLoading && !latestCapped && !latestHasMore && latestResources.length > 0}}">没有更多了</view>
    <view class="tag-empty" wx:if="{{!latestLoading && latestResources.length === 0}}">暂无内容</view>
  </view>

  <!-- ========== 标签 Tab：瀑布流（广告伪装成 9:16 卡片混在列表中） ========== -->
  <view hidden="{{loading || activeCategory === 'recommend' || activeCategory === 'latest'}}">
    <waterfall list="{{tagResources}}" bind:itemtap="onWaterfallItemTap" bind:quotetap="onQuoteTap"
               enableVirtualScroll="{{false}}" />
    <view class="tag-loading-more" wx:if="{{tagLoading}}">加载中...</view>
    <!-- 🔥 低端机渲染上限（同推荐 Tab） -->
    <view class="load-more-btn" wx:if="{{tagCapped}}" bindtap="onLoadMoreCapped" hover-class="load-more-btn-hover">点击加载更多</view>
    <view class="tag-loading-more" wx:if="{{!tagLoading && !tagCapped && !tagHasMore && tagResources.length > 0}}">没有更多了</view>
    <view class="tag-empty" wx:if="{{!tagLoading && tagResources.length === 0}}">暂无相关内容</view>
  </view>

</view>

<!-- 公告弹窗 -->
<view class="announcement-mask" wx:if="{{showAnnouncement}}" bindtap="closeAnnouncement">
  <view class="announcement-panel" catchtap="noop">
    <view class="announcement-header">
      <text class="announcement-icon">{{currentAnnouncement.icon}}</text>
      <text class="announcement-title">{{currentAnnouncement.title}}</text>
    </view>
    <image wx:if="{{currentAnnouncement.coverUrl || currentAnnouncement.coverImage}}" class="announcement-cover" src="{{currentAnnouncement.coverUrl || currentAnnouncement.coverImage}}" mode="aspectFill" />
    <view class="announcement-content">
      <text class="announcement-text">{{currentAnnouncement.summary || currentAnnouncement.content}}</text>
    </view>
    <view class="announcement-footer">
      <view class="announcement-checkbox" bindtap="toggleDontShowAgain">
        <view class="checkbox-box {{dontShowAgain ? 'checked' : ''}}">
          <text wx:if="{{dontShowAgain}}" class="checkbox-check">✓</text>
        </view>
        <text class="checkbox-text">不再显示</text>
      </view>
      <view class="announcement-actions">
        <button class="announcement-btn secondary" bindtap="closeAnnouncement">关闭</button>
        <button class="announcement-btn primary" bindtap="handleAnnouncementConfirm" wx:if="{{currentAnnouncement.linkType !== 'none' || currentAnnouncement.contentHtml || currentAnnouncement.coverImage}}">查看详情</button>
      </view>
    </view>
  </view>
</view>
