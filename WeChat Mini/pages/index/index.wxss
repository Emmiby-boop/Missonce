@import "./skeleton.wxss";

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background: var(--primary-color);
  box-shadow: 0 6rpx 16rpx var(--shadow-color);
}

.nav-bar {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.nav-title {
  color: #fff;
  font-size: 32rpx;
  font-weight: 400;
  flex: 1;
  text-align: center;
}

.nav-right {
  position: relative;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-notification-icon {
  font-size: 40rpx;
}

.nav-badge {
  position: absolute;
  top: 0;
  right: 0;
  background: #ff4757;
  color: #fff;
  font-size: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  border: 4rpx solid var(--primary-color);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 8rpx rgba(255, 71, 87, 0.3);
}

/* 确保导航栏与其他页面一致 */
.nav-holder {
  width: 100%;
}

.container {
  padding: 0;
  background: var(--bg-color);
}

.search-container {
  padding: 18rpx 24rpx 14rpx;
  margin-bottom: 6rpx;
  position: sticky;
  z-index: 99;
  background: var(--bg-color); /* Match page background */
}

.native-top-ad {
  position: sticky;
  z-index: 98;
  /* 🔥 修复：使用页面背景色，确保与下方内容衔接自然 */
  background: var(--bg-color);
  padding: 8rpx 0;
}

.native-video-bottom-ad {
  padding: 20rpx 24rpx;
  background: #fff;
}

.native-top-ad ad-custom {
  display: block;
  width: 100%;
}

.native-video-mid-ad {
  padding: 12rpx 24rpx;
}

.search-header {
  background: var(--card-bg);
  border-radius: 999rpx;
  padding: 16rpx 24rpx;
  box-shadow: 0 8rpx 24rpx var(--shadow-color);
  display: flex;
  align-items: center;
}

.search-input-container {
  display: flex;
  align-items: center;
  width: 100%;
}

.search-icon-img {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
  opacity: 0.5;
}

.search-placeholder {
  font-size: 28rpx;
  color: var(--text-sub);
}

/* 轮播图 */
.banner-swiper {
  height: 340rpx;
  margin: 20rpx 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 32rpx var(--shadow-color);
  transform: translateY(0); /* Fix for overflow issues on some devices */
}

.banner-container {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
  overflow: hidden;
}

.banner-image {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
}

.banner-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx 24rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.7), transparent);
  border-radius: 0 0 24rpx 24rpx;
}

.banner-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.3);
  line-height: 1.4;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 卡片通用样式 */
.section-card {
  margin: 24rpx;
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx var(--shadow-color);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-left {
  display: flex;
  flex-direction: column;
}

.section-indicator {
  width: 40rpx;
  height: 6rpx;
  background: var(--primary-color);
  border-radius: 999rpx;
  margin-bottom: 8rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-main);
  line-height: 1.4;
}

/* Remove old dot style */
.badge-dot {
  display: none;
}

.section-sub {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-left: 4rpx;
  font-weight: 400;
}

.section-more {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--text-sub);
  background: var(--border-color);
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  transition: all 0.2s ease;
}

.section-more:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.more-icon {
  width: 20rpx;
  height: 20rpx;
  margin-left: 6rpx;
  opacity: 0.6;
}

/* 快捷功能 */
.quick-card {
  padding: 28rpx 24rpx;
}

.quick-header {
  margin-bottom: 32rpx;
}

.quick-grid {
  display: flex;
  justify-content: space-between;
  padding: 0 12rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  position: relative;
}

.quick-icon-box {
  width: 120rpx;
  height: 120rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s ease;
  box-shadow: 0 8rpx 24rpx var(--shadow-color);
}

/* 各图标渐变背景 */
.quick-icon-topics {
  background: linear-gradient(135deg, #FEE2E2 0%, #FECACA 100%);
}

.quick-icon-inspiration {
  background: linear-gradient(135deg, #EDE9FE 0%, #DDD6FE 100%);
}

.quick-icon-daily {
  background: linear-gradient(135deg, #D1FAE5 0%, #A7F3D0 100%);
}

.quick-icon-watermark {
  background: linear-gradient(135deg, #DBEAFE 0%, #BFDBFE 100%);
}

.quick-item:active .quick-icon-box {
  transform: scale(0.95);
}

.quick-icon {
  width: 56rpx;
  height: 56rpx;
}

.quick-text {
  font-size: 26rpx;
  color: var(--text-main);
  font-weight: 500;
}

.quick-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  background: #ff4757;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  border: 4rpx solid var(--card-bg);
}

/* 瀑布流布局 */
.waterfall-container {
  display: flex;
  justify-content: space-between;
  padding: 0 4rpx;
  gap: 20rpx;
}

.waterfall-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.waterfall-item {
  background: var(--card-bg);
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
  box-shadow: 0 4rpx 12rpx var(--shadow-color);
  transition: transform 0.2s ease;
}

.waterfall-item:active {
  transform: scale(0.98);
}

.waterfall-image {
  width: 100%;
  height: auto;
  display: block;
  background: var(--border-color);
}

.item-info {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 12rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.4), transparent);
  display: flex;
  align-items: center;
}

.item-tag {
  font-size: 18rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(4px);
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

/* 网格布局 */
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.grid-2 .grid-item {
  width: 47%;
  margin-bottom: 24rpx;
}

.grid-3 .grid-item {
  width: 32%;
  margin-bottom: 16rpx;
}

.grid-4 .grid-item {
  width: 23.5%;
  margin-bottom: 16rpx;
}

/* 头像网格 */
.avatar-grid {
  margin-top: 8rpx;
}

.avatar-item {
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx var(--shadow-color);
  background: var(--card-bg);
}

.square-wrap {
  width: 100%;
  padding-top: 100%;
  position: relative;
}

.square-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 壁纸网格 */
.wallpaper-grid {
  margin-top: 8rpx;
}

.wallpaper-image {
  width: 100%;
  height: 580rpx;
  border-radius: 16rpx;
  object-fit: cover;
  background: var(--card-bg);
  box-shadow: 0 4rpx 12rpx var(--shadow-color);
}

.grid-3 .wallpaper-image {
  height: 372rpx;
}

/* Card Scroll Layout */
.card-scroll {
  white-space: nowrap;
  display: flex;
  padding-bottom: 10rpx;
}

.card-item {
  display: inline-block;
  width: 280rpx;
  height: 400rpx;
  margin-right: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
  box-shadow: 0 4rpx 12rpx var(--shadow-color);
  background: var(--card-bg);
}

.card-item:last-child {
  margin-right: 10rpx;
}

.card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.card-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0) 60%, rgba(0,0,0,0.3));
}

/* 最近更新 */
.recent-section {
  padding-bottom: 32rpx;
}

.recent-group {
  margin-bottom: 32rpx;
}

.recent-group:last-child {
  margin-bottom: 0;
}

.recent-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 20rpx;
  display: block;
  padding-left: 8rpx;
  border-left: 6rpx solid var(--primary-color);
  line-height: 1.2;
}

/* 筛选按钮样式 */
.filter-row {
  display: flex;
  gap: 16rpx;
  padding: 0 24rpx 20rpx;
}

.filter-chip {
  padding: 8rpx 24rpx;
  background: var(--border-color);
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--text-sub);
  transition: all 0.2s ease;
}

.filter-chip.active {
  background: var(--primary-color);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.25);
  font-weight: 500;
}

/* Dark Mode Support */
@media (prefers-color-scheme: dark) {
  page {
    background: #111827;
  }

  .custom-nav {
    background: var(--bg-color);
  }

  .search-container {
    background: #111827;
  }

  .search-header {
    background: #1f2937;
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.3);
  }

  .search-placeholder {
    color: #4b5563;
  }

  .search-icon-img {
    opacity: 0.3;
  }

  .section-card {
    background: #1f2937;
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
  }

  .section-title {
    color: #f3f4f6;
  }

  .section-sub {
    color: #9ca3af;
  }

  .section-more {
    background: #374151;
    color: #9ca3af;
  }

  .quick-text {
    color: #f3f4f6;
  }

  .quick-badge {
    border-color: #1f2937;
  }

  .waterfall-item,
  .avatar-item,
  .wallpaper-image,
  .card-item {
    background: #1f2937;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  }

  .waterfall-image {
    background: #374151;
  }

  .recent-title {
    color: #f3f4f6;
  }

  .filter-chip {
    background: #374151;
    color: #9ca3af;
  }

  .filter-chip.active {
    background: #07c160;
    color: #fff;
  }

  .download-panel {
    background: #1f2937;
  }

  .download-header {
    border-bottom-color: #374151;
  }

  .download-title,
  .download-action {
    color: #f3f4f6;
  }

  .download-grid-item {
    background: #374151;
  }

  .download-empty {
    color: #6b7280;
  }
}

.download-panel {
  width: 85%;
  height: 70vh;
  background: #fff;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.download-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(4px);
}

.download-header {
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #eee;
}

.download-title {
  font-size: 32rpx;
  font-weight: 500;
}

.download-actions {
  display: flex;
  gap: 30rpx;
}

.download-action {
  font-size: 28rpx;
  color: #666;
}

.download-list {
  flex: 1;
  height: 100%;
  padding: 20rpx;
  box-sizing: border-box;
}

.download-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  padding-bottom: 20rpx;
}

.download-grid-item {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f5f5f5;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.download-thumb {
  width: 100%;
  height: 100%;
  display: block;
}

.download-type-tag {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  font-size: 20rpx;
  color: #fff;
  background: rgba(0,0,0,0.6);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  backdrop-filter: blur(4px);
}

.download-type-tag.avatar {
  background: rgba(7, 193, 96, 0.8);
}

.download-type-tag.wallpaper {
  background: rgba(24, 144, 255, 0.8);
}

.download-empty {
  padding: 100rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 公告弹窗 */
.announcement-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  backdrop-filter: blur(4px);
}

.announcement-panel {
  width: 100%;
  max-width: 600rpx;
  background: var(--card-bg);
  border-radius: 32rpx;
  overflow: hidden;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.announcement-header {
  padding: 40rpx 40rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, #05a853 100%);
}

.announcement-icon {
  font-size: 48rpx;
}

.announcement-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  line-height: 1.4;
}

.announcement-content {
  padding: 40rpx;
  max-height: 500rpx;
  overflow-y: auto;
}

.announcement-text {
  font-size: 28rpx;
  color: var(--text-main);
  line-height: 1.8;
  white-space: pre-wrap;
}

.announcement-footer {
  padding: 30rpx 40rpx 40rpx;
  border-top: 1rpx solid var(--border-color);
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.announcement-checkbox {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.checkbox-box {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.checkbox-box.checked {
  background: var(--primary-color);
  border-color: var(--primary-color);
}

.checkbox-check {
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
}

.checkbox-text {
  font-size: 26rpx;
  color: var(--text-sub);
}

.announcement-actions {
  display: flex;
  gap: 20rpx;
}

.announcement-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.announcement-btn.secondary {
  background: var(--border-color);
  color: var(--text-main);
}

.announcement-btn.primary {
  background: var(--primary-color);
  color: #fff;
}

@media (prefers-color-scheme: dark) {
  .announcement-panel {
    background: #1f2937;
  }
}
