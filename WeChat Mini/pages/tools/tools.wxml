<!-- 毛玻璃导航栏 -->
<view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-bar">
    <text class="nav-title">工具箱</text>
    <text class="nav-count" wx:if="{{toolsCount > 0}}">{{toolsCount}} 个创作工具</text>
  </view>
</view>
<view class="nav-holder" style="height: {{statusBarHeight + navBarHeight - 1}}px;"></view>

<view class="container">
  <ad-unit kind="interstitial" page-path="/pages/tools/tools"></ad-unit>

<!-- 每日签到 —— 2026-10-10 压缩为一行
     改版原因（借鉴壁纸二 2026-10-06 的教训）：
     原实现是 340rpx 的大卡（tag + 标题 + 描述 + 火苗徽章 + conic-gradient 进度环
     + 双行进度文案 + 88rpx 按钮 + 奖励胶囊，共 7 层信息），
     占了首屏近一半高度，用户进「工具箱」第一眼看到的是运营活动而不是工具。
     现在压缩到 ~108rpx 一行，要点：
       ① 奖励数字必须保留 —— 压缩后要移进文案行，否则失去点击动机
       ② 已签到用降饱和表达「这是状态」而不是「召唤」
       ③ 今天待签用实心点，视觉上等你点
-->
<view class="checkin {{isCheckedIn ? 'is-checked' : ''}}" catchtap="handleCheckIn">
  <view class="checkin-left">
    <text class="checkin-title">{{isCheckedIn ? '今日已签到' : '每日签到'}}</text>
    <text class="checkin-desc">{{isCheckedIn ? ('连续 ' + checkInDays + ' 天') : ('+' + checkInReward + ' 辣度值')}}</text>
  </view>
  <view class="checkin-dots">
    <view class="checkin-dot {{index < checkInDays ? 'is-done' : ''}} {{!isCheckedIn && index === 0 ? 'is-today' : ''}}"
          wx:for="{{[0, 1, 2, 3, 4, 5, 6]}}" wx:key="index"></view>
  </view>
  <view class="checkin-btn {{(isCheckedIn || !isLoggedIn) ? 'is-mute' : ''}}">
    <text>{{isCheckedIn ? '已完成' : (isLoggedIn ? '签到' : '登录')}}</text>
  </view>
</view>

  <!-- 创作工具 -->
  <view class="section" wx:if="{{toolsList.length > 0}}">
    <view class="section-head">
      <view class="section-left">
        <view class="section-bar"></view>
        <text class="section-title">创作工具</text>
      </view>
      <text class="section-note">按使用热度排序</text>
    </view>

    <view class="tool-grid">
      <block wx:for="{{toolsList}}" wx:key="id">

        <!-- 主推工具（整行大卡） -->
        <view
          wx:if="{{item.variant === 'featured'}}"
          class="tool-card tool-featured"
          data-tool="{{item}}"
          bindtap="onToolTap"
        >
          <view class="tool-ic tool-ic--ghost">
            <image wx:if="{{item.icon}}" class="tool-ic-img" src="{{item.icon}}" mode="aspectFit"></image>
            <text wx:else class="tool-ic-txt">{{item.initial}}</text>
          </view>
          <view class="tool-copy">
            <text class="tool-name">{{item.title}}</text>
            <text class="tool-desc" wx:if="{{item.desc}}">{{item.desc}}</text>
          </view>
          <text class="tool-arrow">›</text>
        </view>

        <!-- 辣度值数据卡 -->
        <view
          wx:elif="{{item.variant === 'stat'}}"
          class="tool-card tool-stat"
          data-tool="{{item}}"
          bindtap="onToolTap"
        >
          <view class="stat-ic">
            <image wx:if="{{item.icon}}" class="tool-ic-img" src="{{item.icon}}" mode="aspectFit"></image>
            <text wx:else class="tool-ic-txt">{{item.initial}}</text>
          </view>
          <view class="tool-copy">
            <view class="stat-line">
              <text class="stat-value">{{pointsText}}</text>
              <text class="stat-unit">辣度值</text>
            </view>
            <text class="tool-desc">{{isLoggedIn ? '连续签到可加速累积' : '登录后可查看辣度值'}}</text>
          </view>
          <text class="stat-action">去兑换</text>
        </view>

        <!-- 整行宽卡 -->
        <view
          wx:elif="{{item.variant === 'wide'}}"
          class="tool-card tool-wide {{item.color === 'primary' ? 'is-fill' : ''}}"
          data-tool="{{item}}"
          bindtap="onToolTap"
        >
          <view class="tool-ic {{item.color === 'primary' ? 'tool-ic--ghost' : 'tool-ic--' + (item.color || 'primary')}}">
            <image wx:if="{{item.icon}}" class="tool-ic-img" src="{{item.icon}}" mode="aspectFit"></image>
            <text wx:else class="tool-ic-txt">{{item.initial}}</text>
          </view>
          <view class="tool-copy">
            <text class="tool-name">{{item.title}}</text>
            <text class="tool-desc" wx:if="{{item.desc}}">{{item.desc}}</text>
          </view>
          <text class="tool-arrow">›</text>
        </view>

        <!-- 半宽方卡 -->
        <view
          wx:else
          class="tool-card tool-square"
          data-tool="{{item}}"
          bindtap="onToolTap"
        >
          <view class="tool-ic tool-ic--{{item.color || 'primary'}}">
            <image wx:if="{{item.icon}}" class="tool-ic-img" src="{{item.icon}}" mode="aspectFit"></image>
            <text wx:else class="tool-ic-txt">{{item.initial}}</text>
          </view>
          <view class="tool-copy">
            <text class="tool-name">{{item.title}}</text>
            <text class="tool-desc" wx:if="{{item.desc}}">{{item.desc}}</text>
          </view>
        </view>

      </block>
    </view>
  </view>

  <!-- 中部广告位 -->
  <ad-unit position="middle" custom-class="native-video-mid-ad" page-path="/pages/tools/tools"></ad-unit>
</view>
