/* 导入统一骨架屏样式 */
@import '../../components/skeleton.wxss';

/* ====== 页面配色对齐 app.wxss 全局令牌 ====== */
page {
  --ring-track: #e6f6ee;
  --tint-green: rgba(7, 193, 96, 0.10);
  --tint-purple: rgba(139, 92, 246, 0.12);
  --tint-amber: rgba(245, 158, 11, 0.14);
  --tint-pink: rgba(236, 72, 153, 0.12);
  --solid-green-1: #07C160;
  --solid-green-2: #049C4F;
}

/* ====== 毛玻璃导航栏（与专题页一致） ====== */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background: linear-gradient(135deg, rgba(255,255,255,0.90) 0%, rgba(240,253,244,0.85) 55%, rgba(220,252,231,0.80) 100%);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  box-shadow: 0 1rpx 0 rgba(7, 193, 96, 0.10);
  box-sizing: border-box;
}

.nav-bar {
  height: 44px;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.nav-title {
  color: var(--text-main);
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: -0.01em;
}

.nav-count {
  font-size: 24rpx;
  color: var(--text-sub);
}

.nav-holder {
  width: 100%;
}

/* ====== 容器 ====== */
.container {
  padding: 24rpx 24rpx 48rpx;
  min-height: 100vh;
  box-sizing: border-box;
  position: relative;
}

/* 顶部极淡的品牌色氛围 */
.container::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 360rpx;
  background: linear-gradient(to bottom, rgba(7, 193, 96, 0.05), transparent);
  z-index: -1;
  pointer-events: none;
}

/* ====== 每日签到卡片 ====== */
/* ============================================================
   每日签到 —— 压缩为一行（2026-10-10）
   ------------------------------------------------------------
   改版原因：原来是 340rpx 的大卡（tag + 标题 + 描述 + 火苗 + conic 进度环
   + 双行进度文案 + 88rpx 按钮 + 奖励胶囊 = 7 层信息），占了工具页首屏近一半，
   用户进来第一眼看到的是运营活动而不是工具。
   借鉴壁纸二 2026-10-06 的同款教训与解法。

   压缩时必须保留的 4 个要点：
     ① 奖励数字不能丢 —— 压成小按钮后要移进文案行，否则失去点击动机
     ② 已签到用降饱和（--plate-bg）表达「这是状态」而不是「召唤」
     ③ 今天待签用实心小点，视觉上「等你点」
     ④ 未登录/已签到时按钮降描边态，避免与页内其他实心按钮抢注意力
   ============================================================ */
.checkin {
  display: flex;
  align-items: center;
  margin: 0 0 28rpx;
  padding: 22rpx 24rpx;
  border-radius: var(--r-md);
  background: var(--card-bg);
  border: 1rpx solid var(--border-color);
  transition: transform 0.2s ease;
}

.checkin:active {
  transform: scale(0.985);
}

/* 已签到 → 降饱和 */
.checkin.is-checked {
  background: var(--plate-bg);
  border-color: transparent;
}

.checkin-left {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.checkin-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

/* 奖励数字移进这一行 —— 压缩后保住点击动机 */
.checkin-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-sub);
}

.checkin-dots {
  display: flex;
  align-items: center;
  margin: 0 20rpx;
}

.checkin-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin: 0 4rpx;
  background: var(--border-color);
}

/* 今天待签 → 实心品牌绿，视觉上等你点 */
.checkin-dot.is-today {
  width: 14rpx;
  height: 14rpx;
  background: var(--primary-color);
}

.checkin-dot.is-done {
  background: var(--primary-color);
}

.checkin-btn {
  flex-shrink: 0;
  min-width: 104rpx;
  height: 56rpx;
  line-height: 54rpx;
  text-align: center;
  border-radius: 999rpx;
  background: var(--primary-color);
  color: var(--primary-ink, #fff);
  font-size: 24rpx;
  font-weight: 600;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.checkin-btn:active {
  opacity: 0.88;
}

/* 已完成 / 未登录 → 描边态 */
.checkin-btn.is-mute {
  background: transparent;
  border-color: var(--border-color);
  color: var(--text-sub);
}

/* ====== 分区标题 ====== */
.section {
  margin-bottom: 40rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 4rpx 20rpx;
}

.section-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.section-bar {
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: var(--primary-color);
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
}

.section-note {
  font-size: 23rpx;
  color: var(--text-sub);
}

/* ====== 工具网格 ====== */
.tool-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.tool-card {
  position: relative;
  box-sizing: border-box;
  transition: transform 0.2s ease;
}

.tool-card:active {
  transform: scale(0.975);
}

.tool-copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
  flex: 1;
}

.tool-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.25;
}

.tool-desc {
  font-size: 23rpx;
  color: var(--text-sub);
  line-height: 1.4;
}

.tool-arrow {
  font-size: 42rpx;
  line-height: 1;
  font-weight: 300;
  color: var(--text-sub);
  flex-shrink: 0;
}

/* 图标盒（默认浅绿底，后台配了未知 color 值也不会变成无底色的「隐形图标」） */
.tool-ic {
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
  background: var(--tint-green);
}

/* 默认把任意颜色的图标统一染成品牌绿：白描边图标放浅底上会完全看不见 */
.tool-ic .tool-ic-img {
  filter: brightness(0) saturate(100%) invert(52%) sepia(85%) saturate(1700%) hue-rotate(100deg);
}

.tool-ic-img {
  width: 46rpx;
  height: 46rpx;
}

/* 默认品牌绿（浅底可见）；实心绿图标盒内的文字再覆盖为白色 */
.tool-ic-txt {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--primary-color);
}

.tool-ic--ghost .tool-ic-txt {
  color: #fff;
}

.tool-ic--tertiary .tool-ic-txt {
  color: #7C3AED;
}

.tool-ic--quaternary .tool-ic-txt {
  color: #D97706;
}

.tool-ic--store .tool-ic-txt {
  color: #DB2777;
}

/* 自带彩色填充的图标（紫/橙/粉）保持本色，不参与染色 */
.tool-ic--tertiary {
  background: var(--tint-purple);
}

.tool-ic--tertiary .tool-ic-img,
.tool-ic--quaternary .tool-ic-img,
.tool-ic--store .tool-ic-img {
  filter: none;
}

.tool-ic--quaternary {
  background: var(--tint-amber);
}

.tool-ic--store {
  background: var(--tint-pink);
}

/* 主推卡上的图标盒：整页唯一的实心品牌色块，用来收住视觉焦点 */
.tool-ic--ghost {
  background: linear-gradient(135deg, var(--solid-green-1) 0%, var(--solid-green-2) 100%);
}

.tool-ic--ghost .tool-ic-img {
  /* 白色图标叠加轻微投影，提升辨识度 */
  filter: drop-shadow(0 1rpx 2rpx rgba(0, 0, 0, 0.16));
}

/* ---------- 主推大卡 ---------- */
.tool-featured {
  grid-column: span 2;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, var(--card-bg) 0%, var(--tint-green) 100%);
  border: 1rpx solid rgba(7, 193, 96, 0.28);
  box-shadow: 0 8rpx 22rpx rgba(7, 193, 96, 0.10);
}

.tool-featured .tool-arrow {
  color: rgba(7, 193, 96, 0.55);
}

/* ---------- 整行宽卡 ---------- */
.tool-wide {
  grid-column: span 2;
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 24rpx 26rpx;
  border-radius: 28rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--border-color);
  box-shadow: 0 6rpx 18rpx var(--shadow-color);
}

/* primary 宽卡：与主推卡同一套「浅底 + 绿描边 + 实心绿图标」，不再铺满绿 */
.tool-wide.is-fill {
  background: linear-gradient(135deg, var(--card-bg) 0%, var(--tint-green) 100%);
  border-color: rgba(7, 193, 96, 0.28);
  box-shadow: 0 8rpx 22rpx rgba(7, 193, 96, 0.10);
}

.tool-wide.is-fill .tool-arrow {
  color: rgba(7, 193, 96, 0.55);
}

/* ---------- 半宽方卡 ---------- */
.tool-square {
  grid-column: span 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 18rpx;
  padding: 26rpx 24rpx 28rpx;
  min-height: 224rpx;
  border-radius: 28rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--border-color);
  box-shadow: 0 6rpx 18rpx var(--shadow-color);
}

/* ---------- 辣度值数据卡 ---------- */
.tool-stat {
  grid-column: span 2;
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 24rpx 26rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #f4fcf8 0%, #e9f8f0 100%);
  border: 1rpx solid rgba(7, 193, 96, 0.14);
}

.stat-ic {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.12);
}

.stat-ic .tool-ic-img {
  width: 40rpx;
  height: 40rpx;
  /* 辣度值金币图标自带金色，保持本色，不走品牌绿染色 */
  filter: none;
}

.stat-ic .tool-ic-txt {
  color: var(--primary-color);
}

.stat-line {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.stat-value {
  font-size: 42rpx;
  font-weight: 800;
  color: var(--text-main);
  letter-spacing: -0.02em;
  line-height: 1.1;
}

.stat-unit {
  font-size: 23rpx;
  font-weight: 600;
  color: var(--primary-color);
}

.stat-action {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--primary-color);
  flex-shrink: 0;
}

/* ====== 深色模式 ====== */
@media (prefers-color-scheme: dark) {
  page {
    --tint-purple: rgba(139, 92, 246, 0.22);
    --tint-amber: rgba(245, 158, 11, 0.22);
    --tint-pink: rgba(236, 72, 153, 0.22);
  }

  .custom-nav {
    background: rgba(18, 18, 18, 0.85);
    box-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.08);
  }

  .nav-title {
    color: var(--text-main);
  }

  .container::before {
    background: linear-gradient(to bottom, rgba(16, 185, 129, 0.10), transparent);
  }

  /* 签到条配色已走 tokens 的 --card-bg / --plate-bg，暗色自动跟随，
     这里只需覆盖 border（浅色态是描边、已签到态是透明）*/
  .checkin {
    border-color: rgba(255, 255, 255, 0.06);
  }

  .checkin.is-checked {
    border-color: transparent;
  }

  .tool-featured,
  .tool-wide.is-fill {
    background: linear-gradient(135deg, var(--card-bg) 0%, rgba(16, 185, 129, 0.14) 100%);
    border-color: rgba(16, 185, 129, 0.30);
  }

  .tool-stat {
    background: linear-gradient(135deg, #1c2a22 0%, #17251d 100%);
    border-color: rgba(255, 255, 255, 0.06);
  }

  .stat-ic {
    background: rgba(255, 255, 255, 0.06);
    box-shadow: none;
  }
}
