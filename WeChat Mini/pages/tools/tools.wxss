/* 导入统一骨架屏样式 */
@import '../../components/skeleton.wxss';

/* ====== 页面配色对齐 app.wxss 全局令牌 ====== */
page {
  --ring-track: #e6f6ee;
  --tint-green: rgba(7, 193, 96, 0.10);
  --tint-purple: rgba(139, 92, 246, 0.12);
  --tint-amber: rgba(245, 158, 11, 0.14);
  --tint-pink: rgba(236, 72, 153, 0.12);
  --solid-green-1: #07C160;
  --solid-green-2: #049C4F;
}

/* ====== 毛玻璃导航栏（与专题页一致） ====== */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background: linear-gradient(135deg, rgba(255,255,255,0.90) 0%, rgba(240,253,244,0.85) 55%, rgba(220,252,231,0.80) 100%);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  box-shadow: 0 1rpx 0 rgba(7, 193, 96, 0.10);
  box-sizing: border-box;
}

.nav-bar {
  height: 44px;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.nav-title {
  color: var(--text-main);
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: -0.01em;
}

.nav-count {
  font-size: 24rpx;
  color: var(--text-sub);
}

.nav-holder {
  width: 100%;
}

/* ====== 容器 ====== */
.container {
  padding: 24rpx 24rpx 48rpx;
  min-height: 100vh;
  box-sizing: border-box;
  position: relative;
}

/* 顶部极淡的品牌色氛围 */
.container::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 360rpx;
  background: linear-gradient(to bottom, rgba(7, 193, 96, 0.05), transparent);
  z-index: -1;
  pointer-events: none;
}

/* ====== 每日签到卡片 ====== */
.checkin {
  position: relative;
  width: 100%;
  padding: 32rpx 30rpx 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(160deg, #ffffff 0%, #f3fbf6 100%);
  border: 1rpx solid rgba(7, 193, 96, 0.12);
  box-shadow: 0 10rpx 28rpx var(--shadow-color);
  box-sizing: border-box;
  margin-bottom: 36rpx;
  transition: transform 0.2s ease;
}

.checkin:active {
  transform: scale(0.99);
}

.checkin-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.checkin-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.checkin-tag {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--primary-color);
  letter-spacing: 0.06em;
  margin-bottom: 10rpx;
}

.checkin-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.2;
  letter-spacing: -0.01em;
}

.checkin-desc {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 10rpx;
  line-height: 1.4;
}

/* 右侧品牌色徽章（浅绿底 + 品牌绿火焰，避免大面积实心色块抢主视觉） */
.checkin-badge {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: var(--tint-green);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.checkin.is-checked .checkin-badge {
  background: rgba(148, 163, 184, 0.14);
}

.flame {
  width: 48rpx;
  height: 48rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2307C160' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z'/></svg>");
}

.checkin.is-checked .flame {
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2394a3b8' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z'/></svg>");
}

/* 进度环 */
.checkin-progress {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin: 32rpx 0 28rpx;
  padding: 0 4rpx;
}

.ring {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--ring-track);
  background-image: conic-gradient(var(--primary-color) 0 var(--p, 0%), var(--ring-track) var(--p, 0%) 100%);
}

.ring-inner {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring-text {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-main);
  letter-spacing: -0.02em;
}

.progress-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.progress-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
}

.progress-sub {
  font-size: 23rpx;
  color: var(--text-sub);
  line-height: 1.4;
}

/* 签到按钮：描边式 CTA，绿色只做强调不铺底 */
.checkin-btn {
  height: 88rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(7, 193, 96, 0.12) 0%, rgba(7, 193, 96, 0.06) 100%);
  border: 2rpx solid rgba(7, 193, 96, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  box-sizing: border-box;
  transition: opacity 0.15s ease;
}

.checkin-btn:active {
  opacity: 0.75;
}

.btn-text {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--primary-color);
  letter-spacing: 0.02em;
}

.btn-pill {
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--solid-green-1) 0%, var(--solid-green-2) 100%);
}

.checkin-btn.is-mute {
  background: rgba(148, 163, 184, 0.10);
  border-color: var(--border-color);
}

.checkin-btn.is-mute .btn-text {
  color: var(--text-sub);
}

.checkin-btn.is-mute .btn-pill {
  background: var(--border-color);
  color: var(--text-sub);
}

/* ====== 分区标题 ====== */
.section {
  margin-bottom: 40rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 4rpx 20rpx;
}

.section-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.section-bar {
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: var(--primary-color);
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
}

.section-note {
  font-size: 23rpx;
  color: var(--text-sub);
}

/* ====== 工具网格 ====== */
.tool-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.tool-card {
  position: relative;
  box-sizing: border-box;
  transition: transform 0.2s ease;
}

.tool-card:active {
  transform: scale(0.975);
}

.tool-copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
  flex: 1;
}

.tool-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.25;
}

.tool-desc {
  font-size: 23rpx;
  color: var(--text-sub);
  line-height: 1.4;
}

.tool-arrow {
  font-size: 42rpx;
  line-height: 1;
  font-weight: 300;
  color: var(--text-sub);
  flex-shrink: 0;
}

/* 图标盒（默认浅绿底，后台配了未知 color 值也不会变成无底色的「隐形图标」） */
.tool-ic {
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
  background: var(--tint-green);
}

/* 默认把任意颜色的图标统一染成品牌绿：白描边图标放浅底上会完全看不见 */
.tool-ic .tool-ic-img {
  filter: brightness(0) saturate(100%) invert(52%) sepia(85%) saturate(1700%) hue-rotate(100deg);
}

.tool-ic-img {
  width: 46rpx;
  height: 46rpx;
}

/* 默认品牌绿（浅底可见）；实心绿图标盒内的文字再覆盖为白色 */
.tool-ic-txt {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--primary-color);
}

.tool-ic--ghost .tool-ic-txt {
  color: #fff;
}

.tool-ic--tertiary .tool-ic-txt {
  color: #7C3AED;
}

.tool-ic--quaternary .tool-ic-txt {
  color: #D97706;
}

.tool-ic--store .tool-ic-txt {
  color: #DB2777;
}

/* 自带彩色填充的图标（紫/橙/粉）保持本色，不参与染色 */
.tool-ic--tertiary {
  background: var(--tint-purple);
}

.tool-ic--tertiary .tool-ic-img,
.tool-ic--quaternary .tool-ic-img,
.tool-ic--store .tool-ic-img {
  filter: none;
}

.tool-ic--quaternary {
  background: var(--tint-amber);
}

.tool-ic--store {
  background: var(--tint-pink);
}

/* 主推卡上的图标盒：整页唯一的实心品牌色块，用来收住视觉焦点 */
.tool-ic--ghost {
  background: linear-gradient(135deg, var(--solid-green-1) 0%, var(--solid-green-2) 100%);
}

.tool-ic--ghost .tool-ic-img {
  /* 白色图标叠加轻微投影，提升辨识度 */
  filter: drop-shadow(0 1rpx 2rpx rgba(0, 0, 0, 0.16));
}

/* ---------- 主推大卡 ---------- */
.tool-featured {
  grid-column: span 2;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, var(--card-bg) 0%, var(--tint-green) 100%);
  border: 1rpx solid rgba(7, 193, 96, 0.28);
  box-shadow: 0 8rpx 22rpx rgba(7, 193, 96, 0.10);
}

.tool-featured .tool-arrow {
  color: rgba(7, 193, 96, 0.55);
}

/* ---------- 整行宽卡 ---------- */
.tool-wide {
  grid-column: span 2;
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 24rpx 26rpx;
  border-radius: 28rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--border-color);
  box-shadow: 0 6rpx 18rpx var(--shadow-color);
}

/* primary 宽卡：与主推卡同一套「浅底 + 绿描边 + 实心绿图标」，不再铺满绿 */
.tool-wide.is-fill {
  background: linear-gradient(135deg, var(--card-bg) 0%, var(--tint-green) 100%);
  border-color: rgba(7, 193, 96, 0.28);
  box-shadow: 0 8rpx 22rpx rgba(7, 193, 96, 0.10);
}

.tool-wide.is-fill .tool-arrow {
  color: rgba(7, 193, 96, 0.55);
}

/* ---------- 半宽方卡 ---------- */
.tool-square {
  grid-column: span 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 18rpx;
  padding: 26rpx 24rpx 28rpx;
  min-height: 224rpx;
  border-radius: 28rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--border-color);
  box-shadow: 0 6rpx 18rpx var(--shadow-color);
}

/* ---------- 辣度值数据卡 ---------- */
.tool-stat {
  grid-column: span 2;
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 24rpx 26rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #f4fcf8 0%, #e9f8f0 100%);
  border: 1rpx solid rgba(7, 193, 96, 0.14);
}

.stat-ic {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.12);
}

.stat-ic .tool-ic-img {
  width: 40rpx;
  height: 40rpx;
  /* 辣度值金币图标自带金色，保持本色，不走品牌绿染色 */
  filter: none;
}

.stat-ic .tool-ic-txt {
  color: var(--primary-color);
}

.stat-line {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.stat-value {
  font-size: 42rpx;
  font-weight: 800;
  color: var(--text-main);
  letter-spacing: -0.02em;
  line-height: 1.1;
}

.stat-unit {
  font-size: 23rpx;
  font-weight: 600;
  color: var(--primary-color);
}

.stat-action {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--primary-color);
  flex-shrink: 0;
}

/* ====== 深色模式 ====== */
@media (prefers-color-scheme: dark) {
  page {
    --ring-track: #2b3a33;
    --tint-purple: rgba(139, 92, 246, 0.22);
    --tint-amber: rgba(245, 158, 11, 0.22);
    --tint-pink: rgba(236, 72, 153, 0.22);
  }

  .custom-nav {
    background: rgba(18, 18, 18, 0.85);
    box-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.08);
  }

  .nav-title {
    color: var(--text-main);
  }

  .container::before {
    background: linear-gradient(to bottom, rgba(16, 185, 129, 0.10), transparent);
  }

  .checkin {
    background: linear-gradient(160deg, #1f2937 0%, #1a2a22 100%);
    border-color: rgba(255, 255, 255, 0.06);
  }

  .checkin.is-checked .checkin-badge {
    background: rgba(148, 163, 184, 0.14);
  }

  .checkin-badge {
    background: rgba(16, 185, 129, 0.16);
  }

  .tool-featured,
  .tool-wide.is-fill {
    background: linear-gradient(135deg, var(--card-bg) 0%, rgba(16, 185, 129, 0.14) 100%);
    border-color: rgba(16, 185, 129, 0.30);
  }

  .ring-inner {
    background: var(--card-bg);
  }

  .tool-stat {
    background: linear-gradient(135deg, #1c2a22 0%, #17251d 100%);
    border-color: rgba(255, 255, 255, 0.06);
  }

  .stat-ic {
    background: rgba(255, 255, 255, 0.06);
    box-shadow: none;
  }
}
