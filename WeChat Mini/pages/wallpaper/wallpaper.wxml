<view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-bar">
    <text class="nav-title">壁纸</text>
  </view>
</view>
<view class="nav-holder" style="height: {{statusBarHeight + navBarHeight - 1}}px;"></view>

<view class="container">
  <!-- 搜索框 -->
  <view class="search-container" style="top: {{statusBarHeight + navBarHeight - 1}}px;">
    <view class="search-header" bindtap="navigateToSearch">
      <view class="search-input-container">
        <image class="search-icon-img" src="../../images/icon-search.png" mode="widthFix"></image>
        <text class="search-placeholder">请输入关键词搜索壁纸</text>
      </view>
    </view>
  </view>


  <!-- 标签导航（新版：横向滚动 + 展开按钮） -->
  <view class="category-wrapper">
    <scroll-view class="category-scroll" scroll-x enable-flex scroll-into-view="{{'tag-' + currentTag}}" scroll-with-animation>
      <view class="category-list">
        <view id="tag-all" class="category-item {{currentTag === 'all' ? 'active' : ''}}" 
              data-tag="all" 
              bindtap="onTagChange">
          全部
        </view>
        <view id="tag-{{item.id}}" class="category-item {{currentTag === item.id ? 'active' : ''}}" 
              wx:for="{{tagList}}" 
              wx:key="id"
              data-tag="{{item.id}}"
              bindtap="onTagChange">
          {{item.name}}
        </view>
        <!-- 占位符，防止最后一个被遮挡 -->
        <view style="width: 20rpx; flex-shrink: 0;"></view>
      </view>
    </scroll-view>
    
    <!-- 展开按钮 -->
    <view class="category-expand-btn" bindtap="openCategoryPanel">
      <view class="icon-menu">
        <view class="icon-menu-line"></view>
        <view class="icon-menu-line"></view>
        <view class="icon-menu-line"></view>
      </view>
    </view>
  </view>


  <!-- 排序按钮 -->
  <view class="sort-bar">
    <view class="sort-item {{sortType === 'hot' ? 'active' : ''}}" 
          data-type="hot" 
          bindtap="onSortChange">
      <image class="chip-icon" src="../../images/icon-fire.png" mode="widthFix"></image>
      <text>热门</text>
    </view>
    <view class="sort-item {{sortType === 'latest' ? 'active' : ''}}" 
          data-type="latest" 
          bindtap="onSortChange">
      <image class="chip-icon" src="../../images/icon-clock.png" mode="widthFix"></image>
      <text>最新</text>
    </view>
  </view>

  <!-- 🔥 动态板块渲染模式 -->
  <block wx:if="{{isSectionMode && sections.length > 0}}">
    <view class="section-block" wx:for="{{sections}}" wx:key="_id">
      <!-- 板块标题 -->
      <view class="section-header" wx:if="{{item.title}}">
        <text class="section-title">{{item.title}}</text>
        <view class="section-more" bindtap="onSectionMore" data-section="{{item}}" wx:if="{{item.moreLink || item.queryConfig}}">
          <text>更多</text>
          <view class="arrow-right"></view>
        </view>
      </view>

      <!-- 网格布局 -->
      <view class="wallpaper-grid" wx:if="{{item.type === 'grid'}}">
        <view class="wallpaper-grid-item" wx:for="{{item.items}}" wx:for-item="subItem" wx:key="id" bindtap="previewImage" 
              data-url="{{subItem.url}}" 
              data-original-url="{{subItem.originalUrl}}" 
              data-categories="{{subItem.categories}}" 
              data-tags="{{subItem.tags}}">
          <image class="wallpaper-img" src="{{subItem.url}}" mode="aspectFill" lazy-load></image>
        </view>
      </view>

      <!-- 瀑布流布局 -->
      <view class="waterfall-container" wx:elif="{{item.type === 'waterfall'}}">
        <view class="waterfall-column">
          <view class="waterfall-item" wx:for="{{item.leftColumn}}" wx:for-item="subItem" wx:key="id" bindtap="previewImage"
                data-url="{{subItem.url}}" 
                data-original-url="{{subItem.originalUrl}}">
            <image class="waterfall-img" src="{{subItem.url}}" mode="widthFix" lazy-load></image>
          </view>
        </view>
        <view class="waterfall-column">
          <view class="waterfall-item" wx:for="{{item.rightColumn}}" wx:for-item="subItem" wx:key="id" bindtap="previewImage"
                data-url="{{subItem.url}}" 
                data-original-url="{{subItem.originalUrl}}">
            <image class="waterfall-img" src="{{subItem.url}}" mode="widthFix" lazy-load></image>
          </view>
        </view>
      </view>

      <!-- 横向滚动布局 -->
      <scroll-view class="section-swiper" scroll-x enable-flex wx:elif="{{item.type === 'swiper'}}">
        <view class="swiper-item" wx:for="{{item.items}}" wx:for-item="subItem" wx:key="id" bindtap="previewImage"
              data-url="{{subItem.url}}" 
              data-original-url="{{subItem.originalUrl}}">
          <image class="swiper-img" src="{{subItem.url}}" mode="aspectFill" lazy-load></image>
        </view>
      </scroll-view>
    </view>
  </block>

  <!-- 标签筛选合并到分类，隐藏原标签栏 -->

  <!-- 骨架屏 -->
  <view class="skeleton-grid" wx:if="{{loading && wallpapers.length === 0}}">
    <view class="skeleton-card" wx:for="{{skeletons}}" wx:key="index">
      <view class="skeleton-img shimmer"></view>
      <view class="skeleton-text shimmer"></view>
      <view class="skeleton-tags">
        <view class="skeleton-tag shimmer"></view>
        <view class="skeleton-tag shimmer"></view>
      </view>
    </view>
  </view>

  <!-- 空态 -->
  <view class="empty" wx:if="{{!loading && wallpapers.length === 0}}">
    <view class="empty-icon"></view>
    <text class="empty-title">暂无壁纸</text>
    <text class="empty-desc">试试更换分类或下拉刷新</text>
    <button class="primary-btn" size="mini" bindtap="handleRetry">重新加载</button>
  </view>

  <!-- 壁纸瀑布流 - 固定2列 -->
  <view class="wallpaper-container" wx:if="{{wallpapers.length > 0}}">
    <waterfall list="{{wallpapers}}" type="wallpaper" layoutMode="fixed" bind:itemtap="onWaterfallItemTap" />
  </view>





  <!-- 加载提示 -->
  <view class="loading" wx:if="{{loading && wallpapers.length > 0}}">
    <text>加载中...</text>
  </view>
  
  <view class="no-more" wx:if="{{!hasMore && wallpapers.length > 0}}">
    <text>没有更多了</text>
  </view>

  <!-- 回到顶部按钮 -->
  <view class="back-to-top {{showBackToTop ? 'show' : ''}}" bindtap="scrollToTop">
    <view class="arrow-up"></view>
  </view>
</view>

<!-- 分类弹窗 -->
<view class="category-mask" wx:if="{{showCategoryPanel}}" bindtap="closeCategoryPanel">
  <view class="category-panel" catchtap="noop">
    <view class="category-header">
      <text class="category-title">全部分类</text>
      <view class="category-close" bindtap="closeCategoryPanel">关闭</view>
    </view>
    <scroll-view scroll-y class="category-panel-list">
      <view class="category-grid-container">
        <view class="category-grid-item {{currentTag === 'all' ? 'active' : ''}}" 
              data-tag="all" 
              bindtap="onTagChange">
          全部
        </view>
        <view class="category-grid-item {{currentTag === item.id ? 'active' : ''}}" 
              wx:for="{{tagList}}" 
              wx:key="id"
              data-tag="{{item.id}}"
              bindtap="onTagChange">
          {{item.name}}
        </view>
      </view>
    </scroll-view>
  </view>
</view>