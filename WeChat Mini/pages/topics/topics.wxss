page {
  background: #f7f8fa;
}

/* ====== 毛玻璃导航栏 ====== */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background: linear-gradient(135deg, rgba(255,255,255,0.90) 0%, rgba(240,253,244,0.85) 55%, rgba(220,252,231,0.80) 100%);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  box-shadow: 0 1rpx 0 rgba(34, 197, 94, 0.08);
  box-sizing: border-box;
}

.nav-bar {
  position: relative;
  height: 44px;
  min-height: 44px;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.nav-title {
  color: #1f2a44;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: -0.01em;
  white-space: nowrap;
}

/* 搜索图标按钮（紧贴胶囊按钮左侧） */
.nav-icon-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.nav-search-btn {
  right: 10px;
}

.nav-icon-img {
  width: 42rpx;
  height: 42rpx;
}

.nav-holder {
  width: 100%;
}

/* ====== 容器 ====== */
.container {
  padding: 24rpx 24rpx 48rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ====== 1. Hero 精选轮播 ====== */
.hero-swiper {
  height: 280rpx;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
}

.hero-card {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
  overflow: hidden;
}

.hero-image {
  width: 100%;
  height: 100%;
  display: block;
}

.hero-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  top: 0;
  background: linear-gradient(135deg, rgba(0, 0, 0, 0.3) 0%, rgba(0, 0, 0, 0.65) 100%);
}

.hero-content {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 28rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.hero-badge {
  align-self: flex-start;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.95);
  color: #1f2a44;
  font-size: 22rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.hero-title {
  font-size: 42rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.4);
}

.hero-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
}

.hero-cta-text {
  font-size: 24rpx;
  font-weight: 500;
}

.hero-cta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  align-self: flex-start;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
}

.hero-arrow {
  font-size: 26rpx;
}

/* ===== 低端机降级：blur → 纯色（避免低端机每帧 GPU 采样掉帧） ===== */
.hero-cta.low-end {
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
  background: rgba(255, 255, 255, 0.45);
}

.tag-item.low-end {
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
  background: rgba(255, 255, 255, 0.95);
}

/* ===== 2. 标签筛选栏 ===== */
.tag-bar {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.tag-list {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx 0;
}

.tag-item {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  font-size: 26rpx;
  color: #475569;
  font-weight: 500;
  flex-shrink: 0;
  border: 1rpx solid rgba(34, 197, 94, 0.15);
  transition: all 0.25s ease;
}

.tag-item.active {
  background: linear-gradient(135deg, #ffffff 0%, #dcfce7 100%);
  color: #15803d;
  border-color: rgba(34, 197, 94, 0.4);
  box-shadow: 0 4rpx 14rpx rgba(34, 197, 94, 0.2);
  font-weight: 600;
}

/* ====== 3. 专题网格（列数后台可配 1~4） ====== */
.topic-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 24rpx 0;
}

/* 列数宽度控制：通过外层 class 控制 .topic-card 宽度 */
.topic-grid-1 .topic-card { width: 100%; }
.topic-grid-2 .topic-card { width: 48.5%; }
.topic-grid-3 .topic-card { width: 32%; }
.topic-grid-4 .topic-card { width: 23.5%; }

.topic-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.15s ease;
}

.card-hover {
  transform: scale(0.97);
}

.card-cover-wrap {
  width: 100%;
  /* 统一封面比例 16:9，横向更宽更电影感 */
  aspect-ratio: 16 / 9;
  background: #f1f5f9;
  position: relative;
  overflow: hidden;
}

.card-cover {
  width: 100%;
  height: 100%;
  display: block;
}

/* 渐变遮罩：底部深色渐变，保证标题文字在任意封面上的可读性 */
.card-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  top: 0;
  background: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 0) 40%,
    rgba(0, 0, 0, 0.35) 70%,
    rgba(0, 0, 0, 0.75) 100%
  );
  pointer-events: none;
}

.card-badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #fff;
  line-height: 1.6;
  z-index: 2;
}

.badge-hot {
  background: linear-gradient(135deg, #ff69b4, #ff1493);
}

.badge-new {
  background: linear-gradient(135deg, #ff69b4, #ff85c1);
}

.badge-limited {
  background: linear-gradient(135deg, #ff69b4, #c71585);
}

/* 标题信息叠加在封面底部（绝对定位） */
.card-info {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 22rpx 22rpx;
  z-index: 2;
}

.card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.5);
}

.card-meta {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 6rpx;
}

.meta-icon {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.meta-count {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* ====== 骨架屏 ====== */
.skeleton-hero {
  width: 100%;
  height: 280rpx;
  border-radius: 24rpx;
  margin-bottom: 32rpx;
}

.skeleton-tags {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.skeleton-tag {
  width: 120rpx;
  height: 56rpx;
  border-radius: 999rpx;
}

.skeleton-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 24rpx 0;
}

.skeleton-card {
  width: 48.5%;
  aspect-ratio: 16 / 9;
  border-radius: 20rpx;
}

.shimmer {
  background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s infinite;
}

@keyframes skeleton-loading {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ====== 状态 ====== */
.empty {
  text-align: center;
  padding: 160rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.empty-title {
  font-size: 32rpx;
  color: #64748b;
  font-weight: 500;
}

.empty-desc {
  font-size: 26rpx;
  color: #94a3b8;
}

.empty-filter {
  text-align: center;
  padding: 80rpx 40rpx;
  color: #94a3b8;
  font-size: 26rpx;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 48rpx;
  color: #94a3b8;
  font-size: 26rpx;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #e2e8f0;
  border-top-color: #1f2a44;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.no-more {
  text-align: center;
  padding: 32rpx;
  color: #94a3b8;
  font-size: 24rpx;
}

/* ====== 深色模式 ====== */
@media (prefers-color-scheme: dark) {
  page {
    background: #121212;
  }

  .custom-nav {
    background: linear-gradient(135deg, rgba(18,18,18,0.90) 0%, rgba(20,40,28,0.85) 55%, rgba(15,50,30,0.80) 100%);
    box-shadow: 0 1rpx 0 rgba(34, 197, 94, 0.12);
  }

  .nav-title {
    color: #f3f4f6;
  }

  /* 暗色模式下导航栏图标反色 */
  .nav-icon-btn .nav-icon-img {
    filter: invert(1);
  }

  .tag-item {
    background: rgba(31, 41, 55, 0.7);
    color: #9ca3af;
    border-color: rgba(34, 197, 94, 0.2);
  }

  .tag-item.active {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.15) 0%, rgba(34, 197, 94, 0.35) 100%);
    color: #86efac;
    border-color: rgba(34, 197, 94, 0.5);
    box-shadow: 0 4rpx 14rpx rgba(34, 197, 94, 0.3);
  }

  .topic-card {
    background: #1f2937;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
  }

  .card-cover-wrap {
    background: #374151;
  }

  /* 标题叠加在封面上，深色模式下保持白色文字 + 渐变遮罩即可，无需改色 */

  .shimmer {
    background: linear-gradient(90deg, #374151 25%, #4b5563 50%, #374151 75%);
    background-size: 200% 100%;
  }

  .empty-title {
    color: #9ca3af;
  }

  .empty-desc {
    color: #6b7280;
  }

  .empty-filter {
    color: #6b7280;
  }

  .loading,
  .no-more {
    color: #6b7280;
  }

  .loading-spinner {
    border-color: #374151;
    border-top-color: #f3f4f6;
  }
}
