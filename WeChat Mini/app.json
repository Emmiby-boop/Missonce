      "packages": ["subpackages"]
    },
    "pages/tools/tools": {
      "network": "wifi",
      "packages": ["subpackages"]
    },
    "pages/profile/profile": {
      "network": "wifi",
      "packages": ["subpackages"]
    }
  },
  
  "cloud": true,
  "darkmode": true,
  "themeLocation": "config/theme.json",

  "window": {
