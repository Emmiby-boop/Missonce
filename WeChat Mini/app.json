      {
        "pagePath": "pages/topics/topics",
        "text": "专题",
        "iconPath": "images/topic.png",
        "selectedIconPath": "images/topic-active.png"
      },
      {
        "pagePath": "pages/tools/tools",
        "text": "工具",
        "iconPath": "images/tools.png",
