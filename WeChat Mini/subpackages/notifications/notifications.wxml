<!-- 自定义导航栏：毛玻璃磨砂效果 -->
<view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-bar" style="height: {{navBarHeight}}px;">
    <view class="nav-back-btn" bindtap="onBack">
      <text class="nav-back-icon">‹</text>
    </view>
    <text class="nav-title">消息中心</text>
  </view>
</view>
<view class="nav-holder" style="height: {{statusBarHeight + navBarHeight}}px;"></view>

<view class="container">
  <view class="action-bar" wx:if="{{notifications.length > 0}}">
    <view class="action-btn" bindtap="markAllAsRead">
      <text class="action-btn-text">全部已读</text>
    </view>
  </view>

  <view class="content">
    <view wx:if="{{loading}}" class="loading-container">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>

    <view wx:elif="{{error}}" class="error-container">
      <text class="error-icon">😔</text>
      <text class="error-text">{{error}}</text>
      <view class="retry-btn" bindtap="retry">
        <text>重新加载</text>
      </view>
    </view>

    <view wx:elif="{{notifications.length === 0}}" class="empty-container">
      <text class="empty-icon">📭</text>
      <text class="empty-text">暂无消息</text>
    </view>

    <view wx:else class="notification-list">
      <view
        class="notification-item {{readIds.includes(item._id) ? 'read' : ''}}"
        wx:for="{{notifications}}"
        wx:key="_id"
        bindtap="handleNotificationTap"
        data-item="{{item}}"
      >
        <view class="notification-icon">{{getPriorityIcon(item.priority)}}</view>
        <view class="notification-content">
          <view class="notification-header">
            <text class="notification-type">{{getTypeText(item.type)}}</text>
            <text class="notification-time">{{formatDate(item.createdAt)}}</text>
          </view>
          <text class="notification-title">{{item.title}}</text>
          <text class="notification-desc" wx:if="{{item.summary || item.content}}">{{item.summary || item.content}}</text>
          <view class="notification-cover" wx:if="{{item.coverImage}}">
            <image src="{{item.coverUrl || item.coverImage}}" mode="aspectFill" class="cover-thumb" />
          </view>
        </view>
        <view class="notification-badge" wx:if="{{!readIds.includes(item._id)}}"></view>
      </view>
    </view>
  </view>
</view>

<view class="modal-overlay" wx:if="{{showModal}}" bindtap="closeModal">
  <view class="modal-content" catchtap="preventBubble">
    <view class="modal-header">
      <text class="modal-title">{{currentNotification.title}}</text>
      <view class="modal-close" bindtap="closeModal">
        <text class="modal-close-icon">×</text>
      </view>
    </view>
    <view class="modal-meta">
      <text class="modal-type">{{getTypeText(currentNotification.type)}}</text>
      <text class="modal-time">{{formatFullDate(currentNotification.createdAt)}}</text>
    </view>
    <view class="modal-body">
      <text class="modal-text">{{currentNotification.content}}</text>
    </view>
    <view class="modal-footer">
      <view class="modal-btn" bindtap="closeModal">
        <text>我已知晓</text>
      </view>
    </view>
  </view>
</view>
