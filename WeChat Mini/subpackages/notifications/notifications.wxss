.container {
  min-height: 100vh;
  background: var(--bg-color);
  padding-bottom: 40rpx;
}

/* 自定义导航栏：毛玻璃磨砂 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  box-shadow: 0 1rpx 0 rgba(0, 0, 0, 0.06);
}

.nav-bar {
  display: flex;
  align-items: center;
  position: relative;
  padding: 0 24rpx;
}

.nav-back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  font-size: 56rpx;
  color: var(--text-main);
  line-height: 1;
  font-weight: 300;
}

.nav-title {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-main);
}

.nav-holder {
  width: 100%;
}

/* 操作行：导航栏下方独立一行 */
.action-bar {
  display: flex;
  justify-content: flex-end;
  padding: 16rpx 24rpx 8rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 20rpx;
  background: rgba(7, 193, 96, 0.08);
  border-radius: 999rpx;
  transition: opacity 0.2s ease;
}

.action-btn:active {
  opacity: 0.7;
}

.action-btn-text {
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 500;
}

.content {
  padding: 20rpx 24rpx;
}

.loading-container,
.error-container,
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--border-color);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text,
.error-text,
.empty-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: var(--text-sub);
}

.error-icon,
.empty-icon {
  font-size: 100rpx;
}

.retry-btn {
  margin-top: 30rpx;
  padding: 16rpx 40rpx;
  background: var(--primary-color);
  color: #fff;
  font-size: 28rpx;
  border-radius: 999rpx;
}

.notification-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.notification-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 28rpx;
  background: var(--card-bg);
  border-radius: 20rpx;
  position: relative;
  transition: all 0.2s ease;
}

.notification-item:active {
  opacity: 0.8;
  transform: scale(0.99);
}

.notification-item.read {
  opacity: 0.6;
}

.notification-icon {
  font-size: 48rpx;
  flex-shrink: 0;
}

.notification-content {
  flex: 1;
  min-width: 0;
}

.notification-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.notification-type {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  background: var(--primary-color);
  color: #fff;
  border-radius: 999rpx;
}

.notification-time {
  font-size: 24rpx;
  color: var(--text-sub);
}

.notification-title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-main);
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.notification-desc {
  display: block;
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.notification-cover {
  margin-top: 16rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: var(--border-color);
}

.cover-thumb {
  width: 100%;
  height: 180rpx;
  display: block;
}

.notification-badge {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  width: 16rpx;
  height: 16rpx;
  background: #ff4757;
  border-radius: 50%;
}

@media (prefers-color-scheme: dark) {
  .custom-nav {
    background: rgba(18, 18, 18, 0.85);
    box-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.08);
  }

  .notification-item {
    background: #1f2937;
  }
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 40rpx;
}

.modal-content {
  width: 100%;
  max-width: 600rpx;
  background: var(--card-bg);
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 32rpx 32rpx 0;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-main);
  flex: 1;
  padding-right: 60rpx;
  line-height: 1.4;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.modal-close-icon {
  font-size: 48rpx;
  color: var(--text-sub);
  line-height: 1;
}

.modal-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 32rpx 0;
}

.modal-type {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  background: var(--primary-color);
  color: #fff;
  border-radius: 999rpx;
}

.modal-time {
  font-size: 24rpx;
  color: var(--text-sub);
}

.modal-body {
  padding: 32rpx;
}

.modal-text {
  display: block;
  font-size: 28rpx;
  color: var(--text-main);
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}

.modal-footer {
  padding: 0 32rpx 32rpx;
}

.modal-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  background: var(--primary-color);
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 16rpx;
}

.modal-btn:active {
  opacity: 0.9;
}
