/* subpackages/store/store.wxss */
.store-page {
  min-height: 100vh;
  background-color: #f7f7f7;
}

/* 加载状态 */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  font-size: 28rpx;
  color: #999;
}

.loading-text {
  padding: 40rpx;
}

/* 错误状态 */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 0 60rpx;
}

.error-icon {
  font-size: 80rpx;
  margin-bottom: 30rpx;
}

.error-text {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  margin-bottom: 40rpx;
}

.retry-btn {
  background-color: #ff6b35;
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 60rpx;
  border-radius: 40rpx;
  border: none;
  line-height: 1.5;
}

.retry-btn::after {
  border: none;
}

/* 商品卡片列表容器 */
.products-container {
  width: 100%;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

/* store-product 组件之间添加间距 */
.products-container store-product {
  display: block;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 0 60rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #aaa;
  text-align: center;
}
