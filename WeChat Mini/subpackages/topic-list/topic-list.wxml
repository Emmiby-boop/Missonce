<!-- 自定义导航栏（对应 navigationStyle: custom） -->
<view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-bar">
    <view class="nav-back" bindtap="navigateBack">
      <image class="back-icon" src="/images/preview-back.svg" mode="aspectFit" />
    </view>
    <text class="nav-title">精选专题</text>
    <view class="nav-placeholder"></view>
  </view>
</view>
<view class="nav-holder" style="height: {{statusBarHeight + navBarHeight - 1}}px;"></view>

<!-- 顶部悬浮广告 -->
<ad-unit position="top" custom-class="native-top-ad" page-path="/subpackages/topic-list/topic-list" threshold="200" ext-style="top: {{statusBarHeight + navBarHeight - 1}}px;"></ad-unit>

<view class="container">
  <ad-unit kind="interstitial" page-path="/subpackages/topic-list/topic-list"></ad-unit>
  <!-- Skeleton Loading -->
  <view class="skeleton-list" wx:if="{{loading && topics.length === 0}}">
    <view class="skeleton-item shimmer" wx:for="{{[1,2,3,4]}}" wx:key="*this"></view>
  </view>

  <!-- Topic List -->
  <view class="topic-list" wx:if="{{topics.length > 0}}">
    <view class="topic-item" 
          wx:for="{{topics}}" 
          wx:key="_id" 
          bindtap="onTopicTap" 
          data-id="{{item._id}}">
      <view class="topic-cover-box">
        <image class="topic-cover" src="{{item.coverUrl}}" mode="aspectFill" lazy-load webp></image>
        <view class="topic-mask"></view>
        <view class="topic-info">
          <view class="topic-title">{{item.title}}</view>
          <view class="topic-desc">{{item.description || '暂无简介'}}</view>
          <view class="topic-meta">
            <text class="topic-tag">{{item.filterType === 'tag' ? '#' : ''}}{{item.filterValue}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- Loading More / No More -->
  <view class="loading-more" wx:if="{{loading && topics.length > 0}}">正在加载更多...</view>
  <view class="no-more" wx:if="{{!hasMore && topics.length > 0}}">没有更多内容了</view>

  <!-- Empty State -->
  <view class="empty-state" wx:if="{{!loading && topics.length === 0}}">
    <image class="empty-icon" src="../../images/empty.png" mode="widthFix" wx:if="{{false}}"></image>
    <text>暂无专题内容</text>
  </view>
</view>
