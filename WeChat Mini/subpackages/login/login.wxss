.login-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background-color: #f8f8f8;
  padding: 40rpx;
  box-sizing: border-box;
}

.login-card {
  width: 100%;
  max-width: 600rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.08);
  padding: 60rpx 40rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 40rpx;
  border-radius: 50%;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.avatar-button {
  width: 100%;
  height: 100%;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1;
}

.avatar-button::after {
  border: none;
}

.avatar-button image {
  width: 100%;
  height: 100%;
  display: block;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 40rpx;
}

.nickname-wrapper {
  width: 100%;
  margin-bottom: 50rpx;
}

.nickname-input {
  width: 100%;
  height: 88rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #333;
  box-sizing: border-box;
}

.login-button {
  width: 100% !important;
  background-color: #07c160;
  color: white;
  font-size: 32rpx;
  font-weight: 500;
  padding: 24rpx 0;
  border-radius: 12rpx;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-button[disabled] {
  background-color: #a0e0b5 !important;
  color: #ffffff;
}

.button-content {
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading {
  margin-top: 30rpx;
  color: #888;
  font-size: 28rpx;
}

.error {
  margin-top: 30rpx;
  color: #fa5151;
  font-size: 26rpx;
  padding: 0 20rpx;
}

.login-button-hover {
  background-color: #06ad56 !important;
  opacity: 0.9;
}
