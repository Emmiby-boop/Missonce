/* 登录页专用样式，避免与 app.wxss 冲突 */
.login-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background-color: #f8f8f8;
  padding: 40rpx;
  box-sizing: border-box;
}

.login-card {
  width: 100%;
  max-width: 600rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.08);
  padding: 60rpx 40rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 40rpx;
  border-radius: 50%;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.logo image {
  width: 100%;
  height: 100%;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 60rpx;
}

.login-button {
  width: 100% !important;
  background-color: #07c160;
  color: white;
  font-size: 32rpx;
  font-weight: 500;
  padding: 24rpx 0;
  border-radius: 12rpx;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.button-content {
  display: flex;
  align-items: center;
  justify-content: center;
}

.wechat-logo {
  width: 48rpx;
  height: 48rpx;
  margin-right: 16rpx;
}

.loading {
  margin-top: 30rpx;
  color: #888;
  font-size: 28rpx;
}

.error {
  margin-top: 30rpx;
  color: #fa5151;
  font-size: 26rpx;
  padding: 0 20rpx;
}

.login-button-hover {
  background-color: #06ad56 !important;
  opacity: 0.9;
}
