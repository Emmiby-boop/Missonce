/* 自定义导航栏（对应 navigationStyle: custom） */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background: var(--primary-color);
  box-shadow: 0 6rpx 16rpx var(--shadow-color);
}
.nav-bar {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}
.nav-title {
  color: #fff;
  font-size: 32rpx;
  font-weight: 400;
}
.nav-back {
  width: 80rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}
.nav-placeholder {
  width: 80rpx;
  height: 100%;
}
.back-icon {
  width: 38rpx;
  height: 38rpx;
}
.nav-holder {
  width: 100%;
}

.container {
  min-height: 100vh;
  background: var(--bg-color);
  padding-bottom: 40rpx;
}

/* 专题头部 */
.topic-header {
  position: relative;
  width: 100%;
  height: 400rpx;
  overflow: hidden;
}

.topic-cover {
  width: 100%;
  height: 100%;
}

.topic-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(to bottom, rgba(0,0,0,0) 0%, rgba(0,0,0,0.6) 100%);
}

.topic-info {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 30rpx;
  box-sizing: border-box;
  color: #fff;
}

.topic-title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.3);
}

.topic-desc {
  font-size: 26rpx;
  opacity: 0.9;
  line-height: 1.4;
  text-shadow: 0 1rpx 2rpx rgba(0,0,0,0.3);
}

/* 列表内容 */
.content-body {
  padding: 0 20rpx;
  margin-top: -30rpx;
  position: relative;
  z-index: 1;
}

.grid-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.grid-item {
  position: relative;
  width: 100%;
  border-radius: 12rpx;
  overflow: hidden;
  background: var(--card-bg);
  box-shadow: 0 4rpx 12rpx var(--shadow-color);
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
  z-index: 1;
}

.grid-item:active {
  opacity: 0.85;
  transform: scale(0.97);
  transition: all 0.15s ease;
}

.grid-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* 状态提示 */
.loading-state, .empty-state, .no-more {
  padding: 40rpx 0;
  text-align: center;
  color: var(--text-sub);
  font-size: 26rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 100rpx;
}

/* 深色模式适配 */
@media (prefers-color-scheme: dark) {
  .custom-nav {
    background: #1f2937;
  }

  .grid-item {
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  }
}
