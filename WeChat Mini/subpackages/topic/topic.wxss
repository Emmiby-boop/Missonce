.container {
  min-height: 100vh;
  background: #f8f8f8;
  padding-bottom: 40rpx;
}

/* 专题头部 */
.topic-header {
  position: relative;
  width: 100%;
  height: 400rpx;
  overflow: hidden;
}

.topic-cover {
  width: 100%;
  height: 100%;
}

.topic-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(to bottom, rgba(0,0,0,0) 0%, rgba(0,0,0,0.6) 100%);
}

.topic-info {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 30rpx;
  box-sizing: border-box;
  color: #fff;
}

.topic-title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.3);
}

.topic-desc {
  font-size: 26rpx;
  opacity: 0.9;
  line-height: 1.4;
  text-shadow: 0 1rpx 2rpx rgba(0,0,0,0.3);
}

/* 列表内容 */
.content-body {
  padding: 0 20rpx;
  margin-top: -30rpx;
  position: relative;
  z-index: 1;
}

.grid-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.grid-item {
  position: relative;
  width: 100%;
  border-radius: 12rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
  z-index: 1;
}

.grid-item:active {
  opacity: 0.85;
  transform: scale(0.97);
  transition: all 0.15s ease;
}

.grid-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* 状态提示 */
.loading-state, .empty-state, .no-more {
  padding: 40rpx 0;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 100rpx;
}
