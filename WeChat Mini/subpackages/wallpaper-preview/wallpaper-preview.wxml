<view class="custom-nav" style="padding-top: {{statusBarHeight}}px;" wx:if="{{!showSimulation}}">
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">
      <image class="back-icon" src="{{iconBack}}" mode="aspectFit" />
    </view>
    <text class="nav-title">壁纸预览</text>
    <view class="nav-placeholder"></view>
  </view>
</view>

<!-- 登录弹窗 -->
<view class="login-modal-mask" wx:if="{{showLoginModal}}" bindtap="hideLoginModal">
  <view class="login-modal-content" catchtap="true">
    <view class="login-modal-title">请先登录</view>
    <view class="login-modal-desc">收藏和下载功能需要登录才能使用</view>
    <view class="login-modal-btns">
      <button class="login-btn cancel" bindtap="hideLoginModal">先不了</button>
      <button class="login-btn confirm" bindtap="handleLogin" loading="{{isLoginLoading}}" disabled="{{isLoginLoading}}">{{isLoginLoading ? '登录中...' : '去登录'}}</button>
    </view>
  </view>
</view>
<view class="nav-holder" style="height: {{statusBarHeight + navBarHeight}}px;"></view>

<view class="container {{theme}}">
  <!-- 主预览区域（原比例） -->
  <view class="hero-wrapper">

    <view class="hero-card">
      <swiper class="hero-swiper"
              current="{{currentIndex}}"
              bindchange="onSwiperChange"
              circular
              duration="300"
              bindtouchstart="onTouchStart"
              bindtouchend="onTouchEnd">

        <swiper-item wx:for="{{imageList}}" wx:key="index" wx:for-item="imageUrl" wx:for-index="index">
          <view class="hero-inner">
            <image class="hero-image {{loadedImages[index] ? 'show' : ''}}"
                   src="{{imageUrl}}"
                   mode="aspectFit"
                   lazy-load
                   show-menu-by-longpress
                   bindload="onImageLoad"
                   bindtap="onImageTap"
                   data-index="{{index}}" />

            <view class="img-loading" wx:if="{{!loadedImages[index]}}">
              <view class="skeleton shimmer"></view>
            </view>
          </view>
        </swiper-item>
      </swiper>
      <view class="page-indicator {{showPageIndicator ? 'show' : ''}}">
        <text>{{currentIndex + 1}}/{{imageList.length}}</text>
      </view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="nav-item" bindtap="goHome">
      <image class="nav-icon-img" src="{{iconHome}}" mode="aspectFit" />
      <text class="nav-text">首页</text>
    </view>
    <view class="nav-item" bindtap="toggleFavorite">
      <image class="nav-icon-img" src="{{isFavorite ? iconStarOn : iconStarOff}}" mode="aspectFit" />
      <text class="nav-text">收藏</text>
    </view>
    <view class="nav-item nav-center" bindtap="toggleSimulation">
      <image class="nav-icon-img" src="{{iconEdit}}" mode="aspectFit" />
      <text class="nav-text active">预览</text>
    </view>
    <view class="nav-item" bindtap="downloadImage">
      <image class="nav-icon-img" src="{{iconDownload}}" mode="aspectFit" />
      <text class="nav-text">下载</text>
    </view>
    <view class="nav-item" bindtap="showPoster">
      <image class="nav-icon-img" src="{{iconShare}}" mode="aspectFit" />
      <text class="nav-text">分享</text>
    </view>
    <button class="nav-item share-btn" open-type="share" style="display:none">
      <image class="nav-icon-img" src="{{iconShare}}" mode="aspectFit" />
      <text class="nav-text">分享</text>
    </button>
  </view>

  <!-- 全屏预览模拟器 -->
  <view class="sim-mask {{showSimulation ? 'show' : ''}}" bindtap="toggleSimulation">
    <view class="sim-content">
      <image class="sim-bg" src="{{imageList[currentIndex]}}" mode="aspectFill"></image>
      
      <!-- 预览模式切换 -->
      <view class="sim-type-tabs" catchtap="noop">
        <view class="sim-tab {{simMode === 'lock' ? 'active' : ''}}" bindtap="setSimMode" data-mode="lock">锁屏预览</view>
        <view class="sim-tab {{simMode === 'home' ? 'active' : ''}}" bindtap="setSimMode" data-mode="home">主屏预览</view>
      </view>

      <!-- 锁屏模拟 -->
      <view class="sim-lock-screen" wx:if="{{simMode === 'lock'}}">
        <view class="sim-time">{{simTime}}</view>
        <view class="sim-date">{{simDate}}</view>
        <view class="sim-lock-bottom">
          <view class="sim-lock-btn">
            <view class="css-icon-flashlight"></view>
          </view>
          <view class="sim-lock-indicator"></view>
          <view class="sim-lock-btn">
            <view class="css-icon-camera"></view>
          </view>
        </view>
      </view>

      <!-- 主屏模拟 -->
      <view class="sim-home-screen" wx:if="{{simMode === 'home'}}">
        <view class="sim-app-grid">
          <view class="sim-app-item" wx:for="{{12}}" wx:key="index">
            <view class="sim-app-icon"></view>
            <view class="sim-app-name"></view>
          </view>
        </view>
        <view class="sim-dock">
          <view class="sim-app-icon" wx:for="{{4}}" wx:key="index"></view>
        </view>
      </view>

      <view class="sim-hint">点击任意位置退出预览</view>
    </view>
  </view>

  <!-- 壁纸标签 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">壁纸标签</text>
    </view>
    <view class="tag-list">
      <block wx:for="{{tagList}}" wx:key="label">
        <view class="tag-pill {{item.type}}" bindtap="onTagTap" data-tag="{{item.label}}">
          <text>{{item.label}}</text>
        </view>
      </block>

    </view>
  </view>

  <!-- 相似推荐 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">相似推荐</text>
    </view>
    <view class="similar-grid">
      <view class="similar-item" wx:for="{{similarList}}" wx:key="url" data-url="{{item.url}}" bindtap="onRecommendTap">
        <image class="similar-img" src="{{item.url}}" mode="aspectFill" />
      </view>
    </view>
  </view>
</view>

<!-- 日签海报生成组件 -->
<poster-share visible="{{showPosterModal}}" imageUrl="{{currentUrl}}" type="wallpaper" bind:close="hidePoster"></poster-share>

