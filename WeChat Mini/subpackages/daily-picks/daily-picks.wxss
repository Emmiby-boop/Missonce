/* 页面背景 */
page {
  background: var(--bg-color);
}

.page-container {
  min-height: 100vh;
  background: var(--bg-color);
  padding-bottom: env(safe-area-inset-bottom);
  padding-top: 0;
}

.loading-page,
.error-page {
  min-height: 100vh;
  background: var(--bg-color);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 自定义导航栏样式 - 与其他页面统一使用 primary-color */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background: var(--primary-color);
  box-shadow: 0 6rpx 16rpx var(--shadow-color);
}

.nav-bar {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.nav-title {
  color: #fff;
  font-size: 32rpx;
  font-weight: 400;
}

.nav-back {
  width: 80rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.nav-placeholder {
  width: 80rpx;
  height: 100%;
}

.back-icon {
  width: 38rpx;
  height: 38rpx;
}

.nav-holder {
  width: 100%;
}

/* 顶部原生广告样式 - 紧贴导航栏，无广告时不占空间 */
.native-top-ad {
  position: relative;
  z-index: 100;
  background: var(--bg-color);
  padding: 0;
  margin: 0;
  line-height: 0;
}

.native-video-bottom-ad {
  padding: 20rpx 24rpx;
}

/* ========== 每日推荐大标题卡片 ========== */
.daily-header {
  padding: 16rpx 16rpx 20rpx;
}

.header-card {
  position: relative;
  background: linear-gradient(135deg, #ff7e5f 0%, #feb47b 100%);
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 126, 95, 0.28);
  overflow: hidden;
}

/* 装饰背景圆 */
.header-bg-deco {
  position: absolute;
  top: -40rpx;
  right: -20rpx;
  width: 140rpx;
  height: 140rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 50%;
}

/* 主内容区 */
.header-main {
  position: relative;
  display: flex;
  align-items: center;
}

/* 左侧日期 */
.header-date {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 90rpx;
  padding-right: 20rpx;
}

.date-num {
  font-size: 64rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.date-unit {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 6rpx;
  font-weight: 500;
}

/* 分隔线 */
.header-divider {
  width: 1rpx;
  height: 72rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.4) 50%, rgba(255, 255, 255, 0) 100%);
  margin-right: 20rpx;
}

/* 右侧信息 */
.header-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}

.info-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.info-label {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 1rpx;
}

.info-badge {
  font-size: 22rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.22);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(4px);
}

.info-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 底部提示 */
.header-footer {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.18);
}

.footer-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}

/* 深色模式 */
@media (prefers-color-scheme: dark) {
  .header-card {
    background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
    box-shadow: 0 6rpx 20rpx rgba(249, 115, 22, 0.22);
  }
}

.waterfall-container {
  display: flex;
  justify-content: space-between;
  padding: 0 16rpx 32rpx;
  gap: 16rpx;
  margin-top: 0;
}

.waterfall-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.waterfall-item {
  position: relative;
  border-radius: 16rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.waterfall-item:active {
  transform: scale(0.98);
  transition: transform 0.1s ease;
}

.item-image {
  width: 100%;
  display: block;
  background: #f1f5f9;
}

.item-tag {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  padding: 4rpx 12rpx;
  background: rgba(102, 126, 234, 0.9);
  color: #fff;
  font-size: 20rpx;
  border-radius: 8rpx;
  z-index: 1;
}

.loading-container {
  padding: 0 16rpx;
  padding-top: 32rpx;
}

.loading-header {
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin: 0 16rpx 24rpx;
  text-align: center;
}

.skeleton {
  background: linear-gradient(90deg, #f3f4f6 25%, #e5e7eb 50%, #f3f4f6 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s infinite;
  border-radius: 8rpx;
}

.skeleton-title {
  width: 60%;
  height: 48rpx;
  margin: 0 auto 16rpx;
}

.skeleton-subtitle {
  width: 40%;
  height: 32rpx;
  margin: 0 auto;
}

@keyframes skeleton-loading {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.waterfall-skeleton {
  display: flex;
  justify-content: space-between;
  padding: 0 16rpx;
  gap: 16rpx;
}

.skeleton-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.skeleton-item {
  aspect-ratio: 9/16;
  background: #e5e7eb;
  border-radius: 16rpx;
}

.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 32rpx;
  padding-top: 120rpx;
}

.error-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.error-text {
  font-size: 28rpx;
  color: var(--text-sub);
  margin-bottom: 32rpx;
}

.retry-btn {
  background: var(--primary-color);
  color: #fff;
  border: none;
  padding: 20rpx 60rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
}

.footer-tip {
  text-align: center;
  padding: 32rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
}
