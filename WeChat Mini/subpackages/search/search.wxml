<view class="container">
  <!-- 搜索栏 -->
  <view class="search-header">
    <view class="search-input-container">
      <image class="search-icon-img" src="../../images/icon-search.png" mode="widthFix"></image>
      <input 
        class="search-input" 
        placeholder="请输入关键词搜索壁纸或头像" 
        value="{{searchValue}}"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
        confirm-type="search"
      />
      <text class="clear-icon" wx:if="{{searchValue}}" bindtap="clearSearch">×</text>
    </view>
    <text class="search-cancel" bindtap="goBack">取消</text>
  </view>


  <!-- 搜索类型 -->
  <view class="search-type" wx:if="{{!showResult}}">
    <view class="type-item {{searchType === 'all' ? 'active' : ''}}" 
          data-type="all" 
          bindtap="onTypeChange">
      全部
    </view>
    <view class="type-item {{searchType === 'wallpaper' ? 'active' : ''}}" 
          data-type="wallpaper" 
          bindtap="onTypeChange">
      壁纸
    </view>
    <view class="type-item {{searchType === 'avatar' ? 'active' : ''}}" 
          data-type="avatar" 
          bindtap="onTypeChange">
      头像
    </view>
  </view>

  <!-- 搜索结果 -->
  <view class="search-result" wx:if="{{showResult}}">
    <view class="result-header">
      <text class="result-title">搜索结果 ({{searchResult.length}})</text>
    </view>
    
    <view class="result-grid">
      <view class="result-item {{item.type}}" wx:for="{{searchResult}}" wx:key="id" bindtap="previewImage" 
            data-index="{{index}}">
        <image class="result-image" src="{{item.url}}" mode="aspectFill"></image>
        <view class="result-tag {{item.type}}">
          {{item.type === 'wallpaper' ? '壁纸' : '头像'}}
        </view>
      </view>
    </view>
    
    <!-- 加载提示 -->
    <view class="loading-state" wx:if="{{loading}}">
      <view class="loading-spinner"></view>
      <text>加载中...</text>
    </view>
    
    <view class="no-more-state" wx:if="{{!hasMore && searchResult.length > 0}}">
      <text>没有更多了</text>
    </view>
  </view>

  <!-- 无结果时显示 -->
  <view class="no-result" wx:if="{{showResult && searchResult.length === 0}}">
    <image class="no-result-icon" src="../../images/icon-search.png" mode="widthFix"></image>
    <text class="no-result-text">没有找到相关结果</text>
    <text class="no-result-tip">请尝试其他关键词</text>
  </view>


  <!-- 搜索历史 -->
  <view class="search-filters" wx:if="{{!showResult}}">
    <view class="filter-section">
      <view class="filter-header">
        <text class="filter-title">推荐色系</text>
      </view>
      <scroll-view scroll-x class="filter-scroll color-filters">
        <view class="color-item {{activeColor === item.value ? 'active' : ''}}" 
              wx:for="{{filterColors}}" wx:key="value" 
              style="background: {{item.value}};"
              bindtap="onColorTap" data-color="{{item.value}}">
          <view class="color-check" wx:if="{{activeColor === item.value}}">✓</view>
        </view>
      </scroll-view>
    </view>

    <view class="filter-section">
      <view class="filter-header">
        <text class="filter-title">热门风格</text>
      </view>
      <view class="filter-tags style-filters">
        <view class="filter-tag {{activeStyle === item ? 'active' : ''}}" 
              wx:for="{{filterStyles}}" wx:key="*this"
              bindtap="onStyleTap" data-style="{{item}}">
          {{item}}
        </view>
      </view>
    </view>
  </view>

  <!-- 搜索历史 -->
  <view class="search-history" wx:if="{{!showResult && historyTags.length > 0}}">
    <view class="history-header">
      <text class="history-title">搜索历史</text>
      <text class="clear-history" bindtap="clearHistory">清空</text>
    </view>
    <view class="history-tags">
      <view class="history-tag" wx:for="{{historyTags}}" wx:key="*this" bindtap="onTagTap" data-keyword="{{item}}">{{item}}</view>
    </view>
  </view>

  <!-- 热门搜索 -->
  <view class="hot-search" wx:if="{{!showResult}}">
    <view class="hot-header">
      <text class="hot-title">热门搜索</text>
    </view>
    <view class="hot-tags">
      <view class="hot-tag" wx:for="{{hotTags}}" wx:key="*this" bindtap="onTagTap" data-keyword="{{item}}">{{item}}</view>
    </view>
  </view>
</view>