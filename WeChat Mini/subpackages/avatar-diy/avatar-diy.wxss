/* ====== Material Design 3 风格头像DIY ====== */
page {
  --md-primary: #07c160;                /* 微信绿（主色，用于强调文字/边框） */
  --md-primary-dark: #00a848;          /* 深一档渐变末端 */
  /* 白绿色渐变（参考专题页 tab 风格）：白→浅绿底 + 深绿字 + 绿色边框 */
  --md-primary-gradient: linear-gradient(135deg, #ffffff 0%, #dcfce7 100%);
  --md-primary-solid-gradient: linear-gradient(135deg, #07c160 0%, #00a848 100%);  /* 纯绿渐变，用于小图标背景 */
  --md-primary-container: #22c55e;
  --md-on-primary: #15803d;            /* 深绿字（白绿底上用） */
  --md-on-primary-container: #004b1e;
  --md-surface: #f8f9ff;
  --md-surface-container: #e5eeff;
  --md-surface-container-high: #dce9ff;
  --md-surface-variant: #d3e4fe;
  --md-on-surface: #0b1c30;
  --md-on-surface-variant: #3d4a3d;
  --md-secondary: #5c5f61;
  --md-secondary-container: #e0e3e5;
  --md-outline-variant: #bccbb9;
  --md-error: #ba1a1a;
  --md-tertiary: #9e4036;

  background: var(--md-surface);
  color: var(--md-on-surface);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  height: 100%;
  overflow: hidden;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--md-surface);
  overflow: hidden;
  box-sizing: border-box;
}

/* ====== 顶部导航：毛玻璃磨砂质感（与全局统一） ====== */
.topbar {
  background: rgba(248, 249, 255, 0.85);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  box-shadow: 0 1rpx 0 rgba(0, 0, 0, 0.06);
  z-index: 40;
}

.topbar-inner {
  height: 88rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.placeholder {
  width: 64rpx;
}

.icon-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s;
}

.icon-btn:active {
  background: var(--md-surface-container);
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--md-on-surface);
  flex: 1;
  text-align: center;
}

/* ====== 图标（SVG data URI，模拟 Material Symbols 风格） ====== */
.icon {
  width: 44rpx;
  height: 44rpx;
  position: relative;
  display: inline-block;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 28rpx 28rpx;
}

/* 返回箭头 */
.icon-back {
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23006e2f' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='15 18 9 12 15 6'/></svg>");
}

/* 相机（选图） */
.icon-camera {
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z'/><circle cx='12' cy='13' r='4'/></svg>");
}

/* 边框 */
.icon-frame {
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='3' width='18' height='18' rx='2' ry='2'/><rect x='7' y='7' width='10' height='10' rx='1' ry='1'/></svg>");
}

/* 笑脸（贴纸） */
.icon-smile {
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='currentColor'><path d='M12 22a10 10 0 1 1 0-20 10 10 0 0 1 0 20zm0-18a8 8 0 1 0 0 16 8 8 0 0 0 0-16z'/><circle cx='9' cy='10' r='1.2'/><circle cx='15' cy='10' r='1.2'/><path d='M8 14a5 5 0 0 0 8 0' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round'/></svg>");
}

/* 文字 T */
.icon-text {
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='4 7 4 4 20 4 20 7'/><line x1='9' y1='20' x2='15' y2='20'/><line x1='12' y1='4' x2='12' y2='20'/></svg>");
}

/* 滤镜花形 */
.icon-sparkle {
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='currentColor'><path d='M12 0l2.5 7.5L22 10l-7.5 2.5L12 20l-2.5-7.5L2 10l7.5-2.5z'/><path d='M19 14l1 3 3 1-3 1-1 3-1-3-3-1 3-1z'/></svg>");
}

/* 旋转 */
.icon-rotate {
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%235c5f61' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='1 4 1 10 7 10'/><path d='M3.51 15a9 9 0 1 0 2.13-9.36L1 10'/></svg>");
  background-size: 24rpx 24rpx;
}

/* 翻转 */
.icon-flip {
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%235c5f61' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='17 1 21 5 17 9'/><path d='M3 11V9a4 4 0 0 1 4-4h14'/><polyline points='7 23 3 19 7 15'/><path d='M21 13v2a4 4 0 0 1-4 4H3'/></svg>");
  background-size: 24rpx 24rpx;
}

/* 添加图片（选图面板主按钮） */
.icon-add-photo {
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z'/><circle cx='12' cy='13' r='4'/></svg>");
  width: 56rpx;
  height: 56rpx;
  background-size: 36rpx 36rpx;
}

/* ====== 预览区 ====== */
.preview-section {
  padding: 24rpx 0;
  display: flex;
  justify-content: center;
  background-image: radial-gradient(circle at 2px 2px, rgba(0, 0, 0, 0.04) 1px, transparent 0);
  background-size: 48rpx 48rpx;
}

.preview-canvas {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-img,
.preview-canvas-el {
  display: block;
  border-radius: 32rpx;
  background: #000;
}

.preview-canvas-el {
  background: var(--md-surface-container);
}

/* 圆形工具按钮 */
.util-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 64rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 50%;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
  transition: transform 0.15s;
  backdrop-filter: blur(8rpx);
}

.util-btn:active {
  transform: translateY(-50%) scale(0.9);
}

.util-left { left: 8rpx; }
.util-right { right: 8rpx; }

/* GIF 标识 */
.gif-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 6rpx 18rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 10rpx;
  letter-spacing: 1rpx;
  z-index: 30;
}

/* 动态预览叠加层 */
.dynamic-overlay {
  position: absolute;
  top: 0;
  left: 0;
  pointer-events: none;
  z-index: 15;
}

/* 空状态 */
.empty-state {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: var(--md-surface-container);
  border-radius: 32rpx;
  cursor: pointer;
}

.empty-state:active {
  background: var(--md-surface-container-high);
}

.empty-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--md-primary);
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.15);
}

.empty-text {
  font-size: 28rpx;
  color: var(--md-on-surface-variant);
  font-weight: 500;
}

.empty-hint {
  font-size: 22rpx;
  color: var(--md-secondary);
}

/* 隐藏的装饰层 canvas */
.deco-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  pointer-events: none;
  opacity: 0;
}

/* GIF 模式提示 */
.gif-hint {
  text-align: center;
  font-size: 24rpx;
  color: var(--md-tertiary);
  background: rgba(158, 64, 54, 0.08);
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  margin: 0 32rpx 16rpx;
  box-sizing: border-box;
}

/* ====== 工具栏 ====== */
.tool-ribbon {
  padding: 16rpx 32rpx;
  background: var(--md-surface);
  box-sizing: border-box;
}

.tool-ribbon-inner {
  background: #fff;
  border-radius: 32rpx;
  padding: 16rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.tool-item {
  flex: 1;
  min-width: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 0;
  color: var(--md-secondary);
  border-radius: 24rpx;
  transition: all 0.2s;
}

.tool-item.active {
  color: var(--md-primary);
  background: var(--md-surface-container);
}

.tool-item:active {
  transform: scale(0.95);
}

.tool-label {
  font-size: 22rpx;
  font-weight: 500;
}

/* ====== 内容面板 ====== */
.content-panel {
  flex: 1;
  padding: 16rpx 32rpx 160rpx;
  min-height: 0;
  box-sizing: border-box;
}

.panel-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--md-on-surface);
  margin: 16rpx 0 20rpx;
  letter-spacing: 0.02em;
}

/* 4列网格（flex+wrap，最后一行不足4个时居中对齐） */
.options-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
  box-sizing: border-box;
}

.options-grid .grid-item {
  width: calc((100% - 48rpx) / 4);
  flex: 0 0 auto;
}

.grid-item {
  aspect-ratio: 1;
  background: #fff;
  border-radius: 24rpx;
  padding: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  position: relative;
  transition: all 0.2s;
  box-sizing: border-box;
  overflow: hidden;
}

.grid-item.active {
  box-shadow: inset 0 0 0 4rpx var(--md-primary);
}

.grid-item.active::after {
  content: '';
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: var(--md-primary-solid-gradient);
  background-image: linear-gradient(#fff, #fff);
  background-repeat: no-repeat;
  background-position: center;
  background-size: 18rpx 18rpx;
  mask: linear-gradient(#000, #000) padding-box, linear-gradient(#000, #000);
  mask-composite: exclude;
  -webkit-mask: linear-gradient(#000, #000) padding-box, linear-gradient(#000, #000);
  -webkit-mask-composite: xor;
}

.grid-label {
  font-size: 22rpx;
  color: var(--md-on-surface-variant);
  font-weight: 500;
}

/* 无文字标签的网格项：让预览居中填满 */
.grid-item.no-label {
  padding: 0;
}

.grid-item.no-label .border-preview,
.grid-item.no-label .frame-preview {
  width: 80%;
  height: 80%;
  border-radius: 24rpx;
  box-sizing: border-box;
}

/* ====== 边框预览（保留原有样式） ====== */
.border-preview {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border: 6rpx solid transparent;
}

.border-none { border: 6rpx solid transparent; }
.border-white { border-color: #fff; box-shadow: 0 0 0 2rpx #e2e8f0; }
.border-black { border-color: #000; }
.border-pink { border-color: #ff4d9d; }
.border-gradient {
  border: 6rpx solid transparent;
  background-image: linear-gradient(#f8fafc, #f8fafc), linear-gradient(135deg, #fa709a, #fee140);
  background-origin: border-box;
  background-clip: content-box, border-box;
}
.border-dashed { border: 6rpx dashed #64748b; }

/* ====== 滤镜预览（保留原有样式） ====== */
.filter-preview {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
}

.filter-none { filter: none; }
.filter-gray { filter: grayscale(1); }
.filter-sepia { filter: sepia(1); }
.filter-bright { filter: brightness(1.3); }
.filter-warm { filter: sepia(0.4) saturate(1.3) hue-rotate(-10deg); }
.filter-cool { filter: hue-rotate(180deg) saturate(0.8); }

/* ====== 头像框预览（保留原有样式） ====== */
.frame-preview {
  width: 60rpx;
  height: 60rpx;
  border-radius: 12rpx;
  background: #f1f5f9;
}

.frame-none { background: #f1f5f9; }
.frame-white { background: #f1f5f9; border: 6rpx solid #fff; }
.frame-black { background: #f1f5f9; border: 6rpx solid #000; }
.frame-pink { background: #fff0f6; border: 4rpx solid #ff4d9d; }
.frame-purple { background: #f3e8ff; border: 4rpx solid #a855f7; }
.frame-polaroid { background: #fff; padding: 6rpx 6rpx 20rpx; }
.frame-vintage { background: #d4a574; border: 4rpx solid #8b4513; }
.frame-neon { background: #0a0a0a; box-shadow: 0 0 8rpx #00ffff, inset 0 0 8rpx #ff00ff; }
.frame-double { background: #f1f5f9; border: 2rpx solid #000; box-shadow: inset 0 0 0 4rpx #f1f5f9, inset 0 0 0 6rpx #000; }
.frame-dots { background: #f1f5f9; background-image: radial-gradient(#000 2rpx, transparent 2rpx); background-size: 12rpx 12rpx; }
.frame-rainbow { background: linear-gradient(45deg, #ff6b6b, #ffa500, #ffff00, #22c55e, #1890ff, #a855f7); }
.frame-petal { background: #fff0f6; border: 4rpx dashed #ff4d9d; }
.frame-gold { background: #fffbeb; border: 4rpx solid #d4af37; }

/* ====== 卡片（滑块/选项行） ====== */
.slider-card,
.option-row-card,
.text-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-top: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.slider-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.slider-label,
.option-row-label {
  font-size: 26rpx;
  color: var(--md-on-surface-variant);
  font-weight: 500;
  flex-shrink: 0;
  width: 120rpx;
}

.slider {
  flex: 1;
}

.slider-value {
  font-size: 26rpx;
  color: var(--md-primary);
  font-weight: 600;
  width: 100rpx;
  text-align: right;
}

/* ====== 文字面板 ====== */
.text-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--md-surface-container);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--md-on-surface);
  box-sizing: border-box;
}

.color-dots {
  display: flex;
  gap: 12rpx;
  flex: 1;
  flex-wrap: wrap;
}

.color-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 4rpx solid var(--md-outline-variant);
  transition: all 0.2s;
  box-sizing: border-box;
}

.color-dot.active {
  border-color: var(--md-primary);
  border-width: 6rpx;
  transform: scale(1.1);
}

/* ====== 文字拖动提示 ====== */
.drag-hint {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: var(--md-secondary-container);
  border-radius: 20rpx;
  box-sizing: border-box;
}

.drag-hint .icon {
  flex-shrink: 0;
  color: var(--md-secondary);
}

.drag-hint-text {
  font-size: 24rpx;
  color: var(--md-on-surface-variant);
  line-height: 1.4;
}

/* canvas 可拖动状态：手指可操作 */
.preview-canvas-el.draggable {
  touch-action: none;
}

/* 拖动图标（四向箭头） */
.icon-drag {
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%235c5f61' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='5 9 2 12 5 15'/><polyline points='9 5 12 2 15 5'/><polyline points='15 19 12 22 9 19'/><polyline points='19 9 22 12 19 15'/><line x1='2' y1='12' x2='22' y2='12'/><line x1='12' y1='2' x2='12' y2='22'/></svg>");
}

/* ====== 横向滚动（动态框已改为网格，保留样式以防回退） ====== */
.h-scroll {
  margin: 0 -32rpx;
  padding: 0 32rpx;
}

/* ====== 边框分类标签（基础/静态框/动态框） ====== */
.category-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.category-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background: var(--md-secondary-container);
  color: var(--md-secondary);
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 0.02em;
  transition: all 0.2s;
}

.category-tab.active {
  background: var(--md-primary-gradient);
  color: var(--md-on-primary);
  border: 1rpx solid rgba(34, 197, 94, 0.4);
  box-shadow: 0 2rpx 8rpx rgba(34, 197, 94, 0.2);
  font-weight: 600;
}

.category-tab:active {
  transform: scale(0.95);
}

.h-scroll-list {
  display: flex;
  gap: 16rpx;
  padding: 8rpx 0;
}

.h-scroll-item {
  flex-shrink: 0;
  width: 160rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  position: relative;
  transition: all 0.2s;
}

.h-scroll-item.active {
  box-shadow: inset 0 0 0 4rpx var(--md-primary);
}

.frame-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: var(--md-surface-container);
}

.dynamic-hint {
  margin-top: 16rpx;
  padding: 16rpx 24rpx;
  background: var(--md-surface-container);
  border-radius: 16rpx;
  font-size: 24rpx;
  color: var(--md-on-surface-variant);
  text-align: center;
}

/* ====== 主按钮 ====== */
.primary-btn {
  margin-top: 24rpx;
  width: 100%;
  height: 96rpx;
  background: var(--md-primary-gradient);
  color: var(--md-on-primary);
  border: 1rpx solid rgba(34, 197, 94, 0.4);
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(34, 197, 94, 0.2);
  transition: transform 0.15s;
}

.primary-btn:active {
  transform: scale(0.98);
}

.primary-btn[disabled] {
  background: var(--md-secondary-container);
  color: var(--md-secondary);
  border-color: transparent;
  box-shadow: none;
}

/* ====== 选图面板 ====== */
.select-panel {
  flex: 1;
  padding: 32rpx 32rpx 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 0;
  box-sizing: border-box;
}

/* 未选图提示 */
.select-empty-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 64rpx 32rpx;
  color: var(--md-secondary);
}

.select-empty-hint .icon {
  color: var(--md-secondary);
  opacity: 0.5;
}

.select-empty-text {
  font-size: 28rpx;
  color: var(--md-on-surface-variant);
  font-weight: 500;
}

.select-empty-sub {
  font-size: 24rpx;
  color: var(--md-secondary);
}

/* 已选图：重新选择按钮（胶囊形） */
.select-rechoose-btn {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 40rpx;
  background: var(--md-primary-gradient);
  color: var(--md-on-primary);
  border: 1rpx solid rgba(34, 197, 94, 0.4);
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(34, 197, 94, 0.2);
  transition: transform 0.15s;
}

.select-rechoose-btn:active {
  transform: scale(0.95);
}

.select-rechoose-btn .icon {
  color: var(--md-on-primary);
}

.gif-params {
  width: 100%;
  margin-top: 32rpx;
}

.reset-row {
  width: 100%;
  margin-top: 32rpx;
  display: flex;
  justify-content: center;
}

.reset-btn {
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  color: var(--md-secondary);
  border: 2rpx solid var(--md-outline-variant);
  border-radius: 999rpx;
  transition: all 0.2s;
}

.reset-btn:active {
  background: var(--md-surface-container);
}

/* ====== 滤镜实时预览（横向滚动缩略图） ====== */
.filter-scroll {
  margin: 0 -32rpx;
  padding: 0 32rpx;
  white-space: nowrap;
  /* 🔥 修复第一个滤镜选中框显示不全：scroll-view 默认 overflow: hidden 会裁剪
     第一个/最后一个滤镜选中态的 border。改用 padding-box 留出 4rpx 边距，
     但更稳妥的方案是用 box-shadow 代替 border（见 .filter-thumb.active） */
}

.filter-list {
  display: inline-flex;
  gap: 16rpx;
  padding: 8rpx 4rpx;  /* 🔥 左右各留 4rpx，避免首尾滤镜选中态边框被裁剪 */
}

.filter-thumb {
  flex-shrink: 0;
  width: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  position: relative;
}

.filter-thumb-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 20rpx;
  background: var(--md-surface-container);
  /* 🔥 用 box-shadow 代替 border 实现选中态：
     border 占空间会被父容器 overflow 裁剪；box-shadow 不占空间，且可同时绘制外阴影+内描边 */
  box-shadow: 0 0 0 4rpx transparent;
  transition: box-shadow 0.2s;
}

.filter-thumb.active .filter-thumb-img {
  box-shadow: 0 0 0 4rpx var(--md-primary), 0 4rpx 12rpx rgba(7, 193, 96, 0.2);
}

.filter-thumb-label {
  font-size: 24rpx;
  color: var(--md-on-surface-variant);
  font-weight: 500;
}

.filter-thumb.active .filter-thumb-label {
  color: var(--md-primary);
  font-weight: 600;
}

.filter-check {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--md-primary-solid-gradient);
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23fff' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'><polyline points='20 6 9 17 4 12'/></svg>");
  background-repeat: no-repeat;
  background-position: center;
  background-size: 20rpx 20rpx;
}

/* ====== 底部固定保存按钮 ====== */
.bottom-save-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--md-surface);
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 50;
  box-sizing: border-box;
}

.bottom-save-btn {
  margin-top: 0;
  height: 88rpx;
}

/* ====== 用户上传头像框 overlay（可拖动+缩放） ====== */
.frame-overlay {
  position: absolute;
  width: 100%;
  height: 100%;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%) scale(1);
  transform-origin: center center;
  pointer-events: auto;
  z-index: 18;
  /* 让 image 不拦截背景 canvas 的点击（拖动由 catchtouch 处理） */
}

/* canvas 在头像框激活时降低触摸优先级，让头像框可拖动 */
.preview-canvas-el.frame-active {
  pointer-events: none;
}

/* ====== 用户上传头像框缩略图网格 ====== */
.frame-grid-item {
  padding: 8rpx;
}

.frame-thumb-img {
  width: 100%;
  height: 100%;
  flex: 1;
  border-radius: 16rpx;
  background: var(--md-surface-container);
  box-sizing: border-box;
  min-height: 0;
}

/* 空状态提示（静态框/动态框未上传时） */
.frame-section-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 64rpx 32rpx;
  color: var(--md-secondary);
}

.frame-section-hint-text {
  font-size: 28rpx;
  color: var(--md-on-surface-variant);
  font-weight: 500;
}

.frame-section-hint-sub {
  font-size: 24rpx;
  color: var(--md-secondary);
}

/* ====== 面板标题行（含清除按钮） ====== */
.panel-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 0 20rpx;
  box-sizing: border-box;
}

.panel-title-row .panel-title {
  margin: 0;
}

.clear-text-btn {
  font-size: 24rpx;
  color: var(--md-error);
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(186, 26, 26, 0.08);
  font-weight: 500;
  transition: background 0.2s;
}

.clear-text-btn:active {
  background: rgba(186, 26, 26, 0.16);
}

/* 预设"无"框预览（灰色斜线背景，表示无头像框） */
.frame-none-preview {
  background: #f1f5f9;
  background-image: linear-gradient(45deg, transparent 45%, #cbd5e1 45%, #cbd5e1 55%, transparent 55%);
  border: 2rpx dashed #cbd5e1;
}

