page {
  overflow-x: hidden;
  width: 100%;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background: #07c160;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.12);
}

.nav-bar {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.nav-title {
  color: #fff;
  font-size: 32rpx;
  font-weight: 400;
}

.nav-back {
  width: 80rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.nav-placeholder {
  width: 80rpx;
  height: 100%;
}

.back-icon {
  width: 38rpx;
  height: 38rpx;
}

.nav-holder {
  width: 100%;
}

.container {
  min-height: 100vh;
  width: 100%;
  background: #f6f7fb;
  color: #1f2a44;
  box-sizing: border-box;
  padding: 24rpx 32rpx 60rpx;
  position: relative;
}

/* 主预览区域 */
.hero-wrapper {
  margin-top: 12rpx;
  position: relative;
}




.hero-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 16rpx 38rpx rgba(16, 42, 66, 0.12);
  box-sizing: border-box;
}

.hero-swiper {
  width: 100%;
  height: 720rpx;
}

swiper-item {
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-inner {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.photo-mask {
  width: 520rpx;
  height: 520rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
  background: #f8f9fb;
}

.photo-mask.mask-circle {
  border-radius: 50%;
}

.photo-mask.mask-square {
  border-radius: 28rpx;
}

.hero-image {
  width: 520rpx;
  height: 520rpx;
  border-radius: 28rpx;
  opacity: 0;
  transform: scale(0.96);
  transition: opacity 0.35s ease, transform 0.35s ease, border-radius 0.25s ease;
  object-fit: cover;
}

.hero-image.circular {
  border-radius: 50%;
}

.hero-image.show {
  opacity: 1;
  transform: scale(1);
}

.img-loading {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.skeleton {
  width: 520rpx;
  height: 520rpx;
  border-radius: 50%;
  background: linear-gradient(90deg, #f0f2f5 0%, #e6e9ed 50%, #f0f2f5 100%);
  background-size: 200% 100%;
  animation: shimmer 1.4s ease-in-out infinite;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.page-indicator {
  position: absolute;
  bottom: 24rpx;
  right: 28rpx;
  background: rgba(0, 0, 0, 0.58);
  color: #fff;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  opacity: 0;
  transition: opacity 0.2s ease;
}

.page-indicator.show {
  opacity: 1;
}

/* 区块 */
.section {
  margin-top: 36rpx;
  padding: 0 6rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2a44;
}

/* 标签 */
.tag-list {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.tag-pill {
  padding: 16rpx 26rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #fff;
  font-weight: 600;
  background: #07c160;
}

.tag-pill.secondary {
  background: #ff6fa0;
}

.tag-pill.blue {
  background: #4facfe;
}

.tag-pill.orange {
  background: #ff9a9e;
}

.tag-pill.purple {
  background: #a18cd1;
}

.tag-pill.teal {
  background: #43e97b;
}

.tag-pill.light {
  background: #d9e3ff;
  color: #345;
}

/* 相似头像 */
.similar-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
}

.similar-item {
  width: 100%;
  position: relative;
  padding-top: 100%;
  border-radius: 16rpx;
  overflow: hidden;
  background: #eef1f6;
}

.similar-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.similar-label {
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  background-color: rgba(0, 0, 0, 0.5);
  color: #fff;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  font-size: 24rpx;
}

/* 底部操作栏 */
.bottom-bar {
  position: relative;
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  gap: 12rpx;
  padding: 18rpx 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(16, 42, 66, 0.1);
  border-radius: 20rpx;
  width: 100vw;
  box-sizing: border-box;
  left: 50%;
  transform: translateX(-50%);
}





.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 10rpx 6rpx;
  font-size: 24rpx;
  color: #2f3a4c;
  background: transparent;
  border-radius: 16rpx;
  border: none;
  flex: 1;
}


.nav-item:active {
  transform: scale(0.96);
}

.nav-icon-img {
  width: 44rpx;
  height: 44rpx;
  display: block;
}


.nav-text {
  font-size: 22rpx;
  color: #2f3a4c;
}

.nav-text.active {
  color: #ff3e87;
  font-weight: 700;
}

.nav-center {
  background: linear-gradient(135deg, #ff7abf 0%, #ff4899 100%);
  color: #fff;
  border-radius: 50%;
  box-shadow: 0 10rpx 26rpx rgba(255, 97, 163, 0.4);
  flex: 0 0 auto;
  width: 120rpx;
  height: 120rpx;
  padding: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;

}







.nav-center .nav-text {
  color: #fff;
  font-weight: 700;
  font-size: 24rpx;
  line-height: 1.2;
}

.nav-center .nav-icon-img {
  width: 54rpx;
  height: 54rpx;
  margin: 0 auto 6rpx;
}



.share-btn {
  background: transparent;
  padding: 12rpx 8rpx;
}

.share-btn::after {
  border: none;
}

/* 登录弹窗 */
.login-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-modal-content {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2a44;
  margin-bottom: 24rpx;
}

.login-modal-desc {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  margin-bottom: 48rpx;
  line-height: 1.5;
}

.login-modal-btns {
  display: flex;
  width: 100%;
  gap: 24rpx;
}

.login-btn {
  flex: 1;
  font-size: 30rpx;
  height: 88rpx;
  border-radius: 44rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-btn::after {
  border: none;
}

.login-btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.login-btn.confirm {
  background: #07c160;
  color: #fff;
}

.login-btn[disabled] {
  opacity: 0.7;
}

/* 深色模式适配 */
@media (prefers-color-scheme: dark) {
  .container {
    background: #111827;
    color: #f3f4f6;
  }

  .hero-card {
    background: #1f2937;
    box-shadow: 0 16rpx 38rpx rgba(0, 0, 0, 0.3);
  }

  .photo-mask {
    background: #374151;
  }

  .section-title {
    color: #f3f4f6;
  }

  .tag-pill.light {
    background: #374151;
    color: #d1d5db;
  }

  .similar-item {
    background: #374151;
  }

  .bottom-bar {
    background: #1f2937;
    box-shadow: 0 10rpx 26rpx rgba(0, 0, 0, 0.3);
  }

  .nav-item {
    color: #9ca3af;
  }

  .nav-text {
    color: #9ca3af;
  }

  .login-modal-content {
    background: #1f2937;
    color: #f3f4f6;
  }

  .login-modal-title {
    color: #f3f4f6;
  }

  .login-modal-desc {
    color: #9ca3af;
  }

  .login-btn.cancel {
    background: #374151;
    color: #9ca3af;
  }
}
