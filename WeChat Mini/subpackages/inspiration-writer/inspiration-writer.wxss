.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0fff4 0%, #ffffff 100%);
  padding-bottom: 40rpx;
}

.header {
  padding: 40rpx 30rpx 20rpx;
}

.header-top {
  text-align: center;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  color: #07c160;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #8c8c8c;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e5e5e5;
  border-top-color: #07c160;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #8c8c8c;
}

.content {
  padding: 0 30rpx;
}

.scenes-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.scenes-list {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.scene-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  background: #fff;
  border-radius: 20rpx;
  border: 2rpx solid #f0f0f0;
  transition: all 0.3s;
}

.scene-item.active {
  border-color: #07c160;
  background: #f0fff4;
}

.scene-emoji {
  font-size: 40rpx;
  margin-bottom: 12rpx;
}

.scene-name {
  font-size: 24rpx;
  color: #595959;
}

.input-wrapper {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.input-area {
  width: 100%;
  min-height: 200rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: #333;
}

.input-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.char-count {
  font-size: 24rpx;
  color: #bfbfbf;
}

.generate-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  border-radius: 48rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.generate-btn.loading {
  opacity: 0.7;
}

.btn-loading {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.btn-loading .spinner {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.featured-section {
  margin-top: 60rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.quotes-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.quote-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid #f0f0f0;
}

.quote-content {
  font-size: 30rpx;
  line-height: 1.7;
  color: #333;
  margin-bottom: 20rpx;
}

.quote-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.quote-tag {
  padding: 8rpx 20rpx;
  background: #f0fff4;
  color: #07c160;
  font-size: 22rpx;
  border-radius: 24rpx;
}

.result-section {
  padding-top: 20rpx;
}

.result-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 40rpx;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  padding: 16rpx 32rpx;
  background: #f5f5f5;
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #595959;
}

.result-content {
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  position: relative;
}

.generated-text {
  font-size: 32rpx;
  line-height: 1.8;
  color: #262626;
  white-space: pre-wrap;
  word-break: break-word;
}

.typing-cursor {
  display: inline-block;
  width: 4rpx;
  height: 36rpx;
  background: #07c160;
  margin-left: 4rpx;
  animation: blink 1s infinite;
  vertical-align: middle;
}

@keyframes blink {
  0%, 50% { opacity: 1; }
  51%, 100% { opacity: 0; }
}

.result-footer {
  padding: 0 20rpx;
}

.regenerate-btn {
  width: 100%;
  height: 96rpx;
  background: #fff;
  border: 2rpx solid #07c160;
  border-radius: 48rpx;
  color: #07c160;
  font-size: 30rpx;
  font-weight: 500;
}
