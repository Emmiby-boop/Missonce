page {
  background: var(--bg-color);
}

/* ===========================
   导航栏
   =========================== */
.custom-nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 1000;
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  box-shadow: 0 1rpx 0 rgba(0, 0, 0, 0.04);
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 44px;
  padding: 0 8px;
}

.nav-back {
  width: 44px; height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 22px; height: 22px;
}

.nav-title {
  font-size: 17px;
  font-weight: 600;
  color: var(--text-main);
}

.nav-action {
  width: 44px; height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: background 0.2s;
}

.nav-action.active {
  background: rgba(7, 193, 96, 0.1);
}

/* CSS 搜索图标 */
.si-wrap {
  position: relative;
  width: 36rpx; height: 36rpx;
}

.si-ring {
  width: 20rpx; height: 20rpx;
  border: 3rpx solid var(--text-sub);
  border-radius: 50%;
  position: absolute;
  top: 2rpx; left: 2rpx;
}

.si-stick {
  width: 12rpx; height: 3rpx;
  background: var(--text-sub);
  border-radius: 2rpx;
  position: absolute;
  bottom: 4rpx; right: 0;
  transform: rotate(45deg);
}

.nav-action.active .si-ring {
  border-color: var(--primary-color);
}

.nav-action.active .si-stick {
  background: var(--primary-color);
}

.nav-holder { width: 100%; }

/* ===========================
   搜索面板（折叠式）
   =========================== */
.search-panel {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
  background: var(--card-bg);
}

.search-panel.open {
  max-height: 120rpx;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-field {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  background: var(--bg-color);
  border-radius: 999rpx;
  padding: 0 24rpx;
}

.search-field-icon {
  position: relative;
  width: 28rpx; height: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.si-ring-sm {
  width: 16rpx; height: 16rpx;
  border: 2rpx solid var(--text-sub);
  border-radius: 50%;
  position: absolute;
  top: 0; left: 0;
}

.si-stick-sm {
  width: 8rpx; height: 2rpx;
  background: var(--text-sub);
  border-radius: 1rpx;
  position: absolute;
  bottom: 3rpx; right: 0;
  transform: rotate(45deg);
}

.search-field-input {
  flex: 1;
  font-size: 28rpx;
  height: 72rpx;
  color: var(--text-main);
}

.search-placeholder {
  color: var(--text-sub);
}

.search-go {
  flex-shrink: 0;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 36rpx;
  background: var(--primary-color);
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
}

/* ===========================
   广告
   =========================== */
.native-top-ad {
  position: relative;
  z-index: 100;
  background: var(--bg-color);
  padding: 0; margin: 0; line-height: 0;
}

.iw-banner-ad {
  width: 100%;
  padding: 16rpx 0;
  background: var(--bg-color);
  box-sizing: border-box;
}

/* ===========================
   容器
   =========================== */
.container {
  min-height: 100vh;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* ===========================
   分类标签栏（药丸风格 + 吸顶）
   =========================== */
.cat-scroll {
  position: sticky;
  top: 0;
  z-index: 50;
  white-space: nowrap;
  background: rgba(247, 248, 250, 0.9);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-color);
  box-sizing: border-box;
}

.cat-row {
  display: inline-flex;
  padding: 0 24rpx;
  gap: 16rpx;
}

.cat {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid rgba(7, 193, 96, 0.15);
  transition: all 0.25s ease;
}

.cat-label {
  font-size: 26rpx;
  color: #475569;
  font-weight: 500;
  white-space: nowrap;
  transition: color 0.25s;
}

.cat.on {
  background: linear-gradient(135deg, #ffffff 0%, #dcfce7 100%);
  border-color: rgba(7, 193, 96, 0.4);
  box-shadow: 0 4rpx 14rpx rgba(7, 193, 96, 0.2);
}

.cat.on .cat-label {
  color: #15803d;
  font-weight: 600;
}

/* ===========================
   沉浸式文案 Feed
   =========================== */
.feed {
  padding: 8rpx 0;
}

.card {
  position: relative;
  padding: 52rpx 40rpx 36rpx;
  border-bottom: 1rpx solid var(--border-color);
  transition: background 0.15s;
}

.card-press {
  background: rgba(7, 193, 96, 0.03);
}

/* 分类角标 */
.card-cat {
  position: absolute;
  top: 20rpx;
  right: 32rpx;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(7, 193, 96, 0.1);
  color: var(--primary-color);
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.6;
}

/* 装饰引号 */
.card-mark {
  position: absolute;
  top: 4rpx;
  left: 20rpx;
  font-size: 160rpx;
  line-height: 1;
  color: rgba(7, 193, 96, 0.06);
  font-family: Georgia, 'Times New Roman', serif;
  pointer-events: none;
  user-select: none;
}

/* 正文 */
.card-body {
  position: relative;
  margin-bottom: 32rpx;
}

.card-text {
  font-size: 34rpx;
  line-height: 2.0;
  color: var(--text-main);
  letter-spacing: 1rpx;
}

/* 底栏 */
.card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
}

.tag {
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  border-radius: 999rpx;
  background: var(--bg-color);
  color: var(--text-sub);
  line-height: 1.6;
  flex-shrink: 0;
}

.card-copy {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 10rpx 32rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--primary-color);
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 500;
  letter-spacing: 1rpx;
  transition: all 0.2s;
}

.card-copy:active {
  background: var(--primary-color);
  color: #fff;
}

/* ===========================
   状态区
   =========================== */
.state-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.spinner {
  width: 56rpx; height: 56rpx;
  border: 4rpx solid var(--border-color);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.spinner.small {
  width: 36rpx; height: 36rpx;
  border-width: 3rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.state-label {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--text-sub);
}

.state-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 40rpx;
}

.empty-mark {
  font-size: 120rpx;
  line-height: 1;
  color: rgba(7, 193, 96, 0.1);
  font-family: Georgia, 'Times New Roman', serif;
  margin-bottom: 12rpx;
}

.state-hint {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 8rpx;
  opacity: 0.7;
}

.state-end {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 48rpx 40rpx;
}

.end-line {
  width: 60rpx;
  height: 1rpx;
  background: var(--border-color);
}

.end-text {
  font-size: 24rpx;
  color: var(--text-sub);
  white-space: nowrap;
}

/* ===========================
   深色模式
   =========================== */
@media (prefers-color-scheme: dark) {
  .custom-nav {
    background: rgba(18, 18, 18, 0.88);
    box-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.06);
  }

  .back-icon {
    filter: brightness(0) invert(1);
  }

  .si-ring {
    border-color: #6b7280;
  }

  .si-stick {
    background: #6b7280;
  }

  .nav-action.active .si-ring {
    border-color: var(--primary-color);
  }

  .nav-action.active .si-stick {
    background: var(--primary-color);
  }

  .search-panel.open {
    border-bottom-color: rgba(255, 255, 255, 0.06);
  }

  .si-ring-sm {
    border-color: #6b7280;
  }

  .si-stick-sm {
    background: #6b7280;
  }

  .search-go {
    background: var(--primary-color);
  }

  .cat {
    background: rgba(31, 41, 55, 0.7);
    border-color: rgba(7, 193, 96, 0.2);
  }

  .cat-label {
    color: #9ca3af;
  }

  .cat.on {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.15) 0%, rgba(7, 193, 96, 0.35) 100%);
    border-color: rgba(7, 193, 96, 0.5);
    box-shadow: 0 4rpx 14rpx rgba(7, 193, 96, 0.3);
  }

  .cat.on .cat-label {
    color: #86efac;
  }

  .cat-scroll {
    background: rgba(18, 18, 18, 0.9);
  }

  .card-press {
    background: rgba(16, 185, 129, 0.05);
  }

  .card-cat {
    background: rgba(16, 185, 129, 0.15);
    color: var(--primary-color);
  }

  .card-mark {
    color: rgba(16, 185, 129, 0.05);
  }

  .tag {
    background: rgba(255, 255, 255, 0.06);
  }

  .card-copy {
    border-color: var(--primary-color);
    color: var(--primary-color);
  }

  .card-copy:active {
    background: var(--primary-color);
    color: #fff;
  }

  .empty-mark {
    color: rgba(16, 185, 129, 0.08);
  }

  .end-line {
    background: #374151;
  }
}
