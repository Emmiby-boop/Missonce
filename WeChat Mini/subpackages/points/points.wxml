<view class="container">
  <ad-unit kind="interstitial" page-path="/subpackages/points/points"></ad-unit>
  
  <!-- 顶部渐变 -->
  <view class="header">
    <view class="header-bg"></view>
    
    <view class="header-content">
      <view class="page-title">积分中心</view>
    </view>
    
    <!-- 积分卡片 -->
    <view class="points-card">
      <view class="points-label">当前积分</view>
      <view class="points-value">{{points}}</view>
      <view class="points-total">累计获得 {{totalPoints}} 积分</view>
    </view>

    <!-- 会员横幅 -->
    <view class="member-banner" bindtap="switchToVip" wx:if="{{!isMember}}">
      <view class="member-info">
        <image class="member-icon-img" src="/images/icon-points-crown.svg" mode="aspectFit"></image>
        <view class="member-text-wrap">
          <text class="member-text">积分兑会员，享无限下载</text>
          <text class="member-subtext">VIP专享权益</text>
        </view>
      </view>
      <view class="member-arrow-wrap">
        <text class="member-arrow">立即兑换</text>
        <text class="arrow-icon">&#8594;</text>
      </view>
    </view>

    <view class="member-banner active" wx:if="{{isMember}}">
      <view class="member-info">
        <image class="member-icon-img" src="/images/icon-points-crown.svg" mode="aspectFit"></image>
        <view class="member-text-wrap">
          <text class="member-text">{{memberName}}</text>
          <text class="member-subtext" wx:if="{{memberDaysRemaining > 0}}">剩余 {{memberDaysRemaining}} 天</text>
          <text class="member-subtext" wx:if="{{memberDaysRemaining <= 0}}">即将到期</text>
        </view>
      </view>
      <view class="member-status">
        <text class="status-badge">生效中</text>
      </view>
    </view>
  </view>

  <view class="content">
    <!-- 赚取积分 -->
    <view class="action-section">
      <view class="section-title">赚取积分</view>
      <view class="action-grid">
        <view class="action-item {{isCheckedIn ? 'disabled' : ''}}" bindtap="handleCheckIn">
          <view class="action-icon-wrap checkin">
            <image class="action-icon-img" src="/images/icon-points-checkin.svg" mode="aspectFit"></image>
          </view>
          <view class="action-content">
            <text class="action-title">{{isCheckedIn ? '已签到' : '每日签到'}}</text>
            <text class="action-reward">+{{checkInReward}}积分</text>
          </view>
        </view>
        
        <view class="action-item" bindtap="handleShare">
          <view class="action-icon-wrap share">
            <image class="action-icon-img" src="/images/icon-points-share.svg" mode="aspectFit"></image>
          </view>
          <view class="action-content">
            <text class="action-title">分享</text>
            <text class="action-reward">+{{shareReward}}积分</text>
          </view>
        </view>

        <view class="action-item" bindtap="inviteFriend">
          <view class="action-icon-wrap invite">
            <image class="action-icon-img" src="/images/icon-points-invite.svg" mode="aspectFit"></image>
          </view>
          <view class="action-content">
            <text class="action-title">邀请好友</text>
            <text class="action-reward">+{{inviteReward}}积分</text>
          </view>
        </view>

        <view class="action-item" bindtap="watchAdForPoints">
          <view class="action-icon-wrap video">
            <image class="action-icon-img" src="/images/icon-points-video.svg" mode="aspectFit"></image>
          </view>
          <view class="action-content">
            <text class="action-title">观看激励视频</text>
            <text class="action-reward">+{{watchAdPoints}}积分</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 激励视频广告组件 -->
    <view class="reward-ad-wrapper">
      <ad-unit kind="rewarded"
               id="rewardAdComp"
               page-path="/subpackages/points/points"
               reward-cloud-name="userPoints"
               reward-cloud-action="rewardAdWatch"
               reward-points="{{watchAdPoints}}"
               button-text="观看激励视频获取积分"
               show-button="{{false}}"
               bind:rewarded="onRewardedFinished"
               custom-class="reward-ad-component"></ad-unit>
    </view>

    <!-- Tab 栏 -->
    <view class="tabs">
      <view class="tab-item {{activeTab === 'records' ? 'active' : ''}}" bindtap="switchTab" data-tab="records">积分记录</view>
      <view class="tab-item {{activeTab === 'rules' ? 'active' : ''}}" bindtap="switchTab" data-tab="rules">积分规则</view>
      <view class="tab-item {{activeTab === 'vip' ? 'active' : ''}}" bindtap="switchTab" data-tab="vip">会员特权</view>
    </view>

    <!-- 积分记录 -->
    <view wx:if="{{activeTab === 'records'}}" class="records-section">
      <view wx:if="{{loading}}" class="loading-container">
        <view class="loading-spinner"></view>
        <text class="loading-text">加载中...</text>
      </view>
      
      <view wx:elif="{{records.length === 0}}" class="empty-container">
        <image class="empty-icon-img" src="/images/icon-points-records.svg" mode="aspectFit"></image>
        <text class="empty-text">暂无积分记录</text>
        <text class="empty-hint">完成任务赚取积分吧</text>
      </view>
      
      <view wx:else class="records-list">
        <view wx:for="{{records}}" wx:key="_id" class="record-item">
          <view class="record-dot {{item.type === 'checkIn' ? 'dot-checkin' : item.amount > 0 ? 'dot-earn' : 'dot-spend'}}"></view>
          <view class="record-info">
            <view class="record-desc">{{item.description}}</view>
            <view class="record-time">{{formatTime(item.createdAt)}}</view>
            <view wx:if="{{item.checkInDays}}" class="record-checkin">连续签到 {{item.checkInDays}} 天</view>
          </view>
          <view class="record-amount {{item.amount > 0 ? 'positive' : 'negative'}}">{{item.amount > 0 ? '+' : ''}}{{item.amount}}</view>
        </view>
        
        <view wx:if="{{hasMore}}" class="load-more" bindtap="loadMore">{{loadingMore ? '加载中...' : '加载更多'}}</view>
        <view wx:if="{{!hasMore && records.length > 0}}" class="no-more">没有更多了</view>
      </view>
    </view>

    <!-- 积分规则 -->
    <view wx:if="{{activeTab === 'rules'}}" class="rules-section">
      <view class="rule-card">
        <view class="rule-header">
          <image class="rule-icon-img" src="/images/icon-points-checkin.svg" mode="aspectFit"></image>
          <text class="rule-title">每日签到</text>
        </view>
        <view class="rule-content">
          <view class="rule-item"><text class="rule-dot"></text><text class="rule-text">每日首次签到可获得 <text class="highlight">{{checkInReward}}</text> 积分</text></view>
          <view class="rule-item"><text class="rule-dot"></text><text class="rule-text">连续签到 7 天，额外奖励 30 积分</text></view>
          <view class="rule-item"><text class="rule-dot"></text><text class="rule-text">连续签到 30 天，额外奖励 100 积分</text></view>
        </view>
      </view>

      <view class="rule-card">
        <view class="rule-header">
          <image class="rule-icon-img" src="/images/icon-points-share.svg" mode="aspectFit"></image>
          <text class="rule-title">分享奖励</text>
        </view>
        <view class="rule-content">
          <view class="rule-item"><text class="rule-dot"></text><text class="rule-text">分享小程序给好友可获得 <text class="highlight">{{shareReward}}</text> 积分</text></view>
          <view class="rule-item"><text class="rule-dot"></text><text class="rule-text">每日最多可获得 <text class="highlight">{{shareDailyLimit}}</text> 次分享奖励</text></view>
        </view>
      </view>

      <view class="rule-card vip-card">
        <view class="rule-header">
          <image class="rule-icon-img" src="/images/icon-points-crown.svg" mode="aspectFit"></image>
          <text class="rule-title">会员特权</text>
        </view>
        <view class="rule-content">
          <view class="rule-item"><text class="rule-dot"></text><text class="rule-text">积分兑换会员，畅享专属权益</text></view>
          <view class="rule-item"><text class="rule-dot"></text><text class="rule-text">会员专属下载次数，下载更自由</text></view>
        </view>
        <view class="vip-cta" bindtap="switchTab" data-tab="vip">
          <text>查看会员详情</text>
          <text class="cta-arrow">&#8594;</text>
        </view>
      </view>

      <view class="rule-card warning">
        <view class="rule-header">
          <image class="rule-icon-img" src="/images/icon-points-warning.svg" mode="aspectFit"></image>
          <text class="rule-title">注意事项</text>
        </view>
        <view class="rule-content">
          <view class="rule-item"><text class="rule-dot warning-dot"></text><text class="rule-text">积分仅限本小程序使用，不可转让</text></view>
          <view class="rule-item"><text class="rule-dot warning-dot"></text><text class="rule-text">规则可能会根据运营情况调整</text></view>
        </view>
      </view>
    </view>

    <!-- 会员特权 -->
    <view wx:if="{{activeTab === 'vip'}}" class="vip-section">
      <view class="vip-header">
        <view class="vip-badge">
          <image class="vip-badge-icon-img" src="/images/icon-diamond.svg" mode="aspectFit"></image>
          <text class="vip-badge-text">VIP MEMBERSHIP</text>
        </view>
        <text class="vip-title">积分兑换</text>
        <text class="vip-subtitle">多种兑换选择 · 满足不同需求</text>
      </view>

      <view class="exchange-tabs">
        <view class="exchange-tab {{activeExchangeTab === 'members' ? 'active' : ''}}" bindtap="switchExchangeTab" data-tab="members">会员</view>
      </view>

      <view wx:if="{{activeExchangeTab === 'members'}}" class="member-options">
        <view class="member-option {{memberLevel === 'weekly' ? 'selected' : ''}}" bindtap="exchangeMember" data-level="weekly">
          <view class="option-header">
            <view class="option-badge weekly">周卡</view>
            <view class="option-recommended" wx:if="{{points >= memberPrices.weekly && points < memberPrices.monthly}}">推荐</view>
          </view>
          <view class="option-body">
            <view class="option-price-wrap"><text class="option-price">{{memberPrices.weekly}}</text><text class="option-unit">积分</text></view>
            <view class="option-days">7天</view>
          </view>
          <view class="option-benefits">
            <view class="benefit-item"><text class="benefit-dot"></text><text class="benefit-text">无限下载</text></view>
          </view>
          <view class="option-action">
            <text class="action-btn {{points < memberPrices.weekly ? 'disabled' : ''}}">{{points < memberPrices.weekly ? '积分不足' : '立即兑换'}}</text>
          </view>
        </view>

        <view class="member-option {{memberLevel === 'monthly' ? 'selected' : ''}}" bindtap="exchangeMember" data-level="monthly">
          <view class="option-header">
            <view class="option-badge monthly">月卡</view>
            <view class="option-recommended" wx:if="{{points >= memberPrices.monthly && points < memberPrices.quarterly}}">推荐</view>
          </view>
          <view class="option-body">
            <view class="option-price-wrap"><text class="option-price">{{memberPrices.monthly}}</text><text class="option-unit">积分</text></view>
            <view class="option-days">30天</view>
          </view>
          <view class="option-benefits">
            <view class="benefit-item"><text class="benefit-dot"></text><text class="benefit-text">无限下载</text></view>
          </view>
          <view class="option-action">
            <text class="action-btn {{points < memberPrices.monthly ? 'disabled' : ''}}">{{points < memberPrices.monthly ? '积分不足' : '立即兑换'}}</text>
          </view>
        </view>

        <view class="member-option {{memberLevel === 'quarterly' ? 'selected' : ''}}" bindtap="exchangeMember" data-level="quarterly">
          <view class="option-header">
            <view class="option-badge quarterly">季卡</view>
            <view class="option-recommended" wx:if="{{points >= memberPrices.quarterly && points < memberPrices.yearly}}">性价比高</view>
          </view>
          <view class="option-body">
            <view class="option-price-wrap"><text class="option-price">{{memberPrices.quarterly}}</text><text class="option-unit">积分</text></view>
            <view class="option-days">90天</view>
          </view>
          <view class="option-benefits">
            <view class="benefit-item"><text class="benefit-dot"></text><text class="benefit-text">无限下载</text></view>
            <view class="benefit-item"><text class="benefit-dot"></text><text class="benefit-text">性价比更高</text></view>
          </view>
          <view class="option-action">
            <text class="action-btn {{points < memberPrices.quarterly ? 'disabled' : ''}}">{{points < memberPrices.quarterly ? '积分不足' : '立即兑换'}}</text>
          </view>
        </view>

        <view class="member-option {{memberLevel === 'yearly' ? 'selected' : ''}}" bindtap="exchangeMember" data-level="yearly">
          <view class="option-header">
            <view class="option-badge yearly">年卡</view>
            <view class="option-recommended" wx:if="{{points >= memberPrices.yearly && points < memberPrices.lifetime}}">超值</view>
          </view>
          <view class="option-body">
            <view class="option-price-wrap"><text class="option-price">{{memberPrices.yearly}}</text><text class="option-unit">积分</text></view>
            <view class="option-days">365天</view>
          </view>
          <view class="option-benefits">
            <view class="benefit-item"><text class="benefit-dot"></text><text class="benefit-text">无限下载</text></view>
            <view class="benefit-item"><text class="benefit-dot"></text><text class="benefit-text">超值优惠</text></view>
          </view>
          <view class="option-action">
            <text class="action-btn {{points < memberPrices.yearly ? 'disabled' : ''}}">{{points < memberPrices.yearly ? '积分不足' : '立即兑换'}}</text>
          </view>
        </view>

        <view class="member-option lifetime {{memberLevel === 'lifetime' ? 'selected' : ''}}" bindtap="exchangeMember" data-level="lifetime">
          <view class="lifetime-glow"></view>
          <view class="option-header">
            <view class="option-badge lifetime">终身</view>
            <view class="option-recommended" wx:if="{{points >= memberPrices.lifetime}}">尊享</view>
          </view>
          <view class="option-body">
            <view class="option-price-wrap"><text class="option-price">{{memberPrices.lifetime}}</text><text class="option-unit">积分</text></view>
            <view class="option-days">永久有效</view>
          </view>
          <view class="option-benefits">
            <view class="benefit-item"><text class="benefit-dot lifetime-dot"></text><text class="benefit-text">无限下载</text></view>
            <view class="benefit-item"><text class="benefit-dot lifetime-dot"></text><text class="benefit-text">永久有效</text></view>
            <view class="benefit-item"><text class="benefit-dot lifetime-dot"></text><text class="benefit-text">专属标识</text></view>
          </view>
          <view class="option-action">
            <text class="action-btn lifetime-btn {{points < memberPrices.lifetime ? 'disabled' : ''}}">{{points < memberPrices.lifetime ? '积分不足' : '立即兑换'}}</text>
          </view>
        </view>
      </view>

      <view class="vip-footer">
        <text class="footer-text">积分不足？完成任务赚取更多积分</text>
        <view class="footer-actions">
          <view class="footer-action" bindtap="switchTab" data-tab="rules"><text class="footer-action-text">查看规则</text></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 邀请弹窗 -->
  <view class="modal-mask" wx:if="{{showInviteModal}}" bindtap="closeInviteModal"></view>
  <view class="modal-content invite-modal" wx:if="{{showInviteModal}}">
    <view class="invite-modal-header">
      <view class="invite-modal-icon-wrap">
        <image class="invite-modal-icon-img" src="/images/icon-points-invite.svg" mode="aspectFit"></image>
      </view>
      <view class="invite-modal-title">邀请好友</view>
      <view class="invite-modal-reward">成功邀请1人立得 {{inviteInfo.rewardPoints}} 积分</view>
    </view>
    
    <view class="invite-stats-wrap">
      <view class="invite-stat-item"><text class="invite-stat-num">{{inviteInfo.todayInvites}}</text><text class="invite-stat-label">今日邀请</text></view>
      <view class="invite-stat-divider"></view>
      <view class="invite-stat-item"><text class="invite-stat-num">{{inviteInfo.totalInvites}}</text><text class="invite-stat-label">总邀请</text></view>
      <view class="invite-stat-divider"></view>
      <view class="invite-stat-item"><text class="invite-stat-num">{{inviteInfo.validInvites}}</text><text class="invite-stat-label">成功邀请</text></view>
    </view>

    <view class="invite-rules">
      <view class="invite-rule-title">邀请规则</view>
      <view class="invite-rule-item" wx:for="{{inviteInfo.rules}}" wx:key="index"><text class="invite-rule-dot"></text><text class="invite-rule-text">{{item}}</text></view>
    </view>

    <button class="invite-modal-btn" open-type="share"><text class="invite-btn-text">邀请好友</text></button>
    <view class="modal-close" bindtap="closeInviteModal"><text class="close-icon">&times;</text></view>
  </view>

  <!-- 激励广告加载中 -->
  <view class="ad-loading-mask" wx:if="{{showAdLoading}}" catchtouchmove="noop" catchtap="noop">
    <view class="loading-spinner"></view>
    <text class="ad-loading-text">加载中...</text>
    <text class="ad-loading-sub">正在准备广告，请稍候</text>
    <view class="ad-loading-safearea"></view>
  </view>
</view>
