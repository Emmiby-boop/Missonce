.container {
  min-height: 100vh;
  background: var(--bg-color);
}

.header {
  position: relative;
  padding-top: 0;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 420rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.header-content {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 30rpx 20rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.points-card {
  position: relative;
  margin: 20rpx 30rpx 20rpx;
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  text-align: center;
  box-shadow: 0 8rpx 30rpx var(--shadow-color);
}

.points-label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.points-value {
  font-size: 72rpx;
  font-weight: bold;
  color: #667eea;
  line-height: 1.2;
}

.points-total {
  font-size: 24rpx;
  color: #bbb;
  margin-top: 8rpx;
}

.member-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 30rpx 20rpx;
  background: linear-gradient(135deg, #ffd700 0%, #ff9500 100%);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
}

.member-banner.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.member-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.member-icon {
  font-size: 44rpx;
}

.member-text-wrap {
  display: flex;
  flex-direction: column;
}

.member-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.member-banner.active .member-text {
  color: #fff;
}

.member-subtext {
  font-size: 22rpx;
  color: rgba(0,0,0,0.6);
  margin-top: 4rpx;
}

.member-banner.active .member-subtext {
  color: rgba(255,255,255,0.8);
}

.member-arrow-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.member-arrow {
  font-size: 24rpx;
  font-weight: 500;
  color: #333;
}

.member-banner.active .member-arrow {
  color: #fff;
}

.arrow-icon {
  font-size: 28rpx;
  color: #333;
}

.member-banner.active .arrow-icon {
  color: #fff;
}

.member-status {
  display: flex;
  align-items: center;
}

.status-badge {
  background: rgba(255,255,255,0.25);
  color: #fff;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.content {
  padding: 0 0 40rpx;
}

.action-section {
  padding: 0 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 20rpx;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.action-item {
  background: var(--card-bg);
  border-radius: 20rpx;
  padding: 30rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  transition: all 0.3s;
}

.action-item:active {
  transform: scale(0.98);
  opacity: 0.8;
}

.action-item.disabled {
  opacity: 0.6;
  pointer-events: none;
}

.action-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-icon-wrap.checkin {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.action-icon-wrap.video {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.action-icon-wrap.share {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
}

.action-icon-wrap.invite {
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
}

.action-icon {
  font-size: 36rpx;
}

.action-content {
  flex: 1;
}

.action-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 6rpx;
}

.action-reward {
  font-size: 24rpx;
  color: #667eea;
  font-weight: 600;
}

.tabs {
  display: flex;
  background: var(--card-bg);
  margin: 30rpx 30rpx 0;
  border-radius: 16rpx;
  padding: 8rpx;
  gap: 8rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: var(--text-sub);
  border-radius: 12rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background: #667eea;
  color: #fff;
  font-weight: 600;
}

.records-section, .rules-section, .vip-section {
  padding: 30rpx;
}

.loading-container, .empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--border-color);
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-top: 20rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-sub);
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: var(--text-sub);
}

.records-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.record-item {
  background: var(--card-bg);
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.record-icon {
  font-size: 40rpx;
}

.record-info {
  flex: 1;
}

.record-desc {
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 500;
}

.record-time {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
}

.record-checkin {
  font-size: 22rpx;
  color: #667eea;
  margin-top: 4rpx;
}

.record-amount {
  font-size: 32rpx;
  font-weight: bold;
}

.record-amount.positive {
  color: #43e97b;
}

.record-amount.negative {
  color: #f5576c;
}

.load-more, .no-more {
  text-align: center;
  padding: 30rpx 0;
  font-size: 26rpx;
  color: var(--text-sub);
}

.rules-section {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.rule-card {
  background: var(--card-bg);
  border-radius: 20rpx;
  padding: 28rpx;
}

.rule-card.vip-card {
  border: 2rpx solid #667eea;
}

.rule-card.warning {
  border: 2rpx solid #ff9500;
}

.rule-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.rule-icon {
  font-size: 36rpx;
}

.rule-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-main);
}

.rule-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.rule-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.rule-dot {
  width: 12rpx;
  height: 12rpx;
  background: #667eea;
  border-radius: 50%;
  margin-top: 10rpx;
  flex-shrink: 0;
}

.rule-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.6;
}

.rule-card.warning .rule-dot {
  background: #ff9500;
}

.highlight {
  color: #667eea;
  font-weight: 600;
}

.vip-cta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--border-color);
}

.vip-cta text:first-child {
  font-size: 26rpx;
  color: #667eea;
  font-weight: 500;
}

.cta-arrow {
  font-size: 28rpx;
  color: #667eea;
}

.vip-section {
  padding-top: 20rpx;
}

.vip-header {
  text-align: center;
  margin-bottom: 30rpx;
}

.vip-badge {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(102, 126, 234, 0.1);
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  margin-bottom: 16rpx;
}

.vip-badge-icon {
  font-size: 28rpx;
}

.vip-badge-text {
  font-size: 22rpx;
  color: #667eea;
  font-weight: 500;
}

.vip-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 8rpx;
}

.vip-subtitle {
  font-size: 26rpx;
  color: var(--text-sub);
}

.exchange-tabs {
  display: flex;
  background: var(--card-bg);
  border-radius: 16rpx;
  padding: 8rpx;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.exchange-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: var(--text-sub);
  border-radius: 12rpx;
  transition: all 0.3s;
}

.exchange-tab.active {
  background: #667eea;
  color: #fff;
  font-weight: 600;
}

.member-options {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.member-option {
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 28rpx;
  position: relative;
  overflow: hidden;
  transition: all 0.3s;
}

.member-option.selected {
  border: 3rpx solid #667eea;
}

.member-option.lifetime {
  background: linear-gradient(135deg, #ffd700 0%, #ff9500 100%);
}

.member-option.lifetime.selected {
  border: 3rpx solid #ff9500;
}

.lifetime-glow {
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255,255,255,0.3) 0%, transparent 70%);
  animation: glow 3s ease-in-out infinite;
  pointer-events: none;
}

@keyframes glow {
  0%, 100% { opacity: 0.5; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1.2); }
}

.option-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.option-badge {
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 600;
}

/* 广告加载动画 */
.ad-loading-mask {
  position: fixed;
  inset: 0;
  z-index: 2000;
  background: rgba(0,0,0,0.45);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.ad-loading-text {
  margin-top: 18rpx;
  color: #fff;
  font-size: 28rpx;
}
.ad-loading-sub {
  margin-top: 8rpx;
  color: rgba(255,255,255,0.8);
  font-size: 22rpx;
}
.ad-loading-safearea {
  position: absolute;
  inset: 0;
}

.option-badge.weekly {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.option-badge.monthly {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  color: #fff;
}

.option-badge.quarterly {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  color: #fff;
}

.option-badge.yearly {
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
  color: #fff;
}

.option-badge.lifetime {
  background: linear-gradient(135deg, #ffd700 0%, #ff9500 100%);
  color: #fff;
}

.option-recommended {
  background: #ffd700;
  color: #333;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.option-body {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.option-price-wrap {
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
}

.option-price {
  font-size: 56rpx;
  font-weight: bold;
  color: #667eea;
}

.member-option.lifetime .option-price {
  color: #fff;
}

.option-unit {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-bottom: 6rpx;
}

.member-option.lifetime .option-unit {
  color: rgba(255,255,255,0.8);
}

.option-days {
  font-size: 26rpx;
  color: var(--text-sub);
}

.member-option.lifetime .option-days {
  color: rgba(255,255,255,0.8);
}

.option-benefits {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.benefit-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.benefit-icon {
  font-size: 28rpx;
  color: #43e97b;
}

.member-option.lifetime .benefit-icon {
  color: #fff;
}

.benefit-text {
  font-size: 26rpx;
  color: var(--text-sub);
}

.member-option.lifetime .benefit-text {
  color: rgba(255,255,255,0.9);
}

.option-action {
  margin-top: 20rpx;
}

.action-btn {
  display: block;
  width: 100%;
  text-align: center;
  padding: 24rpx 0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 50rpx;
  transition: all 0.3s;
}

.action-btn.disabled {
  background: #ddd;
  color: #999;
  pointer-events: none;
}

.member-option.lifetime .action-btn {
  background: rgba(255,255,255,0.3);
}

.member-option.lifetime .action-btn.disabled {
  background: rgba(0,0,0,0.1);
}

.download-options, .adfree-options {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.download-option, .adfree-option {
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 28rpx;
  transition: all 0.3s;
}

.download-option-header, .adfree-option-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.download-option-name, .adfree-option-name {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-main);
}

.download-option-bonus, .adfree-option-bonus {
  background: #ff9500;
  color: #fff;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.download-option-body, .adfree-option-body {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.download-option-price-wrap, .adfree-option-price-wrap {
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
}

.download-option-price, .adfree-option-price {
  font-size: 56rpx;
  font-weight: bold;
  color: #667eea;
}

.download-option-unit, .adfree-option-unit {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-bottom: 6rpx;
}

.download-option-action, .adfree-option-action {
  margin-top: 20rpx;
}

.adfree-option-benefits {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.vip-footer {
  text-align: center;
  margin-top: 40rpx;
}

.footer-text {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-bottom: 20rpx;
}

.footer-actions {
  display: flex;
  justify-content: center;
  gap: 20rpx;
}

.footer-action {
  padding: 16rpx 40rpx;
  border: 2rpx solid #667eea;
  border-radius: 50rpx;
}

.footer-action-text {
  font-size: 26rpx;
  color: #667eea;
  font-weight: 500;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.6);
  z-index: 1000;
}

.modal-content {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  width: 560rpx;
  z-index: 1001;
  text-align: center;
}

.modal-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
}

.modal-icon {
  font-size: 50rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 16rpx;
}

.modal-desc {
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.modal-desc.bonus {
  color: #ff9500;
  font-weight: 500;
}

.modal-highlight {
  color: #667eea;
  font-weight: bold;
}

.modal-btn {
  display: block;
  width: 100%;
  text-align: center;
  padding: 24rpx 0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 50rpx;
  margin-top: 30rpx;
  border: none;
}

.modal-tip {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 20rpx;
}

.modal-close {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-icon {
  font-size: 40rpx;
  color: var(--text-sub);
}

.invite-modal {
  width: 620rpx;
  padding: 40rpx;
}

.invite-modal-header {
  text-align: center;
  margin-bottom: 30rpx;
}

.invite-modal-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20rpx;
}

.invite-modal-icon {
  font-size: 50rpx;
}

.invite-modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 12rpx;
}

.invite-modal-reward {
  font-size: 28rpx;
  color: #667eea;
  font-weight: 600;
}

.invite-stats-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-color);
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  margin-bottom: 30rpx;
}

.invite-stat-item {
  flex: 1;
  text-align: center;
}

.invite-stat-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #667eea;
  margin-bottom: 8rpx;
}

.invite-stat-label {
  font-size: 24rpx;
  color: var(--text-sub);
}

.invite-stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: var(--border-color);
}

.invite-rules {
  background: var(--bg-color);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 30rpx;
}

.invite-rule-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 16rpx;
}

.invite-rule-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.invite-rule-item:last-child {
  margin-bottom: 0;
}

.invite-rule-dot {
  width: 12rpx;
  height: 12rpx;
  background: #667eea;
  border-radius: 50%;
  margin-top: 10rpx;
  flex-shrink: 0;
}

.invite-rule-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-sub);
  line-height: 1.6;
}

.invite-modal-btn {
  display: block;
  width: 100%;
  text-align: center;
  padding: 24rpx 0;
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 50rpx;
  border: none;
}

/* 深色模式适配 */
@media (prefers-color-scheme: dark) {
  .points-card {
    box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.3);
  }

  .action-btn.disabled {
    background: #374151;
    color: #6b7280;
  }

  .vip-badge {
    background: rgba(102, 126, 234, 0.2);
  }

  .vip-badge-text {
