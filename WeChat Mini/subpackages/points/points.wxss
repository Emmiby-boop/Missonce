.container {
  min-height: 100vh;
  background: #f5f7fa;
}

.header {
  position: relative;
  padding-top: 0;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 400rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.header-content {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 30rpx 20rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.points-card {
  position: relative;
  margin: 20rpx 30rpx 30rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  text-align: center;
  box-shadow: 0 8rpx 30rpx rgba(102, 126, 234, 0.15);
}

.points-label {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.points-value {
  font-size: 80rpx;
  font-weight: bold;
  color: #667eea;
  line-height: 1.2;
}

.points-total {
  font-size: 24rpx;
  color: #bbb;
  margin-top: 10rpx;
}

.content {
  padding: 0 30rpx 30rpx;
}

.tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-weight: bold;
}

.loading-container,
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text,
.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-top: 20rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.records-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.record-item:last-child {
  border-bottom: none;
}

.record-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.record-info {
  flex: 1;
  min-width: 0;
}

.record-desc {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.record-time {
  font-size: 24rpx;
  color: #999;
}

.record-checkin {
  font-size: 22rpx;
  color: #667eea;
  margin-top: 6rpx;
}

.record-amount {
  font-size: 36rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.record-amount.positive {
  color: #52c41a;
}

.record-amount.negative {
  color: #ff4d4f;
}

.load-more,
.no-more {
  text-align: center;
  padding: 30rpx;
  font-size: 26rpx;
  color: #999;
}

.rules-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.rule-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.rule-card.warning {
  background: #fff7e6;
  border: 2rpx solid #ffd591;
}

.rule-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.rule-card.warning .rule-title {
  color: #fa8c16;
}

.rule-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.rule-item {
  display: flex;
  align-items: flex-start;
}

.rule-dot {
  width: 12rpx;
  height: 12rpx;
  background: #667eea;
  border-radius: 50%;
  margin-top: 10rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.rule-card.warning .rule-dot {
  background: #fa8c16;
}

.rule-text {
  flex: 1;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}
