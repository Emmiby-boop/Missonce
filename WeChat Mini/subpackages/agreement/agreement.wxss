/* ============================================================
   会员服务协议 · 独立整页
   配色全部走 app.wxss 的 CSS 变量，暗色自动跟随
   ============================================================ */

page {
  background: var(--bg-color);
}

/* ============================================================
   整页骨架：flex column，导航栏固定占位 + 正文独立滚动
   —— 这是「文字不被导航栏压住」的结构保证
   ============================================================ */
.ag-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-color);
}

/* ---------- 导航栏 ---------- */
.nav {
  flex-shrink: 0;                /* 关键：不参与压缩，导航栏永远完整 */
  background: var(--card-bg);
  box-shadow: 0 1rpx 0 rgba(7, 193, 96, 0.10);
  position: relative;
  z-index: 10;
}

.nav-inner {
  display: flex;
  align-items: center;
  position: relative;
  padding: 0 8px;
}

.nav-back {
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
}

.nav-back-hover {
  background: rgba(7, 193, 96, 0.10);
}

.nav-back-img {
  width: 22px;
  height: 22px;
}

.nav-title {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 17px;
  font-weight: 600;
  color: var(--text-main);
  white-space: nowrap;
}

/* 阅读进度条 */
.nav-progress {
  height: 2px;
  background: rgba(7, 193, 96, 0.10);
  overflow: hidden;
}

.nav-progress-bar {
  height: 100%;
  background: var(--primary-color);
  transition: width 0.12s linear;
}

/* ---------- 正文滚动区 ---------- */
.ag-scroll {
  flex: 1;
  min-height: 0;                 /* 关键：允许收缩，否则撑破整页 */
  width: 100%;
}

.ag-doc {
  /* 防左右溢出：左右留安全边距 + 长串英文/数字强制换行 */
  padding: 28rpx 32rpx 0;
  box-sizing: border-box;
  width: 100%;
  max-width: 750rpx;
  margin: 0 auto;
}

/* ---------- 文档头 ---------- */
.ag-doc-head {
  padding-bottom: 24rpx;
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.ag-doc-badge {
  display: inline-block;
  padding: 5rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(7, 193, 96, 0.10);
  margin-bottom: 14rpx;
}

.ag-doc-badge-t {
  font-size: 20rpx;
  color: var(--primary-color);
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

.ag-doc-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.35;
  word-break: break-word;
}

.ag-meta-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;               /* 小屏换行不溢出 */
  margin-top: 12rpx;
}

.ag-meta-t {
  font-size: 22rpx;
  color: var(--text-sub);
}

.ag-meta-dot {
  font-size: 22rpx;
  color: var(--text-sub);
  margin: 0 8rpx;
}

.ag-meta-eff {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-sub);
}

/* ---------- 引言块 ---------- */
.ag-lede {
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(7, 193, 96, 0.05);
  border-left: 4rpx solid var(--primary-color);
  margin-bottom: 32rpx;
}

.ag-lede-t {
  display: block;
  font-size: 25rpx;
  color: var(--text-main);
  line-height: 1.75;
  word-break: break-word;
  overflow-wrap: break-word;     /* 根治长串不换行导致的横向溢出 */
}

.ag-lede-t + .ag-lede-t {
  margin-top: 10rpx;
}

/* ---------- 章节 ---------- */
.ag-sec {
  margin-bottom: 36rpx;
}

.ag-sec-head {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.ag-sec-bar {
  width: 6rpx;
  height: 28rpx;
  border-radius: 3rpx;
  background: var(--primary-color);
  flex-shrink: 0;
  margin-top: 6rpx;
  margin-right: 12rpx;
}

.ag-sec-t {
  flex: 1;
  min-width: 0;
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text-main);
  line-height: 1.45;
  word-break: break-word;
}

/* ---------- 条款条目 ---------- */
.ag-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 14rpx;
}

.ag-item-no {
  flex-shrink: 0;
  min-width: 60rpx;              /* 给编号留固定位，文字不会顶上来 */
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary-color);
  line-height: 1.8;
  letter-spacing: 0.2rpx;
}

.ag-item-t {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--text-main);
  line-height: 1.8;
  /* 三个一起上，防止任何长串把布局撑破 */
  word-break: break-word;
  overflow-wrap: break-word;
  white-space: normal;
}

.ag-tail {
  height: 24rpx;
}

/* ---------- 底部同意条 ---------- */
.ag-bar {
  flex-shrink: 0;
  padding: 16rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--card-bg);
  box-shadow: 0 -1rpx 0 rgba(0, 0, 0, 0.04);
}

.ag-btn {
  display: block;
  width: 100%;
  border-radius: 999rpx;
  background: var(--primary-color);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 2.6;
  border: none;
}

.ag-btn::after {
  border: none;
}

.ag-btn-hover {
  opacity: 0.88;
}

.ag-bar-tip {
  display: block;
  margin-top: 10rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--text-sub);
  line-height: 1.4;
}