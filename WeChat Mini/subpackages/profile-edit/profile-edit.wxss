/* 页面容器 */
.container {
  min-height: 100vh;
  background-color: #F7F8FA;
  position: relative;
  overflow: hidden;
}

/* 顶部背景装饰 - 增加层次感 */
.bg-decoration {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 400rpx;
  background: linear-gradient(180deg, #E8F3FF 0%, #F7F8FA 100%);
  z-index: 0;
}

.content-wrapper {
  position: relative;
  z-index: 1;
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 头像区域 */
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.avatar-wrapper {
  position: relative;
  width: 140rpx !important;
  height: 140rpx !important;
  padding: 0 !important;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.08);
  border: 6rpx solid #fff;
  display: block;
  overflow: hidden;
  box-sizing: border-box;
  margin: 0 !important;
  transition: transform 0.2s ease;
  min-width: 0 !important;
  min-height: 0 !important;
}

.avatar-wrapper:active {
  transform: scale(0.96);
}

.avatar-wrapper::after {
  border: none;
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 0;
  background-color: #f0f2f5;
  object-fit: cover;
}

.edit-badge {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  background: #333;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* CSS绘制简单相机图标 */
.camera-shape {
  width: 22rpx;
  height: 16rpx;
  background: #fff;
  border-radius: 2rpx;
  position: relative;
}
.camera-shape::before {
  content: '';
  position: absolute;
  top: -3rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 8rpx;
  height: 3rpx;
  background: #fff;
  border-radius: 2rpx 2rpx 0 0;
}
.camera-lens {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  border: 2rpx solid #333;
  box-sizing: border-box;
}

.avatar-tip {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #8590A6;
  font-weight: 500;
}

/* 表单卡片 */
.form-card {
  width: 100%;
  background: #fff;
  border-radius: 32rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.03);
  margin-bottom: 60rpx;
}

.input-group {
  display: flex;
  flex-direction: column;
}

.label {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 600;
  margin-bottom: 20rpx;
  margin-left: 8rpx;
}

.nickname-input {
  height: 96rpx;
  background: #F5F7FA;
  border-radius: 24rpx;
  padding: 0 32rpx;
  font-size: 32rpx;
  color: #1A1A1A;
  font-weight: 500;
  transition: all 0.3s;
}

.nickname-input:focus {
  background: #fff;
  box-shadow: 0 0 0 2rpx #07c160;
}

.placeholder {
  color: #C0C4CC;
  font-weight: 400;
}

/* 操作区域 */
.action-section {
  width: 100%;
  padding: 0 20rpx;
}

.save-btn {
  background: #07c160;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  padding: 28rpx 0;
  border-radius: 32rpx;
  box-shadow: 0 16rpx 32rpx rgba(0, 0, 0, 0.15);
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.save-btn-hover {
  transform: scale(0.98);
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.1);
  opacity: 0.9;
}

.save-btn::after {
  border: none;
}

/* 深色模式适配 */
@media (prefers-color-scheme: dark) {
  .container {
    background-color: #111827;
  }

  .bg-decoration {
    background: linear-gradient(180deg, #1f2937 0%, #111827 100%);
  }

  .avatar-wrapper {
    background: #1f2937;
    border-color: #1f2937;
    box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.3);
  }

  .avatar {
    background-color: #374151;
  }

  .edit-badge {
    background: #4b5563;
    border-color: #1f2937;
  }

  .form-card {
    background: #1f2937;
    box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.2);
  }

  .label {
    color: #f3f4f6;
  }

  .nickname-input {
    background: #374151;
    color: #f3f4f6;
  }

  .nickname-input:focus {
    background: #1f2937;
  }

  .placeholder {
    color: #6b7280;
  }
}
