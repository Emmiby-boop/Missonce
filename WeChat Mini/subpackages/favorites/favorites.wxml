<view class="container">
  <!-- 顶部操作栏 -->
  <view class="header-bar" wx:if="{{favorites.length > 0}}">
    <view class="header-title">我的收藏 ({{favorites.length}})</view>
    <view class="clear-btn" bindtap="onClearAll">
      <text class="clear-icon">🗑️</text>
      <text class="clear-text">清空</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{favorites.length === 0}}">
    <text class="empty-icon">🤍</text>
    <text class="empty-text">还没有收藏哦</text>
    <text class="empty-tip">去首页看看喜欢的图片吧</text>
  </view>

  <!-- 收藏列表 -->
  <view class="favorites-grid" wx:else>
    <view class="favorite-item" wx:for="{{favorites}}" wx:key="url" bindtap="onFavoriteTap" data-url="{{item.url}}">
      <image class="favorite-image {{item.type === 'avatar' ? 'circular' : ''}}" src="{{item.url}}" mode="aspectFill" lazy-load></image>
      <view class="favorite-delete" catchtap="onDeleteFavorite" data-url="{{item.url}}" data-index="{{index}}">
        <text class="delete-icon">×</text>
      </view>
      <view class="favorite-type">{{item.type === 'avatar' ? '头像' : '壁纸'}}</view>
    </view>
  </view>
</view>
