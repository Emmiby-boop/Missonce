/* ========================================
   历史记录 — 与热门页统一风格
   ======================================== */

.page {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 120rpx;
}

/* 顶部统计 */
.stats-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 16rpx;
}

.stats-left {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.stats-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.stats-count {
  font-size: 24rpx;
  color: #9ca3af;
}

.stats-clear {
  padding: 10rpx 24rpx;
  background: rgba(239, 68, 68, 0.08);
  border-radius: 9999rpx;
  font-size: 24rpx;
  color: #ef4444;
  font-weight: 500;
}

.stats-clear:active {
  background: rgba(239, 68, 68, 0.15);
}

.stats-actions{display:flex;gap:12rpx}

/* 编辑模式 */
.card-check{margin-right:16rpx;display:flex;align-items:center}
.check-box{width:48rpx;height:48rpx;border-radius:50%;border:3rpx solid #d1d5db;display:flex;align-items:center;justify-content:center;font-size:28rpx;color:#fff;transition:all 0.2s}
.check-box.checked{background:#07c160;border-color:#07c160}
.edit-bar{position:fixed;bottom:0;left:0;right:0;height:100rpx;padding:0 32rpx;background:#fff;border-top:1rpx solid #f0f0f0;display:flex;align-items:center;justify-content:space-between;z-index:100;padding-bottom:env(safe-area-inset-bottom)}
.edit-count{font-size:28rpx;color:#666}
.edit-delete-btn{padding:12rpx 32rpx;background:#ef4444;color:#fff;border-radius:8rpx;font-size:28rpx;font-weight:600}
.edit-delete-btn:active{opacity:0.8}

/* 搜索栏 */
.search-wrap {
  display: flex;
  align-items: center;
  margin: 0 32rpx 24rpx;
  background: #fff;
  border-radius: 9999rpx;
  padding: 0 24rpx;
  height: 72rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.search-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
  color: #1a1a2e;
}

.search-clear {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e5e7eb;
  border-radius: 50%;
  font-size: 22rpx;
  color: #6b7280;
}

/* 日期分区 */
.date-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 32rpx 12rpx;
}

.date-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #07c160;
}

.date-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #374151;
}

.date-count {
  font-size: 22rpx;
  color: #9ca3af;
  margin-left: auto;
}

/* 卡片列表 */
.card-list {
  padding: 0 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 历史卡片 */
.history-card {
  display: flex;
  gap: 20rpx;
  padding: 16rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
  transition: all 0.2s;
}

.history-card:active {
  transform: scale(0.98);
}

/* 缩略图 */
.card-thumb {
  position: relative;
  width: 180rpx;
  height: 130rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  overflow: hidden;
  background: #e5e7eb;
}

.card-thumb-img {
  width: 100%;
  height: 100%;
}

.card-thumb-play {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.play-tri {
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 10rpx 0 10rpx 18rpx;
  border-color: transparent transparent transparent rgba(255,255,255,0.9);
  margin-left: 3rpx;
}

/* 平台角标 */
.card-platform {
  position: absolute;
  bottom: 8rpx;
  left: 8rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  color: #fff;
  font-weight: 600;
}

/* 信息区 */
.card-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 4rpx 0;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.card-time {
  font-size: 22rpx;
  color: #9ca3af;
}

.card-dot {
  font-size: 22rpx;
  color: #d1d5db;
}

.card-size {
  font-size: 22rpx;
  color: #9ca3af;
}

.card-action {
  align-self: flex-start;
  padding: 8rpx 24rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 9999rpx;
  font-size: 24rpx;
  color: #6b7280;
  font-weight: 500;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
  gap: 16rpx;
}

.empty-icon-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.empty-icon {
  width: 80rpx;
  height: 80rpx;
  opacity: 0.5;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.empty-desc {
  font-size: 26rpx;
  color: #9ca3af;
}

/* 底部 */
.list-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 40rpx 0;
}

.footer-line {
  width: 60rpx;
  height: 2rpx;
  background: #e5e7eb;
}

.footer-text {
  font-size: 22rpx;
  color: #9ca3af;
}
