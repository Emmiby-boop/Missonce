/* ========================================
   最新素材 — 与历史页统一风格
   ======================================== */

.page {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 120rpx;
}

/* 顶部统计 */
.stats-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 16rpx;
}

.stats-left {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.stats-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.stats-count {
  font-size: 24rpx;
  color: #9ca3af;
}

.stats-refresh {
  padding: 10rpx 24rpx;
  background: rgba(7, 193, 96, 0.08);
  border-radius: 9999rpx;
  font-size: 24rpx;
  color: #07c160;
  font-weight: 500;
}

.stats-refresh:active {
  background: rgba(7, 193, 96, 0.15);
}

/* 搜索栏 */
.search-wrap {
  display: flex;
  align-items: center;
  margin: 0 32rpx 24rpx;
  background: #fff;
  border-radius: 9999rpx;
  padding: 0 24rpx;
  height: 72rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.search-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
  color: #1a1a2e;
}

.search-clear {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e5e7eb;
  border-radius: 50%;
  font-size: 22rpx;
  color: #6b7280;
}

/* Tab 栏 */
.tab-bar {
  display: flex;
  gap: 0;
  margin: 0 32rpx 24rpx;
  background: rgba(255,255,255,0.6);
  border-radius: 16rpx;
  padding: 6rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  font-weight: 500;
  color: #6b7280;
  border-radius: 12rpx;
  transition: all 0.2s;
}

.tab-item.active {
  background: #07c160;
  color: #fff;
  font-weight: 600;
  box-shadow: 0 2rpx 12rpx rgba(7, 193, 96, 0.3);
}

/* 卡片列表 */
.card-list {
  padding: 0 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 历史卡片 — 与历史页完全一致 */
.history-card {
  display: flex;
  gap: 20rpx;
  padding: 16rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
  transition: all 0.2s;
}

.history-card:active {
  transform: scale(0.98);
}

/* 缩略图 */
.card-thumb {
  position: relative;
  width: 180rpx;
  height: 130rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  overflow: hidden;
  background: #e5e7eb;
}

.card-thumb-img {
  width: 100%;
  height: 100%;
}

.card-thumb-play {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.play-tri {
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 10rpx 0 10rpx 18rpx;
  border-color: transparent transparent transparent rgba(255,255,255,0.9);
  margin-left: 3rpx;
}

/* 平台角标 */
.card-platform {
  position: absolute;
  bottom: 8rpx;
  left: 8rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  color: #fff;
  font-weight: 600;
}

/* NEW 标签 */
.card-new-tag {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  padding: 4rpx 12rpx;
  background: #ef4444;
  border-radius: 8rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #fff;
}

/* 信息区 */
.card-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 4rpx 0;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-author {
  font-size: 22rpx;
  color: #6b7280;
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.card-time {
  font-size: 22rpx;
  color: #9ca3af;
}

.card-action {
  align-self: flex-start;
  padding: 8rpx 24rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 9999rpx;
  font-size: 24rpx;
  color: #6b7280;
  font-weight: 500;
}

.card-action:active {
  background: #f3f4f6;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
  gap: 16rpx;
}

.empty-icon-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.empty-icon-inner {
  width: 72rpx;
  height: 80rpx;
  border: 6rpx solid #07c160;
  border-radius: 12rpx;
  position: relative;
  background: rgba(7, 193, 96, 0.06);
}

.empty-icon-inner::before {
  content: '';
  position: absolute;
  top: 14rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 32rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #07c160;
  opacity: 0.4;
}

.empty-icon-inner::after {
  content: '';
  position: absolute;
  top: 26rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 20rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #07c160;
  opacity: 0.25;
}

.empty-icon-corner {
  position: absolute;
  top: 44rpx;
  right: 44rpx;
  width: 20rpx;
  height: 20rpx;
  border: 4rpx solid #fff;
  border-radius: 6rpx;
  background: #66bb6a;
  transform: rotate(15deg);
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.empty-desc {
  font-size: 26rpx;
  color: #9ca3af;
}

/* 底部 */
.list-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 40rpx 0;
}

.footer-line {
  width: 60rpx;
  height: 2rpx;
  background: #e5e7eb;
}

.footer-text {
  font-size: 22rpx;
  color: #9ca3af;
}

/* 骨架屏 */
.skeleton-card {
  padding: 16rpx;
  background: #fff;
  border-radius: 20rpx;
}

.skeleton-thumb {
  width: 180rpx;
  height: 130rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

.skeleton-line {
  height: 28rpx;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  margin-top: 16rpx;
}

.w80 { width: 80%; }
.w50 { width: 50%; }

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
