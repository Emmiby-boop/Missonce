<!--
  首页 — 小辣椒去水印精灵
  Velocity Flux 设计系统
-->
<view class="page">
  <!-- 滚动公告 -->
  <view class="notice-bar" wx:if="{{noticeText}}" bindtap="onNoticeTap">
    <view class="notice-scroll">
      <text class="notice-text">📢 {{noticeText}}</text>
    </view>
  </view>

  <!-- 主内容 -->
  <view class="main-content">
    <!-- 输入区域 -->
    <view class="input-section">
      <view class="input-card">
        <!-- 输入提示 -->
        <view class="input-hint">
          <view class="hint-dot"></view>
          <text class="hint-text">粘贴视频链接，一键去水印</text>
          <view class="hint-dot"></view>
        </view>

        <!-- 输入框容器 -->
        <view class="url-input-wrapper">
          <textarea
            class="url-input"
            value="{{inputValue}}"
            placeholder="请粘贴视频分享链接..."
            placeholder-style="color:#c2c6d8;font-size:28rpx;"
            bindinput="onInput"
            maxlength="-1"
          />
        </view>

        <!-- 按钮行：粘贴 + 解析 -->
        <view class="btn-row">
          <view class="paste-btn" wx:if="{{!inputValue}}" bindtap="onPasteAction">
            <image class="paste-icon" src="/images/icon-clipboard.png" mode="aspectFit" />
            <text>粘贴链接</text>
          </view>
          <view class="paste-btn clear-btn" wx:else bindtap="onClearInput">
            <image class="paste-icon" src="/images/icon-close.png" mode="aspectFit" />
            <text>清空</text>
          </view>
          <button
            class="parse-btn {{isLoading ? 'loading' : ''}}"
            bindtap="onSubmit"
            disabled="{{isLoading}}"
            loading="{{isLoading}}"
          >
            <text class="parse-btn-text">{{isLoading ? (parseStepText || '解析中...') : '开始解析'}}</text>
          </button>
        </view>
      </view>
    </view>

    <!-- 支持平台 -->
    <view class="platform-section">
      <view class="section-header">
        <text class="section-title">支持平台</text>
        <text class="section-badge">已支持 50+ 平台</text>
      </view>
      <view class="platform-grid">
        <view
          class="platform-item"
          wx:for="{{platforms}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="onPlatformTap"
        >
          <view class="platform-icon-box" style="background: {{item.bg}};">
            <image wx:if="{{item.icon}}" class="platform-icon" src="{{item.icon}}" mode="aspectFit" />
            <text wx:else class="platform-icon-text">···</text>
          </view>
          <text class="platform-name">{{item.name}}</text>
        </view>
      </view>
    </view>

    <!-- 使用说明入口 -->
    <view class="guide-entry" bindtap="onShowGuide">
      <view class="guide-left">
        <image class="guide-icon" src="/images/question-icon.png" mode="aspectFit" />
        <text class="guide-text">使用说明</text>
      </view>
      <image class="guide-arrow" src="/images/icon-arrow.png" mode="aspectFit" />
    </view>

    <!-- 底部提示 -->
    <view class="footer-note">
      <text>仅供个人学习使用 · 版权归原作者所有</text>
    </view>
  </view>
</view>

<!-- 使用说明弹窗 -->
<view class="modal-overlay {{showGuide ? 'show' : ''}}" bindtap="onHideGuide">
  <view class="modal-card" catchtap="noop">
    <view class="modal-header">
      <text class="modal-title">使用说明</text>
      <view class="modal-close" bindtap="onHideGuide">
        <image src="/images/icon-close.png" mode="aspectFit" />
      </view>
    </view>
    <view class="modal-body">
      <view class="guide-step">
        <view class="step-num">1</view>
        <view class="step-content">
          <text class="step-title">复制视频链接</text>
          <text class="step-desc">打开短视频平台，点击分享按钮，选择「复制链接」。</text>
        </view>
      </view>
      <view class="guide-step">
        <view class="step-num">2</view>
        <view class="step-content">
          <text class="step-title">粘贴并解析</text>
          <text class="step-desc">回到本页面，点击「一键粘贴」后点击「开始解析」按钮。</text>
        </view>
      </view>
      <view class="guide-step">
        <view class="step-num">3</view>
        <view class="step-content">
          <text class="step-title">下载保存</text>
          <text class="step-desc">解析完成后，选择清晰度并点击「下载到相册」。</text>
        </view>
      </view>
    </view>
    <view class="modal-footer">
      <button class="modal-confirm" bindtap="onHideGuide">我知道了</button>
    </view>
  </view>
</view>
