/* ========================================
   首页 — 极速去水印
   Velocity Flux 设计系统
   ======================================== */

.page {
  min-height: 100vh;
  background: var(--surface);
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 主内容 */
.main-content {
  padding: var(--spacing-lg) var(--margin-main);
  display: flex;
  flex-direction: column;
  gap: var(--spacing-lg);
}

/* 输入区域 */
.input-section {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 输入卡片 */
.input-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx 28rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(194, 198, 216, 0.2);
  overflow: hidden;
}

/* 输入提示 */
.input-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-bottom: 12px;
}

.hint-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #07c160;
}

.hint-text {
  font-size: 13px;
  color: #9ca3af;
  font-weight: 500;
}

/* 输入框容器 */
.url-input-wrapper {
  width: 100%;
  height: 200rpx;
  background: #f5f6f9;
  border: 2rpx solid #e8ebf0;
  border-radius: 18rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

/* 输入框 */
.url-input {
  flex: 1;
  min-height: 80rpx;
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.6;
  width: 100%;
  height: 100%;
  padding: 16rpx;
  box-sizing: border-box;
}

/* 按钮行：粘贴 + 解析 */
.btn-row {
  display: flex;
  gap: 16rpx;
}

.paste-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  flex: 1;
  min-height: var(--touch-min);
  padding: 0 24rpx;
  background: rgba(7, 193, 96, 0.08);
  border: 1rpx solid rgba(7, 193, 96, 0.2);
  border-radius: var(--radius-xl);
  font-size: 26rpx;
  font-weight: 600;
  color: #07c160;
  box-sizing: border-box;
}

.paste-btn:active {
  background: rgba(7, 193, 96, 0.15);
}

.paste-icon {
  width: 28rpx;
  height: 28rpx;
}

/* 解析按钮 */
.parse-btn {
  flex: 2;
  min-height: var(--touch-min);
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #07c160 0%, #06ad58 100%);
  color: #ffffff;
  border-radius: var(--radius-xl);
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(7, 193, 96, 0.30);
  transition: all 0.15s;
}

.parse-btn:active {
  transform: scale(0.98);
}

.parse-btn.loading {
  opacity: 0.7;
}

.parse-btn[disabled] {
  opacity: 0.5;
  cursor: not-allowed;
}

.parse-btn-text {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

/* 支持平台 */
.platform-section {
  background: var(--surface-container-lowest);
  border-radius: var(--radius-xl);
  padding: var(--spacing-md);
  border: 1rpx solid var(--outline-variant);
  box-shadow: var(--shadow-sm);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-md);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--on-surface);
}

.section-badge {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.platform-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-md) 0;
}

.platform-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 0;
  transition: opacity 0.2s;
}

.platform-item:active {
  opacity: 0.7;
}

.platform-icon-box {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.platform-icon {
  width: 48rpx;
  height: 48rpx;
}

.platform-icon-text {
  font-size: 32rpx;
  color: var(--text-secondary);
  font-weight: 600;
}

.platform-name {
  font-size: 22rpx;
  color: var(--on-surface-variant);
  font-weight: 500;
}

/* 使用说明入口 */
.guide-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--surface-container-lowest);
  border-radius: var(--radius-xl);
  padding: var(--spacing-md);
  border: 1rpx solid var(--outline-variant);
  box-shadow: var(--shadow-sm);
}

.guide-entry:active {
  background: var(--surface-container-low);
}

.guide-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.guide-icon {
  width: 36rpx;
  height: 36rpx;
}

.guide-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--on-surface);
}

.guide-arrow {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.4;
}

/* 底部提示 */
.footer-note {
  text-align: center;
  padding: var(--spacing-md) 0;
  font-size: 22rpx;
  color: var(--text-muted);
}

/* ========================================
   使用说明弹窗
   ======================================== */

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx var(--margin-main);
  opacity: 0;
  pointer-events: none;
}

.modal-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

.modal-card {
  width: 100%;
  max-width: 600rpx;
  background: var(--surface-container-lowest);
  border-radius: var(--radius-2xl);
  overflow: hidden;
  box-shadow: var(--shadow-lg);
  transform: scale(0.95);
  transition: transform 0.25s;
}

.modal-overlay.show .modal-card {
  transform: scale(1);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-md);
  border-bottom: 1rpx solid rgba(194, 198, 216, 0.3);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--on-surface);
}

.modal-close {
  width: var(--touch-min);
  height: var(--touch-min);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
}

.modal-close:active {
  background: var(--surface-container);
}

.modal-close image {
  width: 32rpx;
  height: 32rpx;
}

.modal-body {
  padding: var(--spacing-md);
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.guide-step {
  display: flex;
  gap: var(--spacing-md);
  padding: var(--spacing-md);
  background: var(--surface-container-low);
  border-radius: var(--radius-xl);
  border: 1rpx solid rgba(194, 198, 216, 0.2);
}

.step-num {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(7, 193, 96, 0.1);
  color: #07c160;
  border-radius: var(--radius-full);
  font-size: 24rpx;
  font-weight: 700;
}

.step-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.step-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--on-surface);
}

.step-desc {
  font-size: 24rpx;
  color: var(--on-surface-variant);
  line-height: 1.5;
}

.modal-footer {
  padding: 0 var(--spacing-md) var(--spacing-md);
}

.modal-confirm {
  width: 100%;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #07c160;
  color: #ffffff;
  border-radius: var(--radius-xl);
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.modal-confirm:active {
  opacity: 0.85;
}

/* 滚动公告 */
.notice-bar{width:100%;height:72rpx;background:linear-gradient(135deg,#fff8e1,#fff3cd);display:flex;align-items:center;overflow:hidden;border-bottom:1rpx solid #f0e6c0}
.notice-scroll{white-space:nowrap;animation:noticeScroll 18s linear infinite}
.notice-text{font-size:26rpx;color:#8b6914;padding:0 48rpx}
@keyframes noticeScroll{0%{transform:translateX(100vw)}100%{transform:translateX(-100%)}}
