.page{position:fixed;top:0;left:0;right:0;bottom:0;background:#000;z-index:999}
.player-swiper{width:100%;height:100%}
.player-slide{width:100%;height:100%;position:relative}
.player{width:100%;height:100%}
.player-cover{position:absolute;top:0;left:0;width:100%;height:100%;z-index:1;transition:opacity 0.3s}
.swiper-img{width:100%;height:100%}

/* 暂停遮罩 - 抖音风格 */
.pause-overlay{position:absolute;top:0;left:0;right:0;bottom:0;display:flex;align-items:center;justify-content:center}
.pause-circle{width:120rpx;height:120rpx;border-radius:50%;background:rgba(0,0,0,0.5);display:flex;align-items:center;justify-content:center}
.pause-triangle{width:0;height:0;border-style:solid;border-width:20rpx 0 20rpx 36rpx;border-color:transparent transparent transparent #fff;margin-left:8rpx}

/* 圆点 */
.dot-indicator{position:fixed;bottom:100rpx;left:0;right:0;display:flex;justify-content:center;gap:12rpx;z-index:200}
.dot{width:12rpx;height:12rpx;border-radius:50%;background:rgba(255,255,255,0.3)}
.dot.active{width:28rpx;border-radius:6rpx;background:#fff}

/* 右侧面板 */
.right-panel{position:fixed;right:20rpx;bottom:160rpx;z-index:100;display:flex;flex-direction:column;align-items:center;gap:32rpx}
.avatar-wrap{position:relative;width:96rpx;height:96rpx;margin-bottom:16rpx}
.avatar-img{width:96rpx;height:96rpx;border-radius:50%;border:4rpx solid #fff}
.follow-plus{position:absolute;bottom:-8rpx;left:50%;transform:translateX(-50%);width:40rpx;height:40rpx;border-radius:50%;background:#FF2C55;color:#fff;font-size:28rpx;font-weight:bold;display:flex;align-items:center;justify-content:center}
.act-btn{display:flex;flex-direction:column;align-items:center;gap:8rpx;padding:16rpx 20rpx;border-radius:16rpx;background:rgba(0,0,0,0.25);backdrop-filter:blur(10rpx);min-width:100rpx}
.act-btn:active{opacity:0.7;transform:scale(0.95)}
.act-icon-img{width:56rpx;height:56rpx}
.act-label{font-size:22rpx;color:#fff;font-weight:500;text-shadow:0 1rpx 4rpx rgba(0,0,0,0.4)}
.act-btn-inner{padding:0;margin:0;border:none;background:none;line-height:1;display:flex;flex-direction:column;align-items:center;gap:8rpx}
.act-btn-inner::after{border:none}

/* 音乐碟片 */
.music-disc{margin-top:16rpx}
.disc-outer{width:88rpx;height:88rpx;border-radius:50%;overflow:hidden;border:4rpx solid rgba(255,255,255,0.3);animation:discSpin 4s linear infinite}
.disc-img{width:100%;height:100%;border-radius:50%}
@keyframes discSpin{from{transform:rotate(0)}to{transform:rotate(360deg)}}

/* 平台标签 */
.author-row{display:flex;align-items:center;gap:12rpx}
.author-avatar{width:48rpx;height:48rpx;border-radius:50%}
.author-avatar--default{display:flex;align-items:center;justify-content:center;font-size:24rpx;font-weight:700;color:#fff}
.platform-tag{display:inline-flex;align-items:center;padding:4rpx 12rpx;background:rgba(255,255,255,0.15);border-radius:6rpx}
.platform-tag-text{font-size:20rpx;color:#fff;font-weight:500;text-shadow:0 1rpx 2rpx rgba(0,0,0,0.3)}

/* 底部 */
.bottom-panel{position:fixed;bottom:0;left:0;right:180rpx;z-index:100;padding:0 32rpx 32rpx;padding-bottom:calc(32rpx + env(safe-area-inset-bottom))}
.author-name{font-size:32rpx;font-weight:600;color:#fff;text-shadow:0 1rpx 4rpx rgba(0,0,0,0.3)}
.title-area{margin-top:10rpx}
.title-text{font-size:30rpx;color:#fff;opacity:0.9;line-height:1.5;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;text-shadow:0 1rpx 4rpx rgba(0,0,0,0.3)}

/* 空状态 */
.empty-page{display:flex;align-items:center;justify-content:center}
.empty-state{text-align:center}
.empty-icon{width:120rpx;height:120rpx;margin-bottom:24rpx;opacity:0.4}
.empty-title{font-size:32rpx;color:rgba(255,255,255,0.4)}
