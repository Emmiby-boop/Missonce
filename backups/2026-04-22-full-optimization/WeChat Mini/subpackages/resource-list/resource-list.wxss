page {
  background: #f7f8fa;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background: #07c160;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.12);
}

.nav-bar {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.nav-title {
  color: #fff;
  font-size: 32rpx;
  font-weight: 400;
  max-width: 60%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-back {
  width: 80rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.nav-placeholder {
  width: 80rpx;
  height: 100%;
}

.back-icon {
  width: 38rpx;
  height: 38rpx;
}

.nav-holder {
  width: 100%;
}

.container {
  padding: 0;
  padding-bottom: 40rpx;
  min-height: 100vh;
}

.native-video-mid-ad,
.native-video-bottom-ad {
  padding: 12rpx 24rpx;
}

.native-top-ad {
  position: sticky;
  z-index: 98;
  background: #fff;
  border-bottom: 1rpx solid #f1f1f1;
  padding: 8rpx 0;
}

.native-top-ad ad-custom {
  display: block;
  width: 100%;
}

.waterfall-container {
  padding: 24rpx;
}

/* 标签滚动栏 */
.category-scroll {
  background: #fff;
  padding: 16rpx 0;
  box-shadow: 0 8rpx 26rpx rgba(16, 42, 66, 0.08);
  position: sticky;
  z-index: 10;
  white-space: nowrap;
}

.category-list {
  display: flex;
  padding: 0 24rpx;
}

.category-item {
  flex-shrink: 0;
  padding: 12rpx 32rpx;
  margin-right: 20rpx;
  background: #f1f5f9;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: #64748b;
  transition: all 0.2s ease;
}

.category-item.active {
  background: #07c160;
  color: #fff;
  box-shadow: 0 4rpx 14rpx rgba(7, 193, 96, 0.28);
  font-weight: 500;
}

/* 排序栏 */
.sort-bar {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 40rpx;
  background: transparent;
}

.sort-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  background: #fff;
  border-radius: 12rpx;
  margin: 0 15rpx;
  font-size: 28rpx;
  color: #64748b;
  box-shadow: 0 4rpx 12rpx rgba(16, 42, 66, 0.04);
  transition: all 0.2s;
}

.sort-item.active {
  background: #07c160;
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(7, 193, 96, 0.25);
}

.chip-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

/* 列表样式 - 3列瀑布流 */
.resource-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx;
  justify-content: space-between;
}

.resource-item {
  width: 31%; /* 3列布局 */
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  position: relative;
}

/* 头像：1:1 正方形 */
.avatar-item {
  aspect-ratio: 1;
}

/* 壁纸：9:16 竖屏 */
.wallpaper-item {
  aspect-ratio: 9/16;
}

.resource-image {
  width: 100%;
  height: 100%;
}

/* 类型标签 */
.type-tag {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  padding: 4rpx 12rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 20rpx;
  border-radius: 4rpx;
  z-index: 1;
}

.image {
  width: 100%;
  height: 100%;
  display: block;
}

/* 状态 */
.loading, .no-more, .empty {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 28rpx;
}

/* 深色模式适配 */
@media (prefers-color-scheme: dark) {
  page {
    background: #111827;
  }

  .category-scroll {
    background: #1f2937;
    box-shadow: 0 8rpx 26rpx rgba(0, 0, 0, 0.3);
  }

  .category-item {
    background: #374151;
    color: #9ca3af;
  }

  .category-item.active {
    background: #07c160;
    color: #ffffff;
  }

  .resource-item {
    background: #1f2937;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  }

  .type-tag {
    background: rgba(0, 0, 0, 0.8);
  }

  .loading, .no-more, .empty {
    color: #6b7280;
  }
}

.empty-title {
  display: block;
  margin-top: 20rpx;
}

/* 骨架屏样式 */
.skeleton-container {
  padding: 24rpx;
}

.skeleton-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.skeleton-item {
  width: 31%;
  margin-bottom: 24rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.skeleton-image {
  width: 100%;
  aspect-ratio: 9/16;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s infinite;
  border-radius: 12rpx;
}

@keyframes skeleton-loading {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}

/* 深色模式骨架屏 */
@media (prefers-color-scheme: dark) {
  .skeleton-image {
    background: linear-gradient(90deg, #374151 25%, #4b5563 50%, #374151 75%);
    background-size: 200% 100%;
  }
}
