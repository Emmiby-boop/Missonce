page {
  background: #f7f8fa;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background: #07c160;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.12);
}

.nav-bar {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.nav-title {
  color: #fff;
  font-size: 32rpx;
  font-weight: 400;
}

.nav-back {
  width: 80rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.nav-placeholder {
  width: 80rpx;
  height: 100%;
}

.back-icon {
  width: 38rpx;
  height: 38rpx;
}

.nav-holder {
  width: 100%;
}

.container {
  padding: 0;
}

.category-scroll {
  background: #fff;
  padding: 24rpx 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  position: sticky;
  top: 0;
  z-index: 10;
}

.category-list {
  display: flex;
  padding: 0 24rpx;
}

.category-item {
  flex-shrink: 0;
  padding: 12rpx 32rpx;
  margin-right: 20rpx;
  background: #f1f5f9;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: #64748b;
  transition: all 0.2s ease;
}

.category-item.active {
  background: #07c160;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
  font-weight: 500;
}

/* 壁纸网格 - 瀑布流或简单网格 */
.wallpaper-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx;
  justify-content: space-between;
}

.wallpaper-item {
  width: 47%; /* 2列布局 */
  height: 580rpx;
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.wallpaper-image {
  width: 100%;
  height: 100%;
}

.loading, .no-more, .empty {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 24rpx;
}

.empty-title {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
}