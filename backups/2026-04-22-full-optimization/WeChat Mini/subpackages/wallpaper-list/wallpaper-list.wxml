<view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-bar">
    <view class="nav-back" bindtap="navigateBack">
      <image class="back-icon" src="/images/preview-back.svg" mode="aspectFit" />
    </view>
    <text class="nav-title">壁纸精选</text>
    <view class="nav-placeholder"></view>
  </view>
</view>
<view class="nav-holder" style="height: {{statusBarHeight + navBarHeight - 1}}px;"></view>

<view class="container">
  <ad-unit kind="interstitial" page-path="/subpackages/wallpaper-list/wallpaper-list"></ad-unit>
  <!-- 顶部悬浮广告 -->
  <ad-unit position="top" custom-class="native-top-ad" page-path="/subpackages/wallpaper-list/wallpaper-list" threshold="200" ext-style="top: {{statusBarHeight + navBarHeight - 1}}px;"></ad-unit>
  
  <!-- 标签导航 -->
  <scroll-view class="category-scroll" scroll-x enable-flex style="top: {{statusBarHeight + navBarHeight - 1}}px">
    <view class="category-list">
      <view class="category-item {{currentTag === item.id ? 'active' : ''}}" 
            wx:for="{{tagList}}" 
            wx:key="id" 
            data-tag="{{item.id}}" 
            bindtap="onTagChange">
        {{item.name}}
      </view>
    </view>
  </scroll-view>

  <!-- 壁纸列表 -->
  <view class="wallpaper-grid">
    <view class="wallpaper-item" wx:for="{{wallpapers}}" wx:key="id" 
          bindtap="previewImage" 
          data-url="{{item.url}}" 
          data-original-url="{{item.originalUrl}}" 
          data-raw-url="{{item.rawUrl}}" 
          data-raw-original-url="{{item.rawOriginalUrl}}"
          data-categories="{{item.categories}}" 
          data-tags="{{item.tags}}">
      <image class="wallpaper-image" src="{{item.url}}" mode="aspectFill" lazy-load></image>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
  <view class="no-more" wx:if="{{!hasMore && wallpapers.length > 0}}">
    <text>没有更多了</text>
  </view>
  <view class="empty" wx:if="{{!loading && wallpapers.length === 0}}">
    <text class="empty-title">暂无数据</text>
  </view>
</view>