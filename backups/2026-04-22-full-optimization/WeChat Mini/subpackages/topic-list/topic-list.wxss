.container {
  min-height: 100vh;
  background: var(--bg-color);
  padding: 20rpx;
  box-sizing: border-box;
}

.topic-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.topic-item {
  width: 100%;
  border-radius: 20rpx;
  overflow: hidden;
  background: var(--card-bg);
  box-shadow: 0 8rpx 24rpx var(--shadow-color);
  transform: translateZ(0); /* Fix for iOS overflow hidden bug */
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
  position: relative;
  z-index: 1;
}

.topic-item:active {
  opacity: 0.9;
  transform: scale(0.98);
  transition: all 0.2s ease;
}

.topic-cover-box {
  position: relative;
  width: 100%;
  height: 360rpx;
}

.topic-cover {
  width: 100%;
  height: 100%;
}

.topic-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(to bottom, rgba(0,0,0,0) 0%, rgba(0,0,0,0.1) 60%, rgba(0,0,0,0.7) 100%);
}

.topic-info {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 30rpx;
  box-sizing: border-box;
  color: #fff;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.topic-title {
  font-size: 36rpx;
  font-weight: bold;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.3);
}

.topic-desc {
  font-size: 26rpx;
  opacity: 0.9;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-shadow: 0 1rpx 2rpx rgba(0,0,0,0.3);
}

.topic-meta {
  margin-top: 8rpx;
}

.topic-tag {
  display: inline-block;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10px);
  padding: 4rpx 16rpx;
  border-radius: 100rpx;
  font-size: 22rpx;
}

/* Skeleton Screen Styles */
.skeleton-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 20rpx;
}

.skeleton-item {
  width: 100%;
  height: 360rpx;
  background: var(--bg-color);
  border-radius: 20rpx;
  position: relative;
  overflow: hidden;
}

.shimmer::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(to right, transparent 0%, rgba(255,255,255,0.4) 50%, transparent 100%);
  animation: shimmer 1.5s infinite;
}

@keyframes shimmer {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

.loading-more {
  text-align: center;
  padding: 20rpx;
  color: var(--text-sub);
  font-size: 24rpx;
}

.no-more {
  text-align: center;
  padding: 20rpx;
  color: var(--text-sub);
  font-size: 24rpx;
}

/* 深色模式适配 */
@media (prefers-color-scheme: dark) {
  .topic-tag {
    background: rgba(0, 0, 0, 0.4);
  }

  .skeleton-item {
    background: rgba(255, 255, 255, 0.05);
  }
}

