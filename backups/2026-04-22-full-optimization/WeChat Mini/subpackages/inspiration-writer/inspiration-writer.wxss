page {
  background: var(--bg-color);
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  z-index: 1000;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 44px;
  padding: 0 16px;
}

.nav-back {
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 24px;
  height: 24px;
  filter: brightness(0) invert(1);
}

.nav-title {
  font-size: 17px;
  font-weight: 600;
  color: #fff;
}

.nav-placeholder {
  width: 44px;
}

.nav-holder {
  width: 100%;
}

.container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 顶部原生广告样式 - 紧贴导航栏，无广告时不占空间 */
.native-top-ad {
  position: relative;
  z-index: 100;
  background: var(--bg-color);
  padding: 0;
  margin: 0;
  line-height: 0;
}

/* ========== 顶部标题卡片 ========== */
.header {
  padding: 16rpx 16rpx 20rpx;
}

.header-card {
  position: relative;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  min-height: 120rpx;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.28);
  overflow: hidden;
}

/* 装饰背景圆 */
.header-bg-deco {
  position: absolute;
  top: -40rpx;
  right: -20rpx;
  width: 140rpx;
  height: 140rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 50%;
}

/* 主内容区 */
.header-main {
  position: relative;
  display: flex;
  align-items: center;
}

/* 左侧图标 */
.header-icon {
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

/* 分隔线 */
.header-divider {
  width: 1rpx;
  height: 72rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.4) 50%, rgba(255, 255, 255, 0) 100%);
  margin: 0 20rpx;
  flex-shrink: 0;
}

/* 右侧信息 */
.header-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.info-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 1rpx;
}

.info-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
}

.search-section {
  padding: 24rpx 32rpx;
  background: var(--card-bg);
}

.search-wrapper {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--bg-color);
  border-radius: 999rpx;
  padding: 8rpx 8rpx 8rpx 24rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 64rpx;
}

.search-btn {
  background: #07c160;
  color: #fff;
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.native-video-bottom-ad {
  padding: 20rpx 24rpx;
}

.category-scroll {
  background: var(--card-bg);
  padding: 16rpx 0;
  white-space: nowrap;
}

.category-list {
  display: flex;
  padding: 0 24rpx;
  gap: 16rpx;
}

.category-item {
  flex-shrink: 0;
  padding: 16rpx 32rpx;
  background: var(--bg-color);
  border-radius: 999rpx;
  font-size: 28rpx;
  color: var(--text-sub);
  transition: all 0.2s;
}

.category-item.active {
  background: #07c160;
  color: #fff;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--border-color);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-spinner.small {
  width: 40rpx;
  height: 40rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: var(--text-sub);
}

.quotes-list {
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.quote-card {
  background: var(--card-bg);
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 12rpx var(--shadow-color);
  transition: all 0.2s;
}

.quote-card:active {
  transform: scale(0.98);
}

.quote-content {
  font-size: 32rpx;
  line-height: 1.8;
  color: var(--text-main);
  margin-bottom: 24rpx;
}

.quote-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--border-color);
}

.quote-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.quote-tag {
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  border-radius: 999px;
  background: #07c160;
  color: #fff;
}

.quote-tag-secondary {
  background: var(--bg-color);
  color: var(--text-sub);
}

.copy-hint {
  font-size: 24rpx;
  color: #07c160;
  font-weight: 500;
}

.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-sub);
}

.load-more {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
}

.no-more {
  text-align: center;
  padding: 40rpx 0;
  font-size: 28rpx;
  color: var(--text-sub);
}

/* ========== 深色模式覆盖 ========== */
/* 渐变背景和 rgba 装饰无法用 CSS 变量覆盖，需单独处理 */
@media (prefers-color-scheme: dark) {
  .custom-nav {
    background: linear-gradient(135deg, #065f46 0%, #047857 100%);
  }

  .header-card {
    background: linear-gradient(135deg, #312e81 0%, #4c1d95 100%);
    box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.4);
  }

  .header-bg-deco {
    background: rgba(255, 255, 255, 0.06);
  }

  .header-icon {
    background: rgba(255, 255, 255, 0.1);
  }

  .header-divider {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.2) 50%, rgba(255, 255, 255, 0) 100%);
  }

  .quote-card {
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  }

  .quote-tag-secondary {
    background: rgba(255, 255, 255, 0.08);
  }

  .quote-tag {
    background: rgba(16, 185, 129, 0.8);
  }

  .category-item.active {
    background: #10b981;
  }

  .copy-hint {
    color: #10b981;
  }
}
