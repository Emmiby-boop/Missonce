.container {
  padding: 24rpx;
  background: transparent;
  min-height: 100vh;
  padding-bottom: 160rpx;
}

.search-header {
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.search-input-container {
  margin-right: 0;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1f2a44;
}

.clear-icon {
  font-size: 44rpx;
  color: #9aa7b2;
  margin-left: 10rpx;
  line-height: 1;
}


.search-type {
  display: flex;
  margin-bottom: 30rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.type-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 30rpx;
  margin: 0 10rpx;
  background: #f5f5f5;
}

.type-item.active {
  background: #07c160;
  color: #fff;
}


.search-result {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  min-height: 80vh;
  padding-bottom: 40rpx;
}

.result-header {
  margin-bottom: 20rpx;
}

.result-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2a44;
}


.result-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.result-item {
  width: 32%;
  margin-bottom: 20rpx;
  background: #f9f9f9;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
}

.result-image {
  width: 100%;
  height: 150rpx;
  display: block;
}

.result-item.avatar .result-image {
  height: 220rpx;
}

.result-tag {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  border-radius: 15rpx;
  color: #fff;
}

.result-tag.wallpaper {
  background: rgba(7, 193, 96, 0.8);
}


.result-tag.avatar {
  background: rgba(255, 150, 50, 0.8);
}

.native-video-bottom-ad {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 98;
  background: #fff;
  padding: 12rpx 16rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
} 


.no-result {
  text-align: center;
  padding: 100rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.no-result-icon {
  width: 84rpx;
  height: 84rpx;
  opacity: 0.55;
  display: block;
  margin: 0 auto 22rpx;
}


.no-result-text {
  font-size: 32rpx;
  color: #666;
  display: block;
  margin-bottom: 20rpx;
}

.no-result-tip {
  font-size: 26rpx;
  color: #999;
  display: block;
}

/* 筛选器样式 */
.search-filters {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.filter-section {
  margin-bottom: 24rpx;
}

.filter-section:last-child {
  margin-bottom: 0;
}

.filter-header {
  margin-bottom: 16rpx;
}

.filter-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #334155;
}

.filter-scroll {
  white-space: nowrap;
  width: 100%;
}

.color-filters {
  padding: 4rpx 0;
}

.color-item {
  display: inline-flex;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 1px solid rgba(0, 0, 0, 0.05);
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.color-item.active {
  transform: scale(1.1);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.color-check {
  color: #fff;
  font-size: 24rpx;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
}

.filter-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.filter-tag {
  padding: 10rpx 24rpx;
  background: #f1f5f9;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #64748b;
  transition: all 0.2s;
}

.filter-tag.active {
  background: #07c160;
  color: #fff;
}

/* 搜索历史 */
.search-history,
.hot-search {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.history-header,
.hot-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

/* Dark Mode Support */
  @media (prefers-color-scheme: dark) {
    page {
      background: #111827;
    }

    .search-filters,
    .search-history,
    .hot-search,
    .search-type,
    .search-result,
    .no-result {
      background: #1f2937;
      box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
    }

    .filter-title,
    .history-title,
    .hot-title,
    .result-title,
    .no-result-text,
    .search-input {
      color: #f3f4f6;
    }

    .filter-tag,
    .history-tag,
    .hot-tag,
    .type-item,
    .result-item {
      background: #374151;
      color: #9ca3af;
    }

    .filter-tag.active,
    .type-item.active {
      background: #065f46;
      color: #fff;
    }

    .history-clear-icon {
      opacity: 0.6;
      filter: invert(1);
    }

    .no-result-tip,
    .clear-history,
    .loading-state,
    .no-more-state {
      color: #6b7280;
    }
  }

.history-title,
.hot-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.clear-history {
  font-size: 24rpx;
  color: #999;
}

.history-tags,
.hot-tags {
  display: flex;
  flex-wrap: wrap;
}

.history-tag,
.hot-tag {
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

/* Loading & No More States */
.loading-state,
.no-more-state {
  width: 100%;
  padding: 30rpx 0;
  display: flex;
  justify-content: center;
  align-items: center;
  color: #999;
  font-size: 26rpx;
}

.loading-spinner {
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #07c160;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-right: 15rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
