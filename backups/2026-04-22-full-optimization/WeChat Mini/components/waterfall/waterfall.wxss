.waterfall-container {
  display: flex;
  justify-content: space-between;
  padding: 0 24rpx;
  gap: 24rpx;
}

.waterfall-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.waterfall-item {
  background: #f8fafc;
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
  transition: transform 0.2s ease;
}

/* 头像：1:1 正方形 */
.avatar-item {
  aspect-ratio: 1;
}

/* 壁纸：9:16 竖屏 */
.wallpaper-item {
  aspect-ratio: 9/16;
}

.waterfall-item:active {
  transform: scale(0.98);
}

.waterfall-image {
  width: 100%;
  height: 100%;
  display: block;
  background: #f1f5f9;
}

/* 类型标签 */
.type-tag {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  padding: 4rpx 12rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 20rpx;
  border-radius: 4rpx;
  z-index: 1;
}

/* Dark Mode Support */
@media (prefers-color-scheme: dark) {
  .waterfall-item {
    background: #1f2937;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  }

  .waterfall-image {
    background: #374151;
  }
}
