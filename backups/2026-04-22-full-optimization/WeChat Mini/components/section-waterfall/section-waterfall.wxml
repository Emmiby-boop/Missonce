<view class="section-waterfall" wx:if="{{visible}}">
  <view class="section-header" wx:if="{{title}}">
    <text class="section-title">{{title}}</text>
    <text class="section-more" wx:if="{{showMore && moreUrl}}" bindtap="onMoreTap">
      查看更多 <text class="arrow-right">→</text>
    </text>
  </view>
  
  <view class="waterfall-container" wx:if="{{columns && columns.length > 0}}">
    <view class="waterfall-column" wx:for="{{columns}}" wx:key="index" wx:for-item="col">
      <view 
        class="waterfall-item {{type === 'avatar' ? 'avatar-item' : 'wallpaper-item'}}" 
        wx:for="{{col}}" 
        wx:key="id" 
        wx:for-item="item" 
        bindtap="onItemTap" 
        data-column="{{index}}" 
        data-index="{{index2}}"
        wx:for-index="index2"
      >
        <image 
          class="waterfall-image" 
          src="{{item.url || item.cover}}" 
          mode="widthFix" 
          lazy-load
        ></image>
        <text class="waterfall-title" wx:if="{{item.title}}">{{item.title}}</text>
      </view>
    </view>
  </view>
  
  <view class="empty-state" wx:else>
    <text class="empty-text">暂无内容</text>
  </view>
</view>