.ad-anchor {
  height: 10rpx;
  width: 100%;
  position: relative;
  visibility: hidden;
}
.top-ad-container {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 999;
  background: var(--card-bg, #fff);
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
  opacity: 0;
  transform: translateY(-20rpx);
  transition: opacity 0.3s ease-in-out, transform 0.3s ease-in-out;
  border-bottom: 1rpx solid var(--border-color, #eee);
  width: 100%;
  max-width: 100%;
  pointer-events: none;
  height: 0;
  overflow: hidden;
}

.ad-custom-wrap {
  display: block;
  width: 100%;
  max-height: 120rpx;
  height: 120rpx;
}

.top-ad-container.show {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
  height: auto;
  overflow: visible;
}
.rewarded-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  background-color: #07c160;
  color: #fff;
  font-size: 30rpx;
  text-align: center;
}
.rv-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}
.rv-box {
  width: 220rpx;
  height: 220rpx;
  border-radius: 24rpx;
  background: rgba(255,255,255,0.92);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.rv-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 8rpx solid #e5e5e5;
  border-top-color: #07c160;
  border-radius: 50%;
  animation: rvspin 1s linear infinite;
  margin-bottom: 20rpx;
}
.rv-text {
  color: #333;
  font-size: 26rpx;
}
@keyframes rvspin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 深色模式 */
@media (prefers-color-scheme: dark) {
  .top-ad-container {
    background: var(--card-bg, #1f2937);
    border-bottom-color: var(--border-color, #374151);
  }

  .rewarded-btn {
    background-color: var(--primary-color, #10b981);
  }

  .rv-spinner {
    border-color: #374151;
    border-top-color: var(--primary-color, #10b981);
  }
}
