<view class="login-wrapper">
  <view class="login-card">
    <view class="logo">
      <button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image src="{{avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"></image>
      </button>
    </view>
    
    <view class="title">完善资料</view>
    
    <view class="nickname-wrapper">
      <input class="nickname-input" type="nickname" placeholder="请输入昵称" value="{{nickName}}" bindinput="onNicknameInput" />
    </view>
    
    <button class="login-button" bindtap="handleLogin" hover-class="login-button-hover" disabled="{{isLoading}}">
      <view class="button-content">
        <text>{{isLoading ? '登录中...' : '确认登录'}}</text>
      </view>
    </button>
    
    <view class="error" wx:if="{{error}}">
      <text>{{error}}</text>
    </view>
  </view>
</view>
