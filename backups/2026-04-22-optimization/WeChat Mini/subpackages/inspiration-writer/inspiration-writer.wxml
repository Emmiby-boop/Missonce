<view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-bar">
    <view class="nav-back" bindtap="navigateBack">
      <image class="back-icon" src="/images/preview-back.svg" mode="aspectFit" />
    </view>
    <text class="nav-title">灵感文案</text>
    <view class="nav-placeholder"></view>
  </view>
</view>
<view class="nav-holder" style="height: {{statusBarHeight + navBarHeight}}px;"></view>

<!-- 顶部悬浮广告 - 放在 container 外面，确保固定在顶部 -->
<ad-unit position="top" custom-class="native-top-ad" page-path="/subpackages/inspiration-writer/inspiration-writer" threshold="200" ext-style="top: {{statusBarHeight + navBarHeight}}px;"></ad-unit>

<view class="container">
  <ad-unit kind="interstitial" page-path="/subpackages/inspiration-writer/inspiration-writer"></ad-unit>
  <!-- 顶部标题卡片 -->
  <view class="header">
    <view class="header-card">
      <!-- 装饰背景 -->
      <view class="header-bg-deco"></view>

      <!-- 主内容区 -->
      <view class="header-main">
        <!-- 左侧图标 -->
        <view class="header-icon">✨</view>

        <!-- 分隔线 -->
        <view class="header-divider"></view>

        <!-- 右侧内容 -->
        <view class="header-info">
          <text class="info-title">灵感文案</text>
          <text class="info-desc">精选文案库 · 一键复制</text>
        </view>
      </view>
    </view>
  </view>

  <view class="search-section">
    <view class="search-wrapper">
      <input 
        class="search-input"
        placeholder="搜索文案..."
        value="{{keyword}}"
        bindinput="onSearchInput"
        confirm-type="search"
        bindconfirm="onSearch"
      />
      <view class="search-btn" bindtap="onSearch">
        <text>搜索</text>
      </view>
    </view>
  </view>

  <scroll-view class="category-scroll" scroll-x enable-flex>
    <view class="category-list">
      <view 
        wx:for="{{categories}}" 
        wx:key="id"
        class="category-item {{currentCategory === item.id ? 'active' : ''}}"
        bindtap="onCategoryTap"
        data-category="{{item.id}}"
      >
        {{item.name}}
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{loading && quotes.length === 0}}" class="loading-container">
    <view class="loading-spinner"></view>
    <view class="loading-text">加载中...</view>
  </view>


  <view wx:if="{{quotes.length > 0}}" class="quotes-list">
    <view 
      wx:for="{{quotes}}" 
      wx:key="_id"
      class="quote-card"
      bindtap="onQuoteTap"
      data-quote="{{item}}"
    >
      <view class="quote-content">{{item.content}}</view>
      <view class="quote-footer">
        <view class="quote-tags">
          <view wx:if="{{item.category}}" class="quote-tag">{{item.category}}</view>
          <view wx:for="{{item.tags}}" wx:key="*this" class="quote-tag quote-tag-secondary">
            {{item}}
          </view>
        </view>
        <view class="copy-hint">点击复制</view>
      </view>
    </view>
  </view>

  <view wx:if="{{!loading && quotes.length === 0}}" class="empty-container">
    <view class="empty-icon">📝</view>
    <view class="empty-text">暂无文案</view>
  </view>

  <view wx:if="{{loading && quotes.length > 0}}" class="load-more">
    <view class="loading-spinner small"></view>
    <view class="loading-text">加载更多...</view>
  </view>

  <view wx:if="{{!hasMore && quotes.length > 0}}" class="no-more">
    没有更多了
  </view>
</view>
