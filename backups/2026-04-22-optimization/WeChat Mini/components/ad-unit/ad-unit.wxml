<view wx:if="{{((kind === 'native' && adUnitId) || (kind === 'rewarded' && showButton) || (kind === 'rewarded' && isLoading))}}" class="{{customClass}}" style="{{extStyle}}">
  <view wx:if="{{kind === 'native'}}">
    <!-- 非顶部广告 -->
    <view wx:if="{{showAd && adUnitId && position !== 'top'}}">
      <view wx:if="{{adLoaded}}" class="ad-content">
        <ad-custom unit-id="{{adUnitId}}" ad-intervals="{{adIntervals}}" bindload="onAdLoad" binderror="onAdError"></ad-custom>
      </view>
      <view wx:else class="ad-loading" style="display: none;">
        <ad-custom unit-id="{{adUnitId}}" ad-intervals="{{adIntervals}}" bindload="onAdLoad" binderror="onAdError"></ad-custom>
      </view>
    </view>
    <view class="ad-anchor" id="ad-anchor"></view>
  </view>
  <!-- 顶部悬浮广告容器 -->
  <view wx:if="{{position === 'top' && adUnitId}}" class="top-ad-container {{showAd && adLoaded ? 'show' : ''}}" style="top: {{statusBarHeight + navBarHeight}}px;">
    <view wx:if="{{adLoaded}}" class="ad-custom-wrap">
      <ad-custom unit-id="{{adUnitId}}" ad-intervals="{{adIntervals}}" bindload="onAdLoad" binderror="onAdError"></ad-custom>
    </view>
    <view wx:else class="ad-loading" style="display: none;">
      <ad-custom unit-id="{{adUnitId}}" ad-intervals="{{adIntervals}}" bindload="onAdLoad" binderror="onAdError"></ad-custom>
    </view>
  </view>
  <view wx:elif="{{kind === 'rewarded'}}">
    <button wx:if="{{showButton}}" class="rewarded-btn" bindtap="onRewardTap" loading="{{isLoading}}" disabled="{{isLoading}}">
      {{buttonText}}
    </button>
    <view wx:if="{{isLoading}}" class="rv-mask">
      <view class="rv-box">
        <view class="rv-spinner"></view>
        <text class="rv-text">广告加载中…</text>
      </view>
    </view>
  </view>
  <view wx:elif="{{kind === 'interstitial'}}"></view>
</view>
